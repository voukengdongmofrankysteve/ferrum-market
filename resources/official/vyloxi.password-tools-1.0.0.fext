{"format":1,"manifest":{"name":"password-tools","publisher":"vyloxi","version":"1.0.0","displayName":"Password Tools","description":"Generate strong passwords and passphrases with the secure random generator, and judge how strong a password is.","engines":{"ferrum":"^0.1.0"},"categories":["Tools"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","main":"extension.js","activationEvents":["onCommand:passwordTools.insert","onCommand:passwordTools.insertMany","onCommand:passwordTools.passphrase","onCommand:passwordTools.check"],"permissions":[],"contributes":{"commands":[{"command":"passwordTools.insert","title":"Insert Password","category":"Password Tools"},{"command":"passwordTools.insertMany","title":"Insert Several Passwords...","category":"Password Tools"},{"command":"passwordTools.passphrase","title":"Insert Passphrase","category":"Password Tools"},{"command":"passwordTools.check","title":"How Strong Is This Password?...","category":"Password Tools"}],"configuration":{"title":"Password Tools","properties":{"passwordTools.length":{"type":"number","default":20,"description":"Password length (8 to 128)."},"passwordTools.symbols":{"type":"boolean","default":true,"description":"Include symbols like !@#."},"passwordTools.avoidLookAlikes":{"type":"boolean","default":false,"description":"Leave out characters that look alike: O 0 I l 1."},"passwordTools.words":{"type":"number","default":5,"description":"Words in a passphrase (3 to 12)."}}}}},"files":{"icon.png":{"encoding":"base64","content":""},"extension.js":{"encoding":"utf8","content":"// Password Tools: generate strong passwords and passphrases with the system's secure random generator, and judge how strong a password is.\n// Nothing is stored or sent. Passwords go into your file only when you choose to insert them.\n\nconst SETS = { lower: 'abcdefghijklmnopqrstuvwxyz', upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', digits: '0123456789', symbols: '!@#$%^&*()-_=+[]{};:,.?' };\nconst AMBIGUOUS = /[O0oIl1|`'\"]/g;\n\n/** A uniform random integer below n, without modulo bias. */\nfunction randInt(n) {\n  const limit = Math.floor(0x100000000 / n) * n;\n  const a = new Uint32Array(1);\n  do crypto.getRandomValues(a);\n  while (a[0] >= limit);\n  return a[0] % n;\n}\n\nfunction password(opts = {}) {\n  const length = Math.max(8, Math.min(128, opts.length || 20));\n  const kinds = ['lower', 'upper', 'digits', 'symbols'].filter((k) => opts[k] !== false);\n  if (!kinds.length) throw new Error('Choose at least one kind of character.');\n  const pools = kinds.map((k) => (opts.noAmbiguous ? SETS[k].replace(AMBIGUOUS, '') : SETS[k]));\n  const all = pools.join('');\n  const out = pools.map((p) => p[randInt(p.length)]);\n  while (out.length < length) out.push(all[randInt(all.length)]);\n  for (let i = out.length - 1; i > 0; i--) {\n    const j = randInt(i + 1);\n    [out[i], out[j]] = [out[j], out[i]];\n  }\n  return out.join('');\n}\n\nconst WORDS = ('able acid aged also area army away baby back ball band bank base bath bear beat been bell belt bend best bike bird blue boat body bold bone book boom born boss both bowl bulk burn bush busy cafe cake call calm came camp card care cart case cash cast cave cell chat chef chip city clay clip club coal coat code coin cold come cook cool cope copy cord core corn cost crew crop dark data dawn days dead deal dear deck deep deer desk dial dice diet dirt dish disk dive dock does dome door dose down draw drip drop drum duck dust duty each earn ease east easy echo edge else even ever exit face fact fair fall farm fast fate fear feed feel fern file fill film find fine fire firm fish five flag flat flow foam fold folk food foot form fort four free from fuel full fund gain game gate gear gift girl give glad glow goal goat gold golf good grab gray grid grow gulf hair half hall hand hard harm hawk head heat held help herb here hero hide high hill hint hold home hope horn host hour huge hunt hurt idea inch iron isle item jade jazz join joke jump jury just keen keep kept kick kind king kiwi knee know lace lake lamp land lane last late lawn lead leaf lean left lens life lift like lime line link lion list live load loan lock loft logo long look loop lord lost loud love luck lush made mail main make mall many maps mark mask mate maze meal mean meat melt memo menu mess mild mile milk mind mine mint miss mode moon more moss most move much must myth name navy near neat neck need nest news next nice nine node none noon nose note noun oath oats ocean odds once only onto open oval oven over pace pack page paid pail pair palm park part pass past path peak pear peel pick pier pile pine pink pipe plan play plot plum plus poem poet pole poll pond pony pool port pose post pour pray pull pump pure push quit race rack rain rare rate read real reed rent rest rice rich ride ring rise risk road roar rock role roof room root rope rose ruby rule rush safe sage sail salt same sand save seal seat seed seek self sell send shed ship shoe shop shot show shut sick side sign silk sing sink site size skin slab slim slip slow snap snow soap soft soil sold sole some song soon sort soul soup spot star stay stem step stir stop such suit sure swan swim tail take tale talk tall tank tape task team tell tent term test text then thin tide tile time tiny tone took tool tops tour town trace tree trek trim trip true tube tune turn twin type unit upon used user vale vary vast very view vine visa void volt vote wade wait wake walk wall want warm wave ways weak wear week well west what when whom wide wife wild will wind wine wing wire wise wish with wolf wood wool word work worm wrap yard yarn year yoga zero zinc zone').split(' ');\n\nfunction passphrase(count = 5, sep = '-', capitalize = false) {\n  const n = Math.max(3, Math.min(12, count));\n  const w = [];\n  for (let i = 0; i < n; i++) {\n    const x = WORDS[randInt(WORDS.length)];\n    w.push(capitalize ? x[0].toUpperCase() + x.slice(1) : x);\n  }\n  return w.join(sep);\n}\n\n/** Entropy in bits, from the size of the character pool and the length, minus penalties for patterns. */\nfunction strength(pw) {\n  if (!pw) return { bits: 0, label: 'empty', notes: [] };\n  let pool = 0;\n  if (/[a-z]/.test(pw)) pool += 26;\n  if (/[A-Z]/.test(pw)) pool += 26;\n  if (/\\d/.test(pw)) pool += 10;\n  if (/[^A-Za-z0-9]/.test(pw)) pool += 30;\n  let bits = pw.length * Math.log2(Math.max(pool, 2));\n  const notes = [];\n  if (/(.)\\1{2,}/.test(pw)) {\n    bits -= 8;\n    notes.push('repeated characters');\n  }\n  if (/(?:abc|bcd|cde|def|123|234|345|456|567|678|789|qwe|wer|ert|asd|sdf|zxc)/i.test(pw)) {\n    bits -= 10;\n    notes.push('keyboard or alphabet sequence');\n  }\n  if (/^(password|passw0rd|admin|welcome|letmein|qwerty|azerty|iloveyou|monkey|dragon|123456)/i.test(pw)) {\n    bits = Math.min(bits, 10);\n    notes.push('one of the most common passwords');\n  }\n  if (/(19|20)\\d\\d$/.test(pw)) {\n    bits -= 6;\n    notes.push('ends with a year');\n  }\n  if (pw.length < 12) notes.push('shorter than 12 characters');\n  bits = Math.max(0, Math.round(bits));\n  const label = bits < 28 ? 'very weak' : bits < 45 ? 'weak' : bits < 60 ? 'fair' : bits < 80 ? 'strong' : 'very strong';\n  return { bits, label, notes };\n}\n\nexports._test = { password, passphrase, strength, randInt, SETS };\n\nexports.activate = function (context) {\n  const defaults = () => ({ length: Math.max(8, Math.min(128, Number(ferrum.settings.get('passwordTools.length')) || 20)), symbols: ferrum.settings.get('passwordTools.symbols') !== false, noAmbiguous: ferrum.settings.get('passwordTools.avoidLookAlikes') === true });\n  context.subscriptions.push(\n    ferrum.commands.register('passwordTools.insert', async () => ferrum.editor.insert(password(defaults()))),\n    ferrum.commands.register('passwordTools.insertMany', async () => {\n      const t = await ferrum.window.showInputBox({ prompt: 'How many passwords? (one per line)', value: '5' });\n      const n = Math.max(1, Math.min(100, Math.floor(Number(t)) || 5));\n      const out = [];\n      for (let i = 0; i < n; i++) out.push(password(defaults()));\n      await ferrum.editor.insert(out.join('\\n'));\n    }),\n    ferrum.commands.register('passwordTools.passphrase', async () => ferrum.editor.insert(passphrase(Number(ferrum.settings.get('passwordTools.words')) || 5, '-', false))),\n    ferrum.commands.register('passwordTools.check', async () => {\n      const doc = await ferrum.editor.active();\n      let pw = doc && doc.selectedText ? doc.selectedText : '';\n      if (!pw) pw = (await ferrum.window.showInputBox({ prompt: 'Password to judge (it is not stored or sent)' })) || '';\n      if (!pw) return;\n      const s = strength(pw);\n      ferrum.window.showMessage('About ' + s.bits + ' bits: ' + s.label + (s.notes.length ? ' (' + s.notes.join(', ') + ')' : ''), s.bits < 45 ? 'warn' : 'info');\n    }),\n  );\n};\n\nexports.deactivate = function () {};\n"},"README.md":{"encoding":"utf8","content":"# Password Tools\n\nPasswords always contain every kind of character you allow, in random order, using a bias free selection from the system's secure random generator (`crypto.getRandomValues`). Nothing is stored and nothing is sent anywhere.\n\n- **Insert Password** and **Insert Several Passwords...** write them at the cursor.\n- **Insert Passphrase** writes words joined by dashes (about 11 bits per word from a 400 word list, so 5 words is about 55 bits; use 7 or more for important accounts).\n- **How Strong Is This Password?...** estimates the entropy in bits and names weak habits: repeated characters, keyboard sequences, common passwords, a year at the end.\n\nThe strength check is a rough guide, not a guarantee. No permissions needed.\n"}}}