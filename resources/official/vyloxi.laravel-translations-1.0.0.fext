{"format":1,"manifest":{"name":"laravel-translations","publisher":"vyloxi","version":"1.0.0","displayName":"Laravel Translations","description":"Find translation keys used in code (__(), trans(), @lang) that no language file has, add them to lang/<locale>.json, and spot keys nobody uses.","engines":{"ferrum":"^0.1.0"},"categories":["Tools"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","main":"extension.js","activationEvents":["onCommand:laravelTranslations.report","onCommand:laravelTranslations.addMissing","onCommand:laravelTranslations.insertGroupKeys"],"permissions":["workspace.read","workspace.write"],"contributes":{"commands":[{"command":"laravelTranslations.report","title":"Translation Report","category":"Laravel Translations"},{"command":"laravelTranslations.addMissing","title":"Add Missing Keys to the JSON File...","category":"Laravel Translations"},{"command":"laravelTranslations.insertGroupKeys","title":"Insert PHP Array for Missing Group Keys...","category":"Laravel Translations"}],"configuration":{"title":"Laravel Translations","properties":{"laravelTranslations.locale":{"type":"string","default":"en","description":"The language to check when the project has only one, or when no other is picked."}}}}},"files":{"icon.png":{"encoding":"base64","content":""},"extension.js":{"encoding":"utf8","content":"// Laravel Translations: find keys you use in code (__('...'), trans(), @lang) that no language file defines, add them to lang/<locale>.json,\n// and find keys no code uses any more. It reads lang/ (or resources/lang/) as text: JSON files and PHP files that return an array.\n\n/** A small reader for PHP files that `return [ 'key' => 'value', 'group' => [ ... ] ];`. Returns flat dotted keys. */\nfunction parsePhpLang(text) {\n  const src = text.replace(/\\/\\*[\\s\\S]*?\\*\\//g, '').replace(/^\\s*(\\/\\/|#).*$/gm, '');\n  const start = src.indexOf('[', src.search(/return\\s*\\[/) >= 0 ? src.search(/return\\s*\\[/) : 0);\n  const out = {};\n  if (start < 0) return out;\n  let i = start;\n  const stack = [];\n  let key = null;\n  const skipWs = () => {\n    while (i < src.length && /[\\s,]/.test(src[i])) i++;\n  };\n  const readString = () => {\n    const q = src[i++];\n    let s = '';\n    while (i < src.length && src[i] !== q) {\n      if (src[i] === '\\\\' && i + 1 < src.length) {\n        s += q === \"'\" && !/['\\\\]/.test(src[i + 1]) ? '\\\\' + src[i + 1] : src[i + 1];\n        i += 2;\n      } else s += src[i++];\n    }\n    i++;\n    return s;\n  };\n  i++;\n  stack.push('');\n  while (i < src.length && stack.length) {\n    skipWs();\n    const c = src[i];\n    if (c === ']') {\n      stack.pop();\n      i++;\n      key = null;\n      continue;\n    }\n    if (c === \"'\" || c === '\"') {\n      const first = readString();\n      skipWs();\n      if (src.startsWith('=>', i)) {\n        i += 2;\n        skipWs();\n        key = first;\n        if (src[i] === '[') {\n          stack.push(stack[stack.length - 1] ? stack[stack.length - 1] + '.' + key : key);\n          i++;\n          key = null;\n        } else if (src[i] === \"'\" || src[i] === '\"') {\n          const v = readString();\n          const path = stack[stack.length - 1];\n          out[path ? path + '.' + key : key] = v;\n          key = null;\n        } else {\n          // a number, a constant or an expression: skip to the next comma at the same level\n          let depth = 0;\n          while (i < src.length && !(depth === 0 && /[,\\]]/.test(src[i]))) {\n            if (/[([]/.test(src[i])) depth++;\n            if (/[)\\]]/.test(src[i])) depth--;\n            i++;\n          }\n          key = null;\n        }\n      }\n      continue;\n    }\n    if (c === '[') {\n      stack.push(stack[stack.length - 1]);\n      i++;\n      continue;\n    }\n    i++;\n  }\n  return out;\n}\n\n/** Keys used in PHP and Blade code. A key with no dot or with spaces is a JSON key; \"file.key\" refers to lang/<locale>/file.php. */\nfunction usedKeys(source, file = '') {\n  const found = [];\n  const lines = source.split('\\n');\n  const re = /(?:\\b__|\\btrans|\\btrans_choice|@lang|\\bLang::get|\\bLang::choice)\\(\\s*(?:(')((?:[^'\\\\]|\\\\.)*)'|(\")((?:[^\"\\\\]|\\\\.)*)\")/g;\n  for (let i = 0; i < lines.length; i++) {\n    let m;\n    re.lastIndex = 0;\n    while ((m = re.exec(lines[i]))) {\n      const key = (m[2] ?? m[4]).replace(/\\\\(['\"\\\\])/g, '$1');\n      if (key && !/\\$|\\{/.test(key.replace(/:\\w+/g, ''))) found.push({ key, file, line: i + 1 });\n    }\n  }\n  return found;\n}\n\nconst isDotted = (k) => /^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$/.test(k) && !k.includes(' ');\n\n/** Splits what a language has into JSON keys and group keys, then says what code uses that it lacks. */\nfunction compare(used, defined) {\n  const have = new Set(defined);\n  const missing = new Map();\n  for (const u of used) if (!have.has(u.key) && !missing.has(u.key)) missing.set(u.key, u);\n  const usedSet = new Set(used.map((u) => u.key));\n  const unused = defined.filter((k) => !usedSet.has(k));\n  return { missing: [...missing.values()], unused };\n}\n\n/** Adds keys to the JSON of a language, keeping the existing order and sorting only when asked. */\nfunction addToJson(text, keys, valueFor) {\n  let obj = {};\n  if (text && text.trim()) obj = JSON.parse(text);\n  let added = 0;\n  for (const k of keys) {\n    if (!(k in obj)) {\n      obj[k] = valueFor ? valueFor(k) : k;\n      added++;\n    }\n  }\n  return { text: JSON.stringify(obj, null, 4) + '\\n', added };\n}\n\n/** A PHP array fragment for dotted keys of one file, nested by the dots. */\nfunction phpArray(keys, valueFor) {\n  const tree = {};\n  for (const k of keys) {\n    const parts = k.split('.').slice(1);\n    let n = tree;\n    parts.forEach((p, i) => {\n      if (i === parts.length - 1) n[p] = valueFor ? valueFor(k) : k.split('.').pop();\n      else n = n[p] ||= {};\n    });\n  }\n  const render = (o, ind) => Object.entries(o).map(([k, v]) => (typeof v === 'string' ? ind + \"'\" + k + \"' => '\" + v.replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\") + \"',\" : ind + \"'\" + k + \"' => [\\n\" + render(v, ind + '    ') + '\\n' + ind + '],')).join('\\n');\n  return render(tree, '    ');\n}\n\nexports._test = { parsePhpLang, usedKeys, compare, addToJson, phpArray, isDotted };\n\nexports.activate = function (context) {\n  const root = () => ferrum.workspace.root;\n  const sep = () => (root().includes('\\\\') ? '\\\\' : '/');\n  const full = (p) => (/^([a-zA-Z]:|[\\\\/])/.test(p) ? p : root() + sep() + p);\n\n  async function langDir() {\n    const files = await ferrum.workspace.listFiles('lang/**');\n    if (files.length) return 'lang';\n    const old = await ferrum.workspace.listFiles('resources/lang/**');\n    return old.length ? 'resources/lang' : 'lang';\n  }\n\n  async function scan(locale) {\n    const dir = await langDir();\n    const files = (await ferrum.workspace.listFiles()).filter((f) => /\\.(php|blade\\.php)$/.test(f) && /^(app|resources[\\\\/]views|routes|resources[\\\\/]js)/.test(f.replace(/\\\\/g, '/')) && !new RegExp('^' + dir.replace('/', '[\\\\\\\\/]') + '[\\\\\\\\/]').test(f));\n    const used = [];\n    for (const f of files) {\n      try {\n        used.push(...usedKeys(await ferrum.workspace.readFile(full(f)), f));\n      } catch {\n        /* skip */\n      }\n    }\n    const defined = [];\n    const all = (await ferrum.workspace.listFiles(dir + '/**')).map((f) => f.replace(/\\\\/g, '/'));\n    for (const f of all) {\n      if (f === dir + '/' + locale + '.json') {\n        try {\n          defined.push(...Object.keys(JSON.parse(await ferrum.workspace.readFile(full(f)))));\n        } catch {\n          /* invalid json is left out */\n        }\n      } else if (f.startsWith(dir + '/' + locale + '/') && f.endsWith('.php')) {\n        const group = f.split('/').pop().replace(/\\.php$/, '');\n        try {\n          for (const k of Object.keys(parsePhpLang(await ferrum.workspace.readFile(full(f))))) defined.push(group + '.' + k);\n        } catch {\n          /* skip */\n        }\n      }\n    }\n    return { used, defined, dir };\n  }\n\n  async function chooseLocale() {\n    const dir = await langDir();\n    const all = (await ferrum.workspace.listFiles(dir + '/**')).map((f) => f.replace(/\\\\/g, '/'));\n    const locales = new Set();\n    for (const f of all) {\n      const m = new RegExp('^' + dir + '/([A-Za-z_-]+)(?:\\\\.json$|/)').exec(f);\n      if (m) locales.add(m[1]);\n    }\n    const base = String(ferrum.settings.get('laravelTranslations.locale') || 'en');\n    if (!locales.size) return base;\n    if (locales.has(base) && locales.size === 1) return base;\n    const list = [...locales].sort();\n    const p = await ferrum.window.showQuickPick(list.map((l) => ({ label: l })), { placeholder: 'Which language?' });\n    return p ? p.label : null;\n  }\n\n  context.subscriptions.push(\n    ferrum.commands.register('laravelTranslations.report', async () => {\n      if (!root()) return ferrum.window.showMessage('Open the Laravel project folder first.', 'warn');\n      const locale = await chooseLocale();\n      if (!locale) return;\n      const { used, defined } = await ferrum.window.withProgress('Reading translations...', () => scan(locale));\n      const c = compare(used, defined);\n      const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');\n      await ferrum.window.showPanel({\n        title: 'Translations: ' + locale,\n        html: '<style>body{font-family:var(--ui)} table{border-collapse:collapse;font:12px var(--mono,monospace)} td{padding:3px 12px 3px 0;border-bottom:1px solid var(--border)} h4{margin:16px 0 4px}</style><h3>' + used.length + ' keys used, ' + defined.length + ' defined in ' + esc(locale) + '</h3><h4>Missing from ' + esc(locale) + ' (' + c.missing.length + ')</h4><table>' + (c.missing.map((m) => '<tr><td>' + esc(m.key) + '</td><td>' + esc(m.file) + ':' + m.line + '</td></tr>').join('') || '<tr><td>Nothing is missing.</td></tr>') + '</table><h4>Defined but never used (' + c.unused.length + ')</h4><table>' + (c.unused.slice(0, 300).map((k) => '<tr><td>' + esc(k) + '</td></tr>').join('') || '<tr><td>Everything is used.</td></tr>') + '</table><p style=\"color:var(--fg-dim)\">Keys built from variables, and keys used only in JavaScript or by packages, can show as unused.</p>',\n      });\n    }),\n    ferrum.commands.register('laravelTranslations.addMissing', async () => {\n      if (!root()) return ferrum.window.showMessage('Open the Laravel project folder first.', 'warn');\n      const locale = await chooseLocale();\n      if (!locale) return;\n      const { used, defined, dir } = await scan(locale);\n      const c = compare(used, defined);\n      const json = c.missing.filter((m) => !isDotted(m.key)).map((m) => m.key);\n      const groups = c.missing.filter((m) => isDotted(m.key)).map((m) => m.key);\n      if (!json.length && !groups.length) return ferrum.window.showMessage('No translation is missing.');\n      if (json.length) {\n        if (!(await ferrum.window.confirm('Add ' + json.length + ' keys to ' + dir + '/' + locale + '.json (the key text is used as the translation)?', 'Add'))) return;\n        const path = full(dir + '/' + locale + '.json');\n        let text = '';\n        try {\n          text = await ferrum.workspace.readFile(path);\n        } catch {\n          text = '';\n        }\n        try {\n          const r = addToJson(text, json);\n          await ferrum.workspace.writeFile(path, r.text);\n          ferrum.window.showMessage('Added ' + r.added + ' keys to ' + dir + '/' + locale + '.json.' + (groups.length ? ' ' + groups.length + ' group keys (like auth.failed) need a PHP file: use \"Insert PHP Array for Missing Group Keys\".' : ''));\n        } catch (e) {\n          ferrum.window.showMessage('The JSON file could not be read: ' + e.message, 'error');\n        }\n      } else ferrum.window.showMessage(groups.length + ' missing keys are group keys (like auth.failed). Use \"Insert PHP Array for Missing Group Keys\".', 'warn');\n    }),\n    ferrum.commands.register('laravelTranslations.insertGroupKeys', async () => {\n      if (!root()) return ferrum.window.showMessage('Open the Laravel project folder first.', 'warn');\n      const locale = await chooseLocale();\n      if (!locale) return;\n      const { used, defined } = await scan(locale);\n      const groups = compare(used, defined).missing.map((m) => m.key).filter(isDotted);\n      if (!groups.length) return ferrum.window.showMessage('No group key is missing.');\n      const byFile = {};\n      for (const k of groups) (byFile[k.split('.')[0]] ||= []).push(k);\n      const file = await ferrum.window.showQuickPick(Object.keys(byFile).map((f) => ({ label: f + '.php', detail: byFile[f].length + ' missing keys', f })), { placeholder: 'For which file?' });\n      if (file) await ferrum.editor.insert(phpArray(byFile[file.f]));\n    }),\n  );\n};\n\nexports.deactivate = function () {};\n"},"README.md":{"encoding":"utf8","content":"# Laravel Translations\n\nScans `app/`, `routes/` and `resources/views` for `__('...')`, `trans('...')`, `trans_choice`, `@lang('...')` and `Lang::get`, and compares them with `lang/<locale>.json` and `lang/<locale>/*.php` (or the older `resources/lang`).\n\n- **Translation Report** shows the keys code uses that the language does not define (with file and line) and the keys defined but never used.\n- **Add Missing Keys to the JSON File...** adds JSON style keys (`__('Welcome back')`) to `lang/<locale>.json`, using the key text as the value so the page keeps working until you translate it. It asks first and keeps what is already there.\n- **Insert PHP Array for Missing Group Keys...** writes the nested array lines for keys like `auth.failed`, ready to paste in `lang/en/auth.php`.\n\nKeys built from variables (`__(\"status.$s\")`) are ignored. Keys used only in JavaScript or by packages can appear as unused.\n\nPermissions: workspace.read, workspace.write.\n"}}}