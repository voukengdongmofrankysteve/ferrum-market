{"format":1,"manifest":{"name":"node-snippets","publisher":"vyloxi","version":"1.0.0","displayName":"Node.js and Express Snippets","description":"Servers, routes, middleware, file system and process helpers for Node.js.","engines":{"ferrum":"^0.1.0"},"categories":["Snippets"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","contributes":{"snippets":[{"language":"JavaScript","path":"snippets/javascript.json"}]}},"files":{"icon.png":{"encoding":"base64","content":""},"snippets/javascript.json":{"encoding":"utf8","content":"{\n  \"Express server\": {\n    \"prefix\": \"exp\",\n    \"body\": [\n      \"import express from 'express';\",\n      \"\",\n      \"const app = express();\",\n      \"app.use(express.json());\",\n      \"\",\n      \"app.get('/', (req, res) => {\",\n      \"\\tres.json({ ok: true });\",\n      \"});\",\n      \"\",\n      \"app.listen(${1:3000}, () => console.log(\\\"listening on ${1:3000}\\\"));\"\n    ],\n    \"description\": \"A minimal Express server\"\n  },\n  \"Express route\": {\n    \"prefix\": \"route\",\n    \"body\": [\n      \"app.${1:get}('${2:/path}', async (req, res) => {\",\n      \"\\t$0\",\n      \"});\"\n    ],\n    \"description\": \"An Express route\"\n  },\n  \"Express middleware\": {\n    \"prefix\": \"mw\",\n    \"body\": [\n      \"app.use((req, res, next) => {\",\n      \"\\t$0\",\n      \"\\tnext();\",\n      \"});\"\n    ],\n    \"description\": \"A middleware\"\n  },\n  \"Read file\": {\n    \"prefix\": \"rf\",\n    \"body\": [\n      \"import { readFile } from 'node:fs/promises';\",\n      \"const ${1:text} = await readFile(${2:'file.txt'}, 'utf8');\"\n    ],\n    \"description\": \"Read a text file\"\n  },\n  \"Write file\": {\n    \"prefix\": \"wf\",\n    \"body\": [\n      \"import { writeFile } from 'node:fs/promises';\",\n      \"await writeFile(${1:path}, ${2:text});\"\n    ],\n    \"description\": \"Write a text file\"\n  },\n  \"Path join\": {\n    \"prefix\": \"pj\",\n    \"body\": [\n      \"import path from 'node:path';\",\n      \"path.join(${1:__dirname}, ${2:\\\"file\\\"})\"\n    ],\n    \"description\": \"path.join\"\n  },\n  \"Env variable\": {\n    \"prefix\": \"env\",\n    \"body\": [\n      \"process.env.${1:NAME} ?? ${2:\\\"default\\\"}\"\n    ],\n    \"description\": \"process.env with a default\"\n  },\n  \"Process exit on error\": {\n    \"prefix\": \"pe\",\n    \"body\": [\n      \"process.on('unhandledRejection', (err) => {\",\n      \"\\tconsole.error(err);\",\n      \"\\tprocess.exit(1);\",\n      \"});\"\n    ],\n    \"description\": \"Handle unhandled rejections\"\n  },\n  \"CLI args\": {\n    \"prefix\": \"args\",\n    \"body\": [\n      \"const [${1:first}] = process.argv.slice(2);\"\n    ],\n    \"description\": \"Read CLI arguments\"\n  }\n}\n"},"README.md":{"encoding":"utf8","content":"# Node.js and Express Snippets\n\nServers, routes, middleware, file system and process helpers for Node.js.\n\nType a prefix and press Tab. 9 snippets.\n\n| Language | Prefix | What it inserts |\n| --- | --- | --- |\n| JavaScript | `exp` | A minimal Express server |\n| JavaScript | `route` | An Express route |\n| JavaScript | `mw` | A middleware |\n| JavaScript | `rf` | Read a text file |\n| JavaScript | `wf` | Write a text file |\n| JavaScript | `pj` | path.join |\n| JavaScript | `env` | process.env with a default |\n| JavaScript | `pe` | Handle unhandled rejections |\n| JavaScript | `args` | Read CLI arguments |\n\nThis extension runs no code and asks for no permissions.\n"}}}