{"format":1,"manifest":{"name":"laravel-snippets","publisher":"vyloxi","version":"1.0.0","displayName":"Laravel Snippets","description":"Routes, controllers, Eloquent, migrations, requests, jobs, tests and Blade directives. Install the PHP and Laravel Blade extensions for colors.","engines":{"ferrum":"^0.1.0"},"categories":["Snippets"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","contributes":{"snippets":[{"language":"PHP","path":"snippets/php.json"},{"language":"Laravel Blade","path":"snippets/laravel-blade.json"}]}},"files":{"icon.png":{"encoding":"base64","content":""},"snippets/php.json":{"encoding":"utf8","content":"{\n  \"Route\": {\n    \"prefix\": \"lroute\",\n    \"body\": [\n      \"Route::${1:get}('${2:/path}', [${3:Controller}::class, '${4:index}']);\"\n    ],\n    \"description\": \"A route\"\n  },\n  \"Resource route\": {\n    \"prefix\": \"lres\",\n    \"body\": [\n      \"Route::resource('${1:posts}', ${2:PostController}::class);\"\n    ],\n    \"description\": \"A resource route\"\n  },\n  \"Route group\": {\n    \"prefix\": \"lgroup\",\n    \"body\": [\n      \"Route::middleware('${1:auth}')->prefix('${2:admin}')->group(function () {\",\n      \"    $0\",\n      \"});\"\n    ],\n    \"description\": \"A route group\"\n  },\n  \"Controller\": {\n    \"prefix\": \"lctrl\",\n    \"body\": [\n      \"<?php\",\n      \"\",\n      \"namespace App\\\\\\\\Http\\\\\\\\Controllers;\",\n      \"\",\n      \"use Illuminate\\\\\\\\Http\\\\\\\\Request;\",\n      \"\",\n      \"class ${1:Name}Controller extends Controller\",\n      \"{\",\n      \"    public function index()\",\n      \"    {\",\n      \"        $0\",\n      \"    }\",\n      \"}\"\n    ],\n    \"description\": \"A controller\"\n  },\n  \"Model\": {\n    \"prefix\": \"lmodel\",\n    \"body\": [\n      \"<?php\",\n      \"\",\n      \"namespace App\\\\\\\\Models;\",\n      \"\",\n      \"use Illuminate\\\\\\\\Database\\\\\\\\Eloquent\\\\\\\\Model;\",\n      \"\",\n      \"class ${1:Name} extends Model\",\n      \"{\",\n      \"    protected \\\\$fillable = [${2:'name'}];\",\n      \"\",\n      \"    $0\",\n      \"}\"\n    ],\n    \"description\": \"An Eloquent model\"\n  },\n  \"Migration\": {\n    \"prefix\": \"lmig\",\n    \"body\": [\n      \"<?php\",\n      \"\",\n      \"use Illuminate\\\\\\\\Database\\\\\\\\Migrations\\\\\\\\Migration;\",\n      \"use Illuminate\\\\\\\\Database\\\\\\\\Schema\\\\\\\\Blueprint;\",\n      \"use Illuminate\\\\\\\\Support\\\\\\\\Facades\\\\\\\\Schema;\",\n      \"\",\n      \"return new class extends Migration\",\n      \"{\",\n      \"    public function up(): void\",\n      \"    {\",\n      \"        Schema::create('${1:table}', function (Blueprint \\\\$table) {\",\n      \"            \\\\$table->id();\",\n      \"            $0\",\n      \"            \\\\$table->timestamps();\",\n      \"        });\",\n      \"    }\",\n      \"\",\n      \"    public function down(): void\",\n      \"    {\",\n      \"        Schema::dropIfExists('${1:table}');\",\n      \"    }\",\n      \"};\"\n    ],\n    \"description\": \"A migration\"\n  },\n  \"Form request\": {\n    \"prefix\": \"lreq\",\n    \"body\": [\n      \"<?php\",\n      \"\",\n      \"namespace App\\\\\\\\Http\\\\\\\\Requests;\",\n      \"\",\n      \"use Illuminate\\\\\\\\Foundation\\\\\\\\Http\\\\\\\\FormRequest;\",\n      \"\",\n      \"class ${1:Store}Request extends FormRequest\",\n      \"{\",\n      \"    public function authorize(): bool\",\n      \"    {\",\n      \"        return true;\",\n      \"    }\",\n      \"\",\n      \"    public function rules(): array\",\n      \"    {\",\n      \"        return [\",\n      \"            '${2:name}' => ['required', 'string', 'max:255'],\",\n      \"        ];\",\n      \"    }\",\n      \"}\"\n    ],\n    \"description\": \"A form request\"\n  },\n  \"Validate\": {\n    \"prefix\": \"lvalid\",\n    \"body\": [\n      \"\\\\$validated = \\\\$request->validate([\",\n      \"    '${1:name}' => 'required|string|max:255',\",\n      \"]);\"\n    ],\n    \"description\": \"Validate input\"\n  },\n  \"Eloquent where\": {\n    \"prefix\": \"lwhere\",\n    \"body\": [\n      \"${1:Model}::where('${2:column}', ${3:\\\\$value})->${4:get}();\"\n    ],\n    \"description\": \"An Eloquent query\"\n  },\n  \"Relationship hasMany\": {\n    \"prefix\": \"lhasmany\",\n    \"body\": [\n      \"public function ${1:posts}()\",\n      \"{\",\n      \"    return \\\\$this->hasMany(${2:Post}::class);\",\n      \"}\"\n    ],\n    \"description\": \"hasMany\"\n  },\n  \"Relationship belongsTo\": {\n    \"prefix\": \"lbelongs\",\n    \"body\": [\n      \"public function ${1:user}()\",\n      \"{\",\n      \"    return \\\\$this->belongsTo(${2:User}::class);\",\n      \"}\"\n    ],\n    \"description\": \"belongsTo\"\n  },\n  \"Job\": {\n    \"prefix\": \"ljob\",\n    \"body\": [\n      \"<?php\",\n      \"\",\n      \"namespace App\\\\\\\\Jobs;\",\n      \"\",\n      \"use Illuminate\\\\\\\\Contracts\\\\\\\\Queue\\\\\\\\ShouldQueue;\",\n      \"use Illuminate\\\\\\\\Foundation\\\\\\\\Queue\\\\\\\\Queueable;\",\n      \"\",\n      \"class ${1:Name} implements ShouldQueue\",\n      \"{\",\n      \"    use Queueable;\",\n      \"\",\n      \"    public function handle(): void\",\n      \"    {\",\n      \"        $0\",\n      \"    }\",\n      \"}\"\n    ],\n    \"description\": \"A queued job\"\n  },\n  \"Feature test\": {\n    \"prefix\": \"ltest\",\n    \"body\": [\n      \"public function test_${1:it_works}(): void\",\n      \"{\",\n      \"    \\\\$response = \\\\$this->get('${2:/}');\",\n      \"\",\n      \"    \\\\$response->assertStatus(200);\",\n      \"}\"\n    ],\n    \"description\": \"A feature test\"\n  },\n  \"Factory definition\": {\n    \"prefix\": \"lfact\",\n    \"body\": [\n      \"public function definition(): array\",\n      \"{\",\n      \"    return [\",\n      \"        '${1:name}' => fake()->name(),\",\n      \"    ];\",\n      \"}\"\n    ],\n    \"description\": \"A factory definition\"\n  },\n  \"Log\": {\n    \"prefix\": \"llog\",\n    \"body\": [\n      \"Log::${1:info}('${2:message}', [${3}]);\"\n    ],\n    \"description\": \"Log::info\"\n  },\n  \"Config\": {\n    \"prefix\": \"lconf\",\n    \"body\": [\n      \"config('${1:app.name}')\"\n    ],\n    \"description\": \"config()\"\n  },\n  \"Response JSON\": {\n    \"prefix\": \"ljson\",\n    \"body\": [\n      \"return response()->json(['${1:ok}' => true]${2:, 200});\"\n    ],\n    \"description\": \"A JSON response\"\n  },\n  \"Cache remember\": {\n    \"prefix\": \"lcache\",\n    \"body\": [\n      \"Cache::remember('${1:key}', ${2:3600}, fn () => ${3:\\\\$value});\"\n    ],\n    \"description\": \"Cache::remember\"\n  }\n}\n"},"snippets/laravel-blade.json":{"encoding":"utf8","content":"{\n  \"Layout extends\": {\n    \"prefix\": \"bextends\",\n    \"body\": [\n      \"@extends('${1:layouts.app}')\",\n      \"\",\n      \"@section('${2:content}')\",\n      \"    $0\",\n      \"@endsection\"\n    ],\n    \"description\": \"@extends\"\n  },\n  \"Component\": {\n    \"prefix\": \"bcomp\",\n    \"body\": [\n      \"<x-${1:alert} ${2:type}=\\\"${3:info}\\\">\",\n      \"    $0\",\n      \"</x-${1:alert}>\"\n    ],\n    \"description\": \"A Blade component\"\n  },\n  \"Auth\": {\n    \"prefix\": \"bauth\",\n    \"body\": [\n      \"@auth\",\n      \"    $0\",\n      \"@else\",\n      \"    \",\n      \"@endauth\"\n    ],\n    \"description\": \"@auth\"\n  },\n  \"Forelse\": {\n    \"prefix\": \"bforelse\",\n    \"body\": [\n      \"@forelse (${1:\\\\$items} as ${2:\\\\$item})\",\n      \"    $0\",\n      \"@empty\",\n      \"    <p>No items.</p>\",\n      \"@endforelse\"\n    ],\n    \"description\": \"@forelse\"\n  },\n  \"Error message\": {\n    \"prefix\": \"berror\",\n    \"body\": [\n      \"@error('${1:field}')\",\n      \"    <span class=\\\"text-red-600\\\">{{ \\\\$message }}</span>\",\n      \"@enderror\"\n    ],\n    \"description\": \"@error\"\n  },\n  \"Old input\": {\n    \"prefix\": \"bold\",\n    \"body\": [\n      \"value=\\\"{{ old('${1:name}') }}\\\"\"\n    ],\n    \"description\": \"old()\"\n  },\n  \"Method field\": {\n    \"prefix\": \"bmethod\",\n    \"body\": [\n      \"@method('${1:PUT}')\"\n    ],\n    \"description\": \"A spoofed method\"\n  },\n  \"Push stack\": {\n    \"prefix\": \"bpush\",\n    \"body\": [\n      \"@push('${1:scripts}')\",\n      \"    $0\",\n      \"@endpush\"\n    ],\n    \"description\": \"@push\"\n  }\n}\n"},"README.md":{"encoding":"utf8","content":"# Laravel Snippets\n\nRoutes, controllers, Eloquent, migrations, requests, jobs, tests and Blade directives. Install the PHP and Laravel Blade extensions for colors.\n\nType a prefix and press Tab. 26 snippets.\n\n| Language | Prefix | What it inserts |\n| --- | --- | --- |\n| PHP | `lroute` | A route |\n| PHP | `lres` | A resource route |\n| PHP | `lgroup` | A route group |\n| PHP | `lctrl` | A controller |\n| PHP | `lmodel` | An Eloquent model |\n| PHP | `lmig` | A migration |\n| PHP | `lreq` | A form request |\n| PHP | `lvalid` | Validate input |\n| PHP | `lwhere` | An Eloquent query |\n| PHP | `lhasmany` | hasMany |\n| PHP | `lbelongs` | belongsTo |\n| PHP | `ljob` | A queued job |\n| PHP | `ltest` | A feature test |\n| PHP | `lfact` | A factory definition |\n| PHP | `llog` | Log::info |\n| PHP | `lconf` | config() |\n| PHP | `ljson` | A JSON response |\n| PHP | `lcache` | Cache::remember |\n| Laravel Blade | `bextends` | @extends |\n| Laravel Blade | `bcomp` | A Blade component |\n| Laravel Blade | `bauth` | @auth |\n| Laravel Blade | `bforelse` | @forelse |\n| Laravel Blade | `berror` | @error |\n| Laravel Blade | `bold` | old() |\n| Laravel Blade | `bmethod` | A spoofed method |\n| Laravel Blade | `bpush` | @push |\n\nThis extension runs no code and asks for no permissions.\n"}}}