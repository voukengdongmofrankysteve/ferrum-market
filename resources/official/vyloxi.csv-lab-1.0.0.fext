{"format":1,"manifest":{"name":"csv-lab","publisher":"vyloxi","version":"1.0.0","displayName":"CSV Lab","description":"Look at CSV and TSV as a table with column statistics, sort, filter, drop columns, and convert to JSON, Markdown or another delimiter.","engines":{"ferrum":"^0.1.0"},"categories":["Tools"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","main":"extension.js","activationEvents":["onCommand:csvLab.preview","onCommand:csvLab.stats","onCommand:csvLab.sort","onCommand:csvLab.filter","onCommand:csvLab.dropColumn","onCommand:csvLab.toJson","onCommand:csvLab.toMarkdown","onCommand:csvLab.convertDelimiter"],"permissions":[],"contributes":{"commands":[{"command":"csvLab.preview","title":"Preview as Table with Statistics","category":"CSV Lab"},{"command":"csvLab.stats","title":"Sum and Mean of Numeric Columns","category":"CSV Lab"},{"command":"csvLab.sort","title":"Sort by Column...","category":"CSV Lab"},{"command":"csvLab.filter","title":"Keep Rows Containing...","category":"CSV Lab"},{"command":"csvLab.dropColumn","title":"Remove Column...","category":"CSV Lab"},{"command":"csvLab.toJson","title":"Insert as JSON","category":"CSV Lab"},{"command":"csvLab.toMarkdown","title":"Insert as Markdown Table","category":"CSV Lab"},{"command":"csvLab.convertDelimiter","title":"Change Delimiter...","category":"CSV Lab"}]}},"files":{"icon.png":{"encoding":"base64","content":""},"extension.js":{"encoding":"utf8","content":"// CSV Lab: look at CSV and TSV as a table, with column statistics, sorting, filtering and conversion to JSON or Markdown.\n\n/** A real CSV parser: quotes, doubled quotes, commas and line breaks inside quotes. */\nfunction parse(text, delim) {\n  const rows = [];\n  let row = [];\n  let cell = '';\n  let q = false;\n  const t = text.replace(/^﻿/, '');\n  for (let i = 0; i < t.length; i++) {\n    const c = t[i];\n    if (q) {\n      if (c === '\"' && t[i + 1] === '\"') {\n        cell += '\"';\n        i++;\n      } else if (c === '\"') q = false;\n      else cell += c;\n    } else if (c === '\"' && cell === '') q = true;\n    else if (c === delim) {\n      row.push(cell);\n      cell = '';\n    } else if (c === '\\n' || c === '\\r') {\n      if (c === '\\r' && t[i + 1] === '\\n') i++;\n      row.push(cell);\n      rows.push(row);\n      row = [];\n      cell = '';\n    } else cell += c;\n  }\n  if (cell !== '' || row.length) {\n    row.push(cell);\n    rows.push(row);\n  }\n  return rows.filter((r) => !(r.length === 1 && r[0] === ''));\n}\n\nfunction detectDelimiter(text) {\n  const first = text.split('\\n').slice(0, 5).join('\\n');\n  let best = ',';\n  let score = -1;\n  for (const d of [',', ';', '\\t', '|']) {\n    const n = first.split(d).length - 1;\n    if (n > score) {\n      score = n;\n      best = d;\n    }\n  }\n  return best;\n}\n\nconst quote = (v, d) => (v.includes('\"') || v.includes(d) || /[\\n\\r]/.test(v) ? '\"' + v.replace(/\"/g, '\"\"') + '\"' : v);\nconst stringify = (rows, d) => rows.map((r) => r.map((v) => quote(String(v), d)).join(d)).join('\\n') + '\\n';\n\nconst isNum = (v) => v.trim() !== '' && !Number.isNaN(Number(v.replace(/,/g, '')));\n\n/** Statistics per column: type, empty cells, distinct values, and for numbers min, max, mean, median and sum. */\nfunction stats(rows) {\n  const [head, ...body] = rows;\n  return head.map((name, i) => {\n    const vals = body.map((r) => r[i] ?? '');\n    const filled = vals.filter((v) => v.trim() !== '');\n    const nums = filled.filter(isNum).map((v) => Number(v.replace(/,/g, '')));\n    const numeric = filled.length > 0 && nums.length === filled.length;\n    const s = { name, type: numeric ? 'number' : 'text', rows: vals.length, empty: vals.length - filled.length, distinct: new Set(filled).size };\n    if (numeric) {\n      const sorted = [...nums].sort((a, b) => a - b);\n      const sum = nums.reduce((a, b) => a + b, 0);\n      s.min = sorted[0];\n      s.max = sorted[sorted.length - 1];\n      s.sum = Math.round(sum * 1e6) / 1e6;\n      s.mean = Math.round((sum / nums.length) * 1e6) / 1e6;\n      s.median = nums.length % 2 ? sorted[(nums.length - 1) / 2] : (sorted[nums.length / 2 - 1] + sorted[nums.length / 2]) / 2;\n    } else {\n      const count = new Map();\n      for (const v of filled) count.set(v, (count.get(v) || 0) + 1);\n      s.top = [...count.entries()].sort((a, b) => b[1] - a[1]).slice(0, 3).map(([v, n]) => v + ' (' + n + ')');\n    }\n    return s;\n  });\n}\n\nfunction sortBy(rows, col, desc) {\n  const [head, ...body] = rows;\n  const numeric = body.every((r) => (r[col] ?? '') === '' || isNum(r[col]));\n  const key = (r) => (numeric ? Number((r[col] || '0').replace(/,/g, '')) : (r[col] ?? '').toLowerCase());\n  body.sort((a, b) => (key(a) < key(b) ? -1 : key(a) > key(b) ? 1 : 0) * (desc ? -1 : 1));\n  return [head, ...body];\n}\n\nfunction filterRows(rows, col, needle) {\n  const [head, ...body] = rows;\n  const n = needle.toLowerCase();\n  return [head, ...body.filter((r) => (r[col] ?? '').toLowerCase().includes(n))];\n}\n\nfunction toJson(rows) {\n  const [head, ...body] = rows;\n  return JSON.stringify(\n    body.map((r) => Object.fromEntries(head.map((h, i) => [h, isNum(r[i] ?? '') && !/^0\\d/.test(r[i]) ? Number(r[i]) : r[i] ?? '']))),\n    null,\n    2,\n  );\n}\n\nfunction toMarkdown(rows) {\n  const [head, ...body] = rows;\n  const esc = (v) => String(v).replace(/\\|/g, '\\\\|').replace(/\\n/g, ' ');\n  return ['| ' + head.map(esc).join(' | ') + ' |', '| ' + head.map(() => '---').join(' | ') + ' |', ...body.map((r) => '| ' + head.map((_, i) => esc(r[i] ?? '')).join(' | ') + ' |')].join('\\n') + '\\n';\n}\n\nfunction dropColumns(rows, cols) {\n  const keep = rows[0].map((_, i) => i).filter((i) => !cols.includes(i));\n  return rows.map((r) => keep.map((i) => r[i] ?? ''));\n}\n\nexports._test = { parse, detectDelimiter, stringify, stats, sortBy, filterRows, toJson, toMarkdown, dropColumns, isNum };\n\nconst esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');\n\nfunction tablePage(rows, st) {\n  const head = rows[0];\n  const shown = rows.slice(1, 201);\n  return `<style>body{font-family:var(--ui)} table{border-collapse:collapse;font:12px var(--mono,monospace);margin:8px 0} td,th{border:1px solid var(--border);padding:3px 8px;text-align:left;vertical-align:top} th{background:var(--raised,transparent);color:var(--fg-dim);font-weight:500;position:sticky;top:0} .n{text-align:right}</style>\n  <h3>${rows.length - 1} rows, ${head.length} columns</h3>\n  <h4>Columns</h4><table><tr><th>Column</th><th>Type</th><th>Empty</th><th>Distinct</th><th>Min</th><th>Max</th><th>Mean</th><th>Median</th><th>Sum</th><th>Most common</th></tr>\n  ${st.map((s) => '<tr><td>' + esc(s.name) + '</td><td>' + s.type + '</td><td class=\"n\">' + s.empty + '</td><td class=\"n\">' + s.distinct + '</td><td class=\"n\">' + (s.min ?? '') + '</td><td class=\"n\">' + (s.max ?? '') + '</td><td class=\"n\">' + (s.mean ?? '') + '</td><td class=\"n\">' + (s.median ?? '') + '</td><td class=\"n\">' + (s.sum ?? '') + '</td><td>' + esc((s.top || []).join(', ')) + '</td></tr>').join('')}</table>\n  <h4>Data${rows.length > 201 ? ' (first 200 rows)' : ''}</h4><table><tr>${head.map((h) => '<th>' + esc(h) + '</th>').join('')}</tr>${shown.map((r) => '<tr>' + head.map((_, i) => '<td>' + esc(r[i] ?? '') + '</td>').join('') + '</tr>').join('')}</table>`;\n}\n\nexports.activate = function (context) {\n  async function load() {\n    const doc = await ferrum.editor.active();\n    if (!doc) {\n      ferrum.window.showMessage('Open a CSV or TSV file first.', 'warn');\n      return null;\n    }\n    const text = doc.selectedText || doc.text;\n    const delim = detectDelimiter(text);\n    const rows = parse(text, delim);\n    if (rows.length < 1) {\n      ferrum.window.showMessage('The file has no rows.', 'warn');\n      return null;\n    }\n    const width = rows[0].length;\n    return { doc, rows: rows.map((r) => Array.from({ length: width }, (_, i) => r[i] ?? '')), delim, selected: !!doc.selectedText };\n  }\n  async function pickColumn(d, placeholder) {\n    const p = await ferrum.window.showQuickPick(d.rows[0].map((h, i) => ({ label: h || 'column ' + (i + 1), detail: 'column ' + (i + 1), i })), { placeholder });\n    return p ? p.i : -1;\n  }\n  async function writeBack(d, text) {\n    if (d.selected) await ferrum.editor.insert(text);\n    else await ferrum.editor.replace({ start: { line: 0, col: 0 }, end: { line: d.doc.lineCount, col: 0 } }, text);\n  }\n\n  context.subscriptions.push(\n    ferrum.commands.register('csvLab.preview', async () => {\n      const d = await load();\n      if (d) await ferrum.window.showPanel({ title: 'CSV: ' + d.doc.name, html: tablePage(d.rows, stats(d.rows)) });\n    }),\n    ferrum.commands.register('csvLab.stats', async () => {\n      const d = await load();\n      if (!d) return;\n      const num = stats(d.rows).filter((s) => s.type === 'number');\n      ferrum.window.showMessage(num.length ? num.map((s) => s.name + ': sum ' + s.sum + ', mean ' + s.mean).join('  |  ') : 'No numeric column found.');\n    }),\n    ferrum.commands.register('csvLab.sort', async () => {\n      const d = await load();\n      if (!d) return;\n      const c = await pickColumn(d, 'Sort by which column?');\n      if (c < 0) return;\n      const dir = await ferrum.window.showQuickPick(['Ascending', 'Descending'], { placeholder: 'Order' });\n      if (dir) await writeBack(d, stringify(sortBy(d.rows, c, dir === 'Descending'), d.delim));\n    }),\n    ferrum.commands.register('csvLab.filter', async () => {\n      const d = await load();\n      if (!d) return;\n      const c = await pickColumn(d, 'Keep rows where which column...');\n      if (c < 0) return;\n      const needle = await ferrum.window.showInputBox({ prompt: 'contains (not case sensitive)' });\n      if (needle === undefined) return;\n      const rows = filterRows(d.rows, c, needle);\n      if (await ferrum.window.confirm('Keep ' + (rows.length - 1) + ' of ' + (d.rows.length - 1) + ' rows?', 'Keep')) await writeBack(d, stringify(rows, d.delim));\n    }),\n    ferrum.commands.register('csvLab.dropColumn', async () => {\n      const d = await load();\n      if (!d) return;\n      const c = await pickColumn(d, 'Remove which column?');\n      if (c >= 0) await writeBack(d, stringify(dropColumns(d.rows, [c]), d.delim));\n    }),\n    ferrum.commands.register('csvLab.toJson', async () => {\n      const d = await load();\n      if (d) await ferrum.editor.insert(toJson(d.rows));\n    }),\n    ferrum.commands.register('csvLab.toMarkdown', async () => {\n      const d = await load();\n      if (d) await ferrum.editor.insert(toMarkdown(d.rows));\n    }),\n    ferrum.commands.register('csvLab.convertDelimiter', async () => {\n      const d = await load();\n      if (!d) return;\n      const pick = await ferrum.window.showQuickPick([{ label: 'Comma ,', d: ',' }, { label: 'Semicolon ;', d: ';' }, { label: 'Tab', d: '\\t' }, { label: 'Pipe |', d: '|' }], { placeholder: 'Convert to' });\n      if (pick) await writeBack(d, stringify(d.rows, pick.d));\n    }),\n  );\n};\n\nexports.deactivate = function () {};\n"},"README.md":{"encoding":"utf8","content":"# CSV Lab\n\nWorks on the open file, or only on your selection. The delimiter (comma, semicolon, tab or pipe) is detected. Quoted cells with commas, doubled quotes and line breaks inside are read correctly.\n\n- **Preview as Table with Statistics** shows the data (first 200 rows) and, for each column, the type, empty cells, distinct values and, for numbers, min, max, mean, median and sum. Text columns show the most common values.\n- **Sort by Column...**, **Keep Rows Containing...** and **Remove Column...** rewrite the text (one undo step). Numbers sort as numbers.\n- **Insert as JSON** and **Insert as Markdown Table** write the result at the cursor.\n- **Change Delimiter...** converts between comma, semicolon, tab and pipe.\n\nNo permissions needed.\n"}}}