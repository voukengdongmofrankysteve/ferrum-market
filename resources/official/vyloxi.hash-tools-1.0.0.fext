{"format":1,"manifest":{"name":"hash-tools","publisher":"vyloxi","version":"1.0.0","displayName":"Hash Tools","description":"MD5, SHA-1, SHA-256, SHA-384, SHA-512 and HMAC-SHA256 of your selection or file.","engines":{"ferrum":"^0.1.0"},"categories":["Tools"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","main":"extension.js","activationEvents":["onCommand:hashTools.sha256","onCommand:hashTools.sha1","onCommand:hashTools.sha512","onCommand:hashTools.sha384","onCommand:hashTools.md5","onCommand:hashTools.hmacSha256","onCommand:hashTools.all"],"permissions":[],"contributes":{"commands":[{"command":"hashTools.sha256","title":"SHA-256 of Selection","category":"Hash Tools"},{"command":"hashTools.sha1","title":"SHA-1 of Selection","category":"Hash Tools"},{"command":"hashTools.sha512","title":"SHA-512 of Selection","category":"Hash Tools"},{"command":"hashTools.sha384","title":"SHA-384 of Selection","category":"Hash Tools"},{"command":"hashTools.md5","title":"MD5 of Selection","category":"Hash Tools"},{"command":"hashTools.hmacSha256","title":"HMAC-SHA256 of Selection...","category":"Hash Tools"},{"command":"hashTools.all","title":"Show All Hashes","category":"Hash Tools"}]}},"files":{"icon.png":{"encoding":"base64","content":""},"extension.js":{"encoding":"utf8","content":"// Hash Tools: SHA-1, SHA-256, SHA-384, SHA-512, HMAC and a pure JavaScript MD5 for the selection.\r\n\r\nconst hex = (buf) => Array.from(new Uint8Array(buf), (b) => b.toString(16).padStart(2, '0')).join('');\r\n\r\nasync function digest(algo, text) {\r\n  const data = new TextEncoder().encode(text);\r\n  if (algo === 'MD5') return md5(data);\r\n  if (typeof crypto === 'undefined' || !crypto.subtle) throw new Error('This editor build does not provide crypto.subtle.');\r\n  return hex(await crypto.subtle.digest(algo, data));\r\n}\r\n\r\nasync function hmac(algo, key, text) {\r\n  const k = await crypto.subtle.importKey('raw', new TextEncoder().encode(key), { name: 'HMAC', hash: algo }, false, ['sign']);\r\n  return hex(await crypto.subtle.sign('HMAC', k, new TextEncoder().encode(text)));\r\n}\r\n\r\n// MD5 (RFC 1321). crypto.subtle has no MD5, and checksums of old files still use it.\r\nfunction md5(bytes) {\r\n  const K = new Uint32Array(64);\r\n  for (let i = 0; i < 64; i++) K[i] = Math.floor(Math.abs(Math.sin(i + 1)) * 4294967296) >>> 0;\r\n  const S = [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21];\r\n  const len = bytes.length;\r\n  const padded = new Uint8Array((((len + 8) >> 6) + 1) << 6);\r\n  padded.set(bytes);\r\n  padded[len] = 0x80;\r\n  const dv = new DataView(padded.buffer);\r\n  dv.setUint32(padded.length - 8, (len * 8) >>> 0, true);\r\n  dv.setUint32(padded.length - 4, Math.floor((len * 8) / 4294967296), true);\r\n  let a0 = 0x67452301, b0 = 0xefcdab89, c0 = 0x98badcfe, d0 = 0x10325476;\r\n  for (let off = 0; off < padded.length; off += 64) {\r\n    const M = new Uint32Array(16);\r\n    for (let i = 0; i < 16; i++) M[i] = dv.getUint32(off + i * 4, true);\r\n    let A = a0, B = b0, C = c0, D = d0;\r\n    for (let i = 0; i < 64; i++) {\r\n      let F, g;\r\n      if (i < 16) { F = (B & C) | (~B & D); g = i; }\r\n      else if (i < 32) { F = (D & B) | (~D & C); g = (5 * i + 1) % 16; }\r\n      else if (i < 48) { F = B ^ C ^ D; g = (3 * i + 5) % 16; }\r\n      else { F = C ^ (B | ~D); g = (7 * i) % 16; }\r\n      F = (F + A + K[i] + M[g]) >>> 0;\r\n      A = D; D = C; C = B;\r\n      B = (B + ((F << S[i]) | (F >>> (32 - S[i])))) >>> 0;\r\n    }\r\n    a0 = (a0 + A) >>> 0; b0 = (b0 + B) >>> 0; c0 = (c0 + C) >>> 0; d0 = (d0 + D) >>> 0;\r\n  }\r\n  const out = new DataView(new ArrayBuffer(16));\r\n  [a0, b0, c0, d0].forEach((v, i) => out.setUint32(i * 4, v, true));\r\n  return hex(out.buffer);\r\n}\r\n\r\nexports._test = { digest, hmac, md5 };\r\n\r\nexports.activate = function (context) {\r\n  const reg = (id, fn) => context.subscriptions.push(ferrum.commands.register(id, fn));\r\n\r\n  async function selectionOrFile() {\r\n    const doc = await ferrum.editor.active();\r\n    if (!doc) {\r\n      ferrum.window.showMessage('Open a file first.', 'warn');\r\n      return null;\r\n    }\r\n    return doc.selectedText || doc.text;\r\n  }\r\n\r\n  for (const [id, algo] of [['hashTools.md5', 'MD5'], ['hashTools.sha1', 'SHA-1'], ['hashTools.sha256', 'SHA-256'], ['hashTools.sha384', 'SHA-384'], ['hashTools.sha512', 'SHA-512']]) {\r\n    reg(id, async () => {\r\n      const text = await selectionOrFile();\r\n      if (text === null) return;\r\n      try {\r\n        const h = await digest(algo, text);\r\n        const pick = await ferrum.window.showQuickPick([{ label: 'Insert the hash', detail: h, act: 'insert' }, { label: 'Show the hash in a message', detail: h, act: 'show' }], { placeholder: algo + ' of ' + text.length + ' characters' });\r\n        if (!pick) return;\r\n        if (pick.act === 'insert') await ferrum.editor.insert(h);\r\n        else ferrum.window.showMessage(algo + ': ' + h);\r\n      } catch (e) {\r\n        ferrum.window.showMessage(e.message, 'error');\r\n      }\r\n    });\r\n  }\r\n\r\n  reg('hashTools.hmacSha256', async () => {\r\n    const text = await selectionOrFile();\r\n    if (text === null) return;\r\n    const key = await ferrum.window.showInputBox({ prompt: 'Secret key for the HMAC-SHA256' });\r\n    if (key === undefined) return;\r\n    try {\r\n      await ferrum.editor.insert(await hmac('SHA-256', key, text));\r\n    } catch (e) {\r\n      ferrum.window.showMessage(e.message, 'error');\r\n    }\r\n  });\r\n\r\n  reg('hashTools.all', async () => {\r\n    const text = await selectionOrFile();\r\n    if (text === null) return;\r\n    try {\r\n      const rows = [];\r\n      for (const a of ['MD5', 'SHA-1', 'SHA-256', 'SHA-512']) rows.push({ label: a, detail: await digest(a, text) });\r\n      await ferrum.window.showQuickPick(rows, { placeholder: 'Hashes of ' + text.length + ' characters' });\r\n    } catch (e) {\r\n      ferrum.window.showMessage(e.message, 'error');\r\n    }\r\n  });\r\n};\r\n\r\nexports.deactivate = function () {};\r\n"},"README.md":{"encoding":"utf8","content":"# Hash Tools\n\nSelect text (or use the whole file) and get its hash. Choose to insert it or show it. **Show All Hashes** lists MD5, SHA-1, SHA-256 and SHA-512 together.\n\nMD5 and SHA-1 are not safe for passwords or signatures; they are here to check files and match old checksums.\n\nNo permissions needed. Hashing happens on your computer.\n"}}}