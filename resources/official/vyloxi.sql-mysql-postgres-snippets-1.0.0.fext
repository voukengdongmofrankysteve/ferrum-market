{"format":1,"manifest":{"name":"sql-mysql-postgres-snippets","publisher":"vyloxi","version":"1.0.0","displayName":"SQL for MySQL and Postgres","description":"Tables, indexes, upserts, JSON, window functions, CTEs, users and admin queries for MySQL and PostgreSQL.","engines":{"ferrum":"^0.1.0"},"categories":["Snippets"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","contributes":{"snippets":[{"language":"SQL","path":"snippets/sql.json"},{"language":"SQL Dialects","path":"snippets/sql-dialects.json"}]}},"files":{"icon.png":{"encoding":"base64","content":""},"snippets/sql.json":{"encoding":"utf8","content":"{\n  \"Postgres: table with uuid\": {\n    \"prefix\": \"pgtable\",\n    \"body\": [\n      \"CREATE TABLE ${1:items} (\",\n      \"  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\",\n      \"  ${2:name} TEXT NOT NULL,\",\n      \"  created_at TIMESTAMPTZ NOT NULL DEFAULT now()\",\n      \");\"\n    ],\n    \"description\": \"A Postgres table\"\n  },\n  \"MySQL: table\": {\n    \"prefix\": \"mytable\",\n    \"body\": [\n      \"CREATE TABLE ${1:items} (\",\n      \"  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,\",\n      \"  ${2:name} VARCHAR(255) NOT NULL,\",\n      \"  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\",\n      \") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;\"\n    ],\n    \"description\": \"A MySQL table\"\n  },\n  \"Postgres: upsert\": {\n    \"prefix\": \"pgupsert\",\n    \"body\": [\n      \"INSERT INTO ${1:items} (${2:id}, ${3:name})\",\n      \"VALUES (${4:1}, ${5:'a'})\",\n      \"ON CONFLICT (${2:id}) DO UPDATE SET ${3:name} = EXCLUDED.${3:name};\"\n    ],\n    \"description\": \"INSERT ... ON CONFLICT\"\n  },\n  \"MySQL: upsert\": {\n    \"prefix\": \"myupsert\",\n    \"body\": [\n      \"INSERT INTO ${1:items} (${2:id}, ${3:name})\",\n      \"VALUES (${4:1}, ${5:'a'})\",\n      \"ON DUPLICATE KEY UPDATE ${3:name} = VALUES(${3:name});\"\n    ],\n    \"description\": \"INSERT ... ON DUPLICATE KEY\"\n  },\n  \"Foreign key\": {\n    \"prefix\": \"fk\",\n    \"body\": [\n      \"ALTER TABLE ${1:orders}\",\n      \"  ADD CONSTRAINT fk_${1:orders}_${2:user}\",\n      \"  FOREIGN KEY (${2:user_id}) REFERENCES ${3:users}(id) ON DELETE CASCADE;\"\n    ],\n    \"description\": \"A foreign key\"\n  },\n  \"Index\": {\n    \"prefix\": \"idx\",\n    \"body\": [\n      \"CREATE INDEX ${1:idx_name} ON ${2:table} (${3:column});\"\n    ],\n    \"description\": \"An index\"\n  },\n  \"Postgres: partial index\": {\n    \"prefix\": \"pgidx\",\n    \"body\": [\n      \"CREATE INDEX ${1:idx_name} ON ${2:table} (${3:column}) WHERE ${4:deleted_at IS NULL};\"\n    ],\n    \"description\": \"A partial index\"\n  },\n  \"Postgres: JSONB query\": {\n    \"prefix\": \"pgjson\",\n    \"body\": [\n      \"SELECT ${1:data}->>'${2:key}' AS ${2:key}\",\n      \"FROM ${3:table}\",\n      \"WHERE ${1:data} @> '{\\\"${4:status}\\\": \\\"${5:active}\\\"}';\"\n    ],\n    \"description\": \"Query a JSONB column\"\n  },\n  \"MySQL: JSON extract\": {\n    \"prefix\": \"myjson\",\n    \"body\": [\n      \"SELECT JSON_UNQUOTE(JSON_EXTRACT(${1:data}, '$.${2:key}')) AS ${2:key}\",\n      \"FROM ${3:table};\"\n    ],\n    \"description\": \"Query a JSON column\"\n  },\n  \"CTE\": {\n    \"prefix\": \"cte\",\n    \"body\": [\n      \"WITH ${1:recent} AS (\",\n      \"  SELECT * FROM ${2:table} WHERE ${3:created_at} > now() - interval '7 days'\",\n      \")\",\n      \"SELECT * FROM ${1:recent};\"\n    ],\n    \"description\": \"A common table expression\"\n  },\n  \"Recursive CTE\": {\n    \"prefix\": \"rcte\",\n    \"body\": [\n      \"WITH RECURSIVE ${1:tree} AS (\",\n      \"  SELECT id, parent_id, 1 AS depth FROM ${2:nodes} WHERE parent_id IS NULL\",\n      \"  UNION ALL\",\n      \"  SELECT n.id, n.parent_id, t.depth + 1 FROM ${2:nodes} n JOIN ${1:tree} t ON n.parent_id = t.id\",\n      \")\",\n      \"SELECT * FROM ${1:tree};\"\n    ],\n    \"description\": \"A recursive CTE\"\n  },\n  \"Window: row number\": {\n    \"prefix\": \"winrow\",\n    \"body\": [\n      \"SELECT *, ROW_NUMBER() OVER (PARTITION BY ${1:group_id} ORDER BY ${2:created_at} DESC) AS rn\",\n      \"FROM ${3:table};\"\n    ],\n    \"description\": \"ROW_NUMBER per group\"\n  },\n  \"Top N per group\": {\n    \"prefix\": \"topn\",\n    \"body\": [\n      \"SELECT * FROM (\",\n      \"  SELECT *, ROW_NUMBER() OVER (PARTITION BY ${1:group_id} ORDER BY ${2:created_at} DESC) AS rn\",\n      \"  FROM ${3:table}\",\n      \") t WHERE rn = 1;\"\n    ],\n    \"description\": \"The newest row per group\"\n  },\n  \"Pagination\": {\n    \"prefix\": \"page\",\n    \"body\": [\n      \"SELECT * FROM ${1:table} ORDER BY ${2:id} LIMIT ${3:20} OFFSET ${4:0};\"\n    ],\n    \"description\": \"LIMIT and OFFSET\"\n  },\n  \"Duplicates\": {\n    \"prefix\": \"dups\",\n    \"body\": [\n      \"SELECT ${1:email}, COUNT(*) AS n FROM ${2:users} GROUP BY ${1:email} HAVING COUNT(*) > 1;\"\n    ],\n    \"description\": \"Find duplicates\"\n  },\n  \"Postgres: explain\": {\n    \"prefix\": \"pgexplain\",\n    \"body\": [\n      \"EXPLAIN (ANALYZE, BUFFERS) ${1:SELECT 1};\"\n    ],\n    \"description\": \"EXPLAIN ANALYZE\"\n  },\n  \"MySQL: explain\": {\n    \"prefix\": \"myexplain\",\n    \"body\": [\n      \"EXPLAIN ${1:SELECT 1};\"\n    ],\n    \"description\": \"EXPLAIN\"\n  },\n  \"Postgres: create user\": {\n    \"prefix\": \"pguser\",\n    \"body\": [\n      \"CREATE ROLE ${1:app} LOGIN PASSWORD '${2:change-me}';\",\n      \"GRANT CONNECT ON DATABASE ${3:db} TO ${1:app};\",\n      \"GRANT USAGE ON SCHEMA public TO ${1:app};\",\n      \"GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO ${1:app};\"\n    ],\n    \"description\": \"A role with privileges\"\n  },\n  \"MySQL: create user\": {\n    \"prefix\": \"myuser\",\n    \"body\": [\n      \"CREATE USER '${1:app}'@'%' IDENTIFIED BY '${2:change-me}';\",\n      \"GRANT SELECT, INSERT, UPDATE, DELETE ON ${3:db}.* TO '${1:app}'@'%';\",\n      \"FLUSH PRIVILEGES;\"\n    ],\n    \"description\": \"A user with privileges\"\n  },\n  \"Table sizes (Postgres)\": {\n    \"prefix\": \"pgsize\",\n    \"body\": [\n      \"SELECT relname, pg_size_pretty(pg_total_relation_size(relid)) AS size FROM pg_catalog.pg_statio_user_tables ORDER BY pg_total_relation_size(relid) DESC LIMIT 20;\"\n    ],\n    \"description\": \"Largest tables\"\n  },\n  \"Table sizes (MySQL)\": {\n    \"prefix\": \"mysize\",\n    \"body\": [\n      \"SELECT table_name, ROUND((data_length + index_length) / 1024 / 1024, 1) AS mb FROM information_schema.tables WHERE table_schema = DATABASE() ORDER BY mb DESC LIMIT 20;\"\n    ],\n    \"description\": \"Largest tables\"\n  },\n  \"Updated at trigger (Postgres)\": {\n    \"prefix\": \"pgtrig\",\n    \"body\": [\n      \"CREATE OR REPLACE FUNCTION set_updated_at() RETURNS trigger AS $$\",\n      \"BEGIN\",\n      \"  NEW.updated_at = now();\",\n      \"  RETURN NEW;\",\n      \"END;\",\n      \"$$ LANGUAGE plpgsql;\",\n      \"\",\n      \"CREATE TRIGGER ${1:items}_updated BEFORE UPDATE ON ${1:items} FOR EACH ROW EXECUTE FUNCTION set_updated_at();\"\n    ],\n    \"description\": \"Keep updated_at fresh\"\n  }\n}\n"},"snippets/sql-dialects.json":{"encoding":"utf8","content":"{\n  \"Postgres: table with uuid\": {\n    \"prefix\": \"pgtable\",\n    \"body\": [\n      \"CREATE TABLE ${1:items} (\",\n      \"  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\",\n      \"  ${2:name} TEXT NOT NULL,\",\n      \"  created_at TIMESTAMPTZ NOT NULL DEFAULT now()\",\n      \");\"\n    ],\n    \"description\": \"A Postgres table\"\n  },\n  \"MySQL: table\": {\n    \"prefix\": \"mytable\",\n    \"body\": [\n      \"CREATE TABLE ${1:items} (\",\n      \"  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,\",\n      \"  ${2:name} VARCHAR(255) NOT NULL,\",\n      \"  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\",\n      \") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;\"\n    ],\n    \"description\": \"A MySQL table\"\n  },\n  \"Postgres: upsert\": {\n    \"prefix\": \"pgupsert\",\n    \"body\": [\n      \"INSERT INTO ${1:items} (${2:id}, ${3:name})\",\n      \"VALUES (${4:1}, ${5:'a'})\",\n      \"ON CONFLICT (${2:id}) DO UPDATE SET ${3:name} = EXCLUDED.${3:name};\"\n    ],\n    \"description\": \"INSERT ... ON CONFLICT\"\n  },\n  \"MySQL: upsert\": {\n    \"prefix\": \"myupsert\",\n    \"body\": [\n      \"INSERT INTO ${1:items} (${2:id}, ${3:name})\",\n      \"VALUES (${4:1}, ${5:'a'})\",\n      \"ON DUPLICATE KEY UPDATE ${3:name} = VALUES(${3:name});\"\n    ],\n    \"description\": \"INSERT ... ON DUPLICATE KEY\"\n  },\n  \"Foreign key\": {\n    \"prefix\": \"fk\",\n    \"body\": [\n      \"ALTER TABLE ${1:orders}\",\n      \"  ADD CONSTRAINT fk_${1:orders}_${2:user}\",\n      \"  FOREIGN KEY (${2:user_id}) REFERENCES ${3:users}(id) ON DELETE CASCADE;\"\n    ],\n    \"description\": \"A foreign key\"\n  },\n  \"Index\": {\n    \"prefix\": \"idx\",\n    \"body\": [\n      \"CREATE INDEX ${1:idx_name} ON ${2:table} (${3:column});\"\n    ],\n    \"description\": \"An index\"\n  },\n  \"Postgres: partial index\": {\n    \"prefix\": \"pgidx\",\n    \"body\": [\n      \"CREATE INDEX ${1:idx_name} ON ${2:table} (${3:column}) WHERE ${4:deleted_at IS NULL};\"\n    ],\n    \"description\": \"A partial index\"\n  },\n  \"Postgres: JSONB query\": {\n    \"prefix\": \"pgjson\",\n    \"body\": [\n      \"SELECT ${1:data}->>'${2:key}' AS ${2:key}\",\n      \"FROM ${3:table}\",\n      \"WHERE ${1:data} @> '{\\\"${4:status}\\\": \\\"${5:active}\\\"}';\"\n    ],\n    \"description\": \"Query a JSONB column\"\n  },\n  \"MySQL: JSON extract\": {\n    \"prefix\": \"myjson\",\n    \"body\": [\n      \"SELECT JSON_UNQUOTE(JSON_EXTRACT(${1:data}, '$.${2:key}')) AS ${2:key}\",\n      \"FROM ${3:table};\"\n    ],\n    \"description\": \"Query a JSON column\"\n  },\n  \"CTE\": {\n    \"prefix\": \"cte\",\n    \"body\": [\n      \"WITH ${1:recent} AS (\",\n      \"  SELECT * FROM ${2:table} WHERE ${3:created_at} > now() - interval '7 days'\",\n      \")\",\n      \"SELECT * FROM ${1:recent};\"\n    ],\n    \"description\": \"A common table expression\"\n  },\n  \"Recursive CTE\": {\n    \"prefix\": \"rcte\",\n    \"body\": [\n      \"WITH RECURSIVE ${1:tree} AS (\",\n      \"  SELECT id, parent_id, 1 AS depth FROM ${2:nodes} WHERE parent_id IS NULL\",\n      \"  UNION ALL\",\n      \"  SELECT n.id, n.parent_id, t.depth + 1 FROM ${2:nodes} n JOIN ${1:tree} t ON n.parent_id = t.id\",\n      \")\",\n      \"SELECT * FROM ${1:tree};\"\n    ],\n    \"description\": \"A recursive CTE\"\n  },\n  \"Window: row number\": {\n    \"prefix\": \"winrow\",\n    \"body\": [\n      \"SELECT *, ROW_NUMBER() OVER (PARTITION BY ${1:group_id} ORDER BY ${2:created_at} DESC) AS rn\",\n      \"FROM ${3:table};\"\n    ],\n    \"description\": \"ROW_NUMBER per group\"\n  },\n  \"Top N per group\": {\n    \"prefix\": \"topn\",\n    \"body\": [\n      \"SELECT * FROM (\",\n      \"  SELECT *, ROW_NUMBER() OVER (PARTITION BY ${1:group_id} ORDER BY ${2:created_at} DESC) AS rn\",\n      \"  FROM ${3:table}\",\n      \") t WHERE rn = 1;\"\n    ],\n    \"description\": \"The newest row per group\"\n  },\n  \"Pagination\": {\n    \"prefix\": \"page\",\n    \"body\": [\n      \"SELECT * FROM ${1:table} ORDER BY ${2:id} LIMIT ${3:20} OFFSET ${4:0};\"\n    ],\n    \"description\": \"LIMIT and OFFSET\"\n  },\n  \"Duplicates\": {\n    \"prefix\": \"dups\",\n    \"body\": [\n      \"SELECT ${1:email}, COUNT(*) AS n FROM ${2:users} GROUP BY ${1:email} HAVING COUNT(*) > 1;\"\n    ],\n    \"description\": \"Find duplicates\"\n  },\n  \"Postgres: explain\": {\n    \"prefix\": \"pgexplain\",\n    \"body\": [\n      \"EXPLAIN (ANALYZE, BUFFERS) ${1:SELECT 1};\"\n    ],\n    \"description\": \"EXPLAIN ANALYZE\"\n  },\n  \"MySQL: explain\": {\n    \"prefix\": \"myexplain\",\n    \"body\": [\n      \"EXPLAIN ${1:SELECT 1};\"\n    ],\n    \"description\": \"EXPLAIN\"\n  },\n  \"Postgres: create user\": {\n    \"prefix\": \"pguser\",\n    \"body\": [\n      \"CREATE ROLE ${1:app} LOGIN PASSWORD '${2:change-me}';\",\n      \"GRANT CONNECT ON DATABASE ${3:db} TO ${1:app};\",\n      \"GRANT USAGE ON SCHEMA public TO ${1:app};\",\n      \"GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO ${1:app};\"\n    ],\n    \"description\": \"A role with privileges\"\n  },\n  \"MySQL: create user\": {\n    \"prefix\": \"myuser\",\n    \"body\": [\n      \"CREATE USER '${1:app}'@'%' IDENTIFIED BY '${2:change-me}';\",\n      \"GRANT SELECT, INSERT, UPDATE, DELETE ON ${3:db}.* TO '${1:app}'@'%';\",\n      \"FLUSH PRIVILEGES;\"\n    ],\n    \"description\": \"A user with privileges\"\n  },\n  \"Table sizes (Postgres)\": {\n    \"prefix\": \"pgsize\",\n    \"body\": [\n      \"SELECT relname, pg_size_pretty(pg_total_relation_size(relid)) AS size FROM pg_catalog.pg_statio_user_tables ORDER BY pg_total_relation_size(relid) DESC LIMIT 20;\"\n    ],\n    \"description\": \"Largest tables\"\n  },\n  \"Table sizes (MySQL)\": {\n    \"prefix\": \"mysize\",\n    \"body\": [\n      \"SELECT table_name, ROUND((data_length + index_length) / 1024 / 1024, 1) AS mb FROM information_schema.tables WHERE table_schema = DATABASE() ORDER BY mb DESC LIMIT 20;\"\n    ],\n    \"description\": \"Largest tables\"\n  },\n  \"Updated at trigger (Postgres)\": {\n    \"prefix\": \"pgtrig\",\n    \"body\": [\n      \"CREATE OR REPLACE FUNCTION set_updated_at() RETURNS trigger AS $$\",\n      \"BEGIN\",\n      \"  NEW.updated_at = now();\",\n      \"  RETURN NEW;\",\n      \"END;\",\n      \"$$ LANGUAGE plpgsql;\",\n      \"\",\n      \"CREATE TRIGGER ${1:items}_updated BEFORE UPDATE ON ${1:items} FOR EACH ROW EXECUTE FUNCTION set_updated_at();\"\n    ],\n    \"description\": \"Keep updated_at fresh\"\n  }\n}\n"},"README.md":{"encoding":"utf8","content":"# SQL for MySQL and Postgres\n\nTables, indexes, upserts, JSON, window functions, CTEs, users and admin queries for MySQL and PostgreSQL.\n\nType a prefix and press Tab. 44 snippets.\n\n| Language | Prefix | What it inserts |\n| --- | --- | --- |\n| SQL | `pgtable` | A Postgres table |\n| SQL | `mytable` | A MySQL table |\n| SQL | `pgupsert` | INSERT ... ON CONFLICT |\n| SQL | `myupsert` | INSERT ... ON DUPLICATE KEY |\n| SQL | `fk` | A foreign key |\n| SQL | `idx` | An index |\n| SQL | `pgidx` | A partial index |\n| SQL | `pgjson` | Query a JSONB column |\n| SQL | `myjson` | Query a JSON column |\n| SQL | `cte` | A common table expression |\n| SQL | `rcte` | A recursive CTE |\n| SQL | `winrow` | ROW_NUMBER per group |\n| SQL | `topn` | The newest row per group |\n| SQL | `page` | LIMIT and OFFSET |\n| SQL | `dups` | Find duplicates |\n| SQL | `pgexplain` | EXPLAIN ANALYZE |\n| SQL | `myexplain` | EXPLAIN |\n| SQL | `pguser` | A role with privileges |\n| SQL | `myuser` | A user with privileges |\n| SQL | `pgsize` | Largest tables |\n| SQL | `mysize` | Largest tables |\n| SQL | `pgtrig` | Keep updated_at fresh |\n| SQL Dialects | `pgtable` | A Postgres table |\n| SQL Dialects | `mytable` | A MySQL table |\n| SQL Dialects | `pgupsert` | INSERT ... ON CONFLICT |\n| SQL Dialects | `myupsert` | INSERT ... ON DUPLICATE KEY |\n| SQL Dialects | `fk` | A foreign key |\n| SQL Dialects | `idx` | An index |\n| SQL Dialects | `pgidx` | A partial index |\n| SQL Dialects | `pgjson` | Query a JSONB column |\n| SQL Dialects | `myjson` | Query a JSON column |\n| SQL Dialects | `cte` | A common table expression |\n| SQL Dialects | `rcte` | A recursive CTE |\n| SQL Dialects | `winrow` | ROW_NUMBER per group |\n| SQL Dialects | `topn` | The newest row per group |\n| SQL Dialects | `page` | LIMIT and OFFSET |\n| SQL Dialects | `dups` | Find duplicates |\n| SQL Dialects | `pgexplain` | EXPLAIN ANALYZE |\n| SQL Dialects | `myexplain` | EXPLAIN |\n| SQL Dialects | `pguser` | A role with privileges |\n| SQL Dialects | `myuser` | A user with privileges |\n| SQL Dialects | `pgsize` | Largest tables |\n| SQL Dialects | `mysize` | Largest tables |\n| SQL Dialects | `pgtrig` | Keep updated_at fresh |\n\nThis extension runs no code and asks for no permissions.\n"}}}