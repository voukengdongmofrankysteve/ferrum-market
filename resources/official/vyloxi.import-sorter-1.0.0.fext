{"format":1,"manifest":{"name":"import-sorter","publisher":"vyloxi","version":"1.0.0","displayName":"Import Sorter","description":"Group and sort imports in JavaScript, TypeScript and Python files, and remove the ones that are never used. Optionally on every save.","engines":{"ferrum":"^0.1.0"},"categories":["Tools"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","main":"extension.js","activationEvents":["onStartup"],"permissions":[],"contributes":{"commands":[{"command":"importSorter.sort","title":"Sort Imports","category":"Import Sorter"},{"command":"importSorter.sortAndRemoveUnused","title":"Sort Imports and Remove Unused","category":"Import Sorter"}],"keybindings":[{"command":"importSorter.sort","key":"Ctrl+Alt+O"}],"configuration":{"title":"Import Sorter","properties":{"importSorter.sortOnSave":{"type":"boolean","default":false,"description":"Sort imports every time you save a JavaScript, TypeScript or Python file."},"importSorter.blankLineBetweenGroups":{"type":"boolean","default":true,"description":"Put a blank line between groups of imports."}}}}},"files":{"icon.png":{"encoding":"base64","content":""},"extension.js":{"encoding":"utf8","content":"// Import Sorter: group and sort the imports of a JavaScript/TypeScript or Python file, and remove the ones that are never used.\n\nconst NODE_BUILTINS = new Set(['fs', 'path', 'os', 'url', 'http', 'https', 'crypto', 'stream', 'util', 'events', 'child_process', 'assert', 'buffer', 'zlib', 'net', 'tls', 'dns', 'readline', 'worker_threads', 'process', 'timers', 'querystring', 'module', 'v8', 'vm', 'perf_hooks']);\n\n// ---- JavaScript / TypeScript ------------------------------------------------------------------------------------\nfunction jsGroup(src) {\n  if (src.startsWith('node:') || NODE_BUILTINS.has(src.split('/')[0])) return 0;\n  if (src.startsWith('.')) return src.startsWith('../') || src === '..' ? 3 : 4;\n  if (/^[@~#]\\//.test(src) || src.startsWith('src/')) return 2;\n  return 1;\n}\n\n/** Finds the leading block of import lines (single statements, possibly over several lines). */\nfunction jsBlock(text) {\n  const lines = text.split('\\n');\n  let i = 0;\n  while (i < lines.length && (/^\\s*(\\/\\/|\\/\\*|\\*|#!|['\"]use )/.test(lines[i]) || lines[i].trim() === '')) i++;\n  const start = i;\n  const imports = [];\n  let end = start;\n  while (i < lines.length) {\n    const l = lines[i];\n    if (l.trim() === '' || /^\\s*\\/\\//.test(l)) {\n      i++;\n      continue;\n    }\n    if (!/^import[\\s{*'\"]/.test(l)) break;\n    let stmt = l;\n    let j = i;\n    while (!/(from\\s+['\"][^'\"]+['\"]|^import\\s+['\"][^'\"]+['\"])\\s*;?\\s*(\\/\\/.*)?$/.test(stmt.trim()) && j + 1 < lines.length) stmt += '\\n' + lines[++j];\n    imports.push({ text: stmt, line: i });\n    i = j + 1;\n    end = i;\n  }\n  return { start, end, imports, lines };\n}\n\nfunction parseJsImport(stmt) {\n  const m = /^import\\s+(type\\s+)?(?:([\\w$]+)\\s*,?\\s*)?(?:\\*\\s+as\\s+([\\w$]+))?\\s*(?:\\{([^}]*)\\})?\\s*from\\s*['\"]([^'\"]+)['\"]/.exec(stmt.replace(/\\n/g, ' '));\n  if (!m) {\n    const side = /^import\\s+['\"]([^'\"]+)['\"]/.exec(stmt);\n    return side ? { source: side[1], side: true, names: [] } : null;\n  }\n  const named = (m[4] || '').split(',').map((s) => s.trim()).filter(Boolean);\n  return { type: !!m[1], def: m[2], ns: m[3], named, source: m[5] };\n}\n\nfunction formatJs(p, unused) {\n  const keep = (n) => !unused.has((/\\bas\\s+([\\w$]+)$/.exec(n) || [, n.replace(/^type\\s+/, '')])[1]);\n  const named = [...p.named.filter(keep)].sort((a, b) => a.replace(/^type\\s+/, '').toLowerCase().localeCompare(b.replace(/^type\\s+/, '').toLowerCase()));\n  const def = p.def && !unused.has(p.def) ? p.def : '';\n  const ns = p.ns && !unused.has(p.ns) ? p.ns : '';\n  if (!def && !ns && !named.length) return null;\n  const parts = [];\n  if (def) parts.push(def);\n  if (ns) parts.push('* as ' + ns);\n  if (named.length) parts.push('{ ' + named.join(', ') + ' }');\n  return 'import ' + (p.type ? 'type ' : '') + parts.join(', ') + \" from '\" + p.source + \"';\";\n}\n\nfunction sortJs(text, opts = {}) {\n  const b = jsBlock(text);\n  if (!b.imports.length) return text;\n  const body = b.lines.slice(b.end).join('\\n');\n  const used = (name) => new RegExp('(^|[^\\\\w$.])' + name.replace(/\\$/g, '\\\\$') + '($|[^\\\\w$])').test(body);\n  const entries = [];\n  const unused = new Set();\n  for (const im of b.imports) {\n    const p = parseJsImport(im.text);\n    if (!p) return text;\n    if (opts.removeUnused && !p.side) {\n      for (const n of [p.def, p.ns, ...p.named.map((x) => (/\\bas\\s+([\\w$]+)$/.exec(x) || [, x.replace(/^type\\s+/, '')])[1])].filter(Boolean)) if (!used(n)) unused.add(n);\n    }\n    const line = p.side ? \"import '\" + p.source + \"';\" : formatJs(p, unused);\n    if (line) entries.push({ line, group: jsGroup(p.source), source: p.source, side: !!p.side });\n  }\n  entries.sort((a, b) => a.group - b.group || (a.side !== b.side ? (a.side ? 1 : -1) : 0) || a.source.toLowerCase().localeCompare(b.source.toLowerCase()));\n  const out = [];\n  let g = -1;\n  for (const e of entries) {\n    if (g !== -1 && e.group !== g && opts.blankBetweenGroups !== false) out.push('');\n    out.push(e.line);\n    g = e.group;\n  }\n  const head = b.lines.slice(0, b.start);\n  const rest = b.lines.slice(b.end);\n  return [...head, ...out, ...(rest.length && rest[0].trim() !== '' ? [''] : []), ...rest].join('\\n');\n}\n\n// ---- Python ---------------------------------------------------------------------------------------------------------\nconst PY_STDLIB = new Set(['os', 'sys', 're', 'json', 'math', 'time', 'datetime', 'typing', 'collections', 'itertools', 'functools', 'pathlib', 'subprocess', 'logging', 'argparse', 'dataclasses', 'random', 'string', 'io', 'csv', 'hashlib', 'uuid', 'asyncio', 'threading', 'unittest', 'urllib', 'http', 'socket', 'shutil', 'tempfile', 'copy', 'enum', 'abc', 'contextlib', 'base64', 'sqlite3', 'decimal', 'statistics', 'textwrap', 'traceback', 'warnings', 'pickle', 'glob', 'heapq', 'bisect', 'operator', 'secrets', 'struct', 'zlib']);\n\nfunction pyGroup(mod) {\n  if (mod.startsWith('.')) return 2;\n  return PY_STDLIB.has(mod.split('.')[0]) ? 0 : 1;\n}\n\nfunction sortPy(text, opts = {}) {\n  const lines = text.split('\\n');\n  let i = 0;\n  while (i < lines.length && (/^\\s*(#|\"\"\")/.test(lines[i]) || lines[i].trim() === '')) {\n    if (/^\\s*\"\"\"/.test(lines[i]) && !/\"\"\"\\s*$/.test(lines[i].trim().slice(3)) ) {\n      i++;\n      while (i < lines.length && !lines[i].includes('\"\"\"')) i++;\n    }\n    i++;\n  }\n  const start = i;\n  const entries = [];\n  let end = start;\n  while (i < lines.length) {\n    const l = lines[i];\n    if (l.trim() === '') {\n      i++;\n      continue;\n    }\n    const imp = /^import\\s+([\\w.]+)(?:\\s+as\\s+(\\w+))?\\s*$/.exec(l);\n    const from = /^from\\s+([\\w.]+)\\s+import\\s+(.+)$/.exec(l);\n    if (!imp && !from) break;\n    let line = l;\n    if (from && from[2].trim().startsWith('(')) {\n      let j = i;\n      let acc = l;\n      while (!acc.includes(')') && j + 1 < lines.length) acc += ' ' + lines[++j].trim();\n      i = j;\n      line = acc.replace(/\\(\\s*/, '').replace(/\\s*\\)/, '').replace(/,\\s*$/, '');\n    }\n    const mod = imp ? imp[1] : from[1];\n    entries.push({ line, mod, imp: !!imp, from, as: imp && imp[2] });\n    i++;\n    end = i;\n  }\n  if (!entries.length) return text;\n  const body = lines.slice(end).join('\\n');\n  const used = (n) => new RegExp('(^|[^\\\\w.])' + n + '($|[^\\\\w])').test(body);\n  const out = [];\n  for (const e of entries) {\n    if (e.imp) {\n      const name = e.as || e.mod.split('.')[0];\n      if (opts.removeUnused && !used(name)) continue;\n      out.push({ group: pyGroup(e.mod), key: e.mod.toLowerCase(), line: e.line.trim(), style: 0 });\n    } else {\n      const names = e.from[2].split(',').map((s) => s.trim()).filter(Boolean);\n      const kept = opts.removeUnused ? names.filter((n) => n === '*' || used((/\\bas\\s+(\\w+)$/.exec(n) || [, n])[1])) : names;\n      if (!kept.length) continue;\n      kept.sort((a, b) => a.toLowerCase().localeCompare(b.toLowerCase()));\n      out.push({ group: pyGroup(e.mod), key: e.mod.toLowerCase(), line: 'from ' + e.mod + ' import ' + kept.join(', '), style: 1 });\n    }\n  }\n  out.sort((a, b) => a.group - b.group || a.style - b.style || a.key.localeCompare(b.key));\n  const result = [];\n  let g = -1;\n  for (const o of out) {\n    if (g !== -1 && o.group !== g) result.push('');\n    result.push(o.line);\n    g = o.group;\n  }\n  const rest = lines.slice(end);\n  return [...lines.slice(0, start), ...result, ...(rest.length && rest[0].trim() !== '' ? ['', ''] : []), ...rest].join('\\n');\n}\n\nexports._test = { sortJs, sortPy, jsGroup, parseJsImport, jsBlock };\n\nexports.activate = function (context) {\n  async function run(removeUnused) {\n    const doc = await ferrum.editor.active();\n    if (!doc) return ferrum.window.showMessage('Open a file first.', 'warn');\n    const lang = String(doc.language || '').toLowerCase();\n    const name = doc.name || '';\n    let out;\n    const opts = { removeUnused, blankBetweenGroups: ferrum.settings.get('importSorter.blankLineBetweenGroups') !== false };\n    if (/javascript|typescript/.test(lang) || /\\.(jsx?|tsx?|mjs|cjs)$/.test(name)) out = sortJs(doc.text, opts);\n    else if (/python/.test(lang) || /\\.py$/.test(name)) out = sortPy(doc.text, opts);\n    else return ferrum.window.showMessage('Import Sorter works on JavaScript, TypeScript and Python files.', 'warn');\n    if (out === doc.text) return ferrum.window.showMessage('Imports are already in order.');\n    await ferrum.editor.replace({ start: { line: 0, col: 0 }, end: { line: doc.lineCount, col: 0 } }, out);\n    ferrum.window.showMessage(removeUnused ? 'Imports sorted, unused ones removed.' : 'Imports sorted.');\n  }\n  context.subscriptions.push(\n    ferrum.commands.register('importSorter.sort', () => run(false)),\n    ferrum.commands.register('importSorter.sortAndRemoveUnused', () => run(true)),\n  );\n  context.subscriptions.push(\n    ferrum.events.on('save', async () => {\n      if (ferrum.settings.get('importSorter.sortOnSave') === true) await run(false);\n    }),\n  );\n};\n\nexports.deactivate = function () {};\n"},"README.md":{"encoding":"utf8","content":"# Import Sorter\n\n**JavaScript and TypeScript** groups: Node built-ins, packages, aliases (`@/`, `~/`), parent folders (`../`), then sibling files (`./`). Inside a group they are sorted by path, and the names inside `{ }` are sorted too. Side effect imports (`import './style.css'`) go last in their group.\n\n**Python** groups: the standard library, third party packages, then local (`from . import`).\n\n**Sort Imports and Remove Unused** also deletes names that do not appear in the rest of the file. It is a text check, not a full analysis, so look at the result before you save.\n\nTurn on **Sort on save** in settings to do it automatically. Ctrl+Alt+O sorts the open file. No permissions needed.\n"}}}