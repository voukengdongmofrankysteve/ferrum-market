{"format":1,"manifest":{"name":"daily-journal","publisher":"vyloxi","version":"1.0.0","displayName":"Daily Journal","description":"One Markdown page per day in a journal folder: open today, add a timestamped line from anywhere, browse older days.","engines":{"ferrum":"^0.1.0"},"categories":["Productivity"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","main":"extension.js","activationEvents":["onCommand:dailyJournal.today","onCommand:dailyJournal.yesterday","onCommand:dailyJournal.tomorrow","onCommand:dailyJournal.openDate","onCommand:dailyJournal.quickEntry","onCommand:dailyJournal.addSelection","onCommand:dailyJournal.browse"],"permissions":["workspace.read","workspace.write"],"contributes":{"commands":[{"command":"dailyJournal.today","title":"Open Today","category":"Daily Journal"},{"command":"dailyJournal.yesterday","title":"Open Yesterday","category":"Daily Journal"},{"command":"dailyJournal.tomorrow","title":"Open Tomorrow","category":"Daily Journal"},{"command":"dailyJournal.openDate","title":"Open a Date...","category":"Daily Journal"},{"command":"dailyJournal.quickEntry","title":"Add a Line to Today...","category":"Daily Journal"},{"command":"dailyJournal.addSelection","title":"Add Selection to Today","category":"Daily Journal"},{"command":"dailyJournal.browse","title":"Browse Days...","category":"Daily Journal"}],"keybindings":[{"command":"dailyJournal.today","key":"Ctrl+Alt+J"},{"command":"dailyJournal.quickEntry","key":"Ctrl+Alt+L"}],"configuration":{"title":"Daily Journal","properties":{"dailyJournal.folder":{"type":"string","default":"journal","description":"The folder inside your project where the daily pages go."},"dailyJournal.template":{"type":"string","default":"# {{weekday}}, {{date}}\\n\\n## Plan\\n\\n- [ ] \\n\\n## Notes\\n\\n## Done\\n\\n","description":"The text of a new page. Use \\n for new lines and {{date}}, {{weekday}}, {{month}}, {{year}}, {{time}}."}}}}},"files":{"icon.png":{"encoding":"base64","content":""},"extension.js":{"encoding":"utf8","content":"// Daily Journal: one Markdown file per day in a journal folder of your project (or a notes folder). Open today's page,\n// add a timestamped line from anywhere, and browse older days.\n\nconst DEFAULT_TEMPLATE = '# {{weekday}}, {{date}}\\n\\n## Plan\\n\\n- [ ] \\n\\n## Notes\\n\\n## Done\\n\\n';\n\nconst pad = (n) => String(n).padStart(2, '0');\nconst dateStr = (d) => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());\nconst WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];\nconst MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];\n\n/** Parses 2026-10-22 as a local date. Returns null for anything else. */\nfunction parseDate(s) {\n  const m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(String(s).trim());\n  if (!m) return null;\n  const d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));\n  return d.getFullYear() === Number(m[1]) && d.getMonth() === Number(m[2]) - 1 && d.getDate() === Number(m[3]) ? d : null;\n}\n\nfunction addDays(d, n) {\n  const x = new Date(d.getFullYear(), d.getMonth(), d.getDate() + n);\n  return x;\n}\n\nfunction render(template, d) {\n  return String(template || DEFAULT_TEMPLATE)\n    .replace(/\\\\n/g, '\\n')\n    .replace(/\\{\\{date\\}\\}/g, dateStr(d))\n    .replace(/\\{\\{weekday\\}\\}/g, WEEKDAYS[d.getDay()])\n    .replace(/\\{\\{month\\}\\}/g, MONTHS[d.getMonth()])\n    .replace(/\\{\\{year\\}\\}/g, String(d.getFullYear()))\n    .replace(/\\{\\{time\\}\\}/g, pad(d.getHours()) + ':' + pad(d.getMinutes()));\n}\n\n/** Adds \"- 14:05 text\" under the Notes heading when there is one, otherwise at the end. */\nfunction appendEntry(text, line, now) {\n  const entry = '- ' + pad(now.getHours()) + ':' + pad(now.getMinutes()) + ' ' + line.trim();\n  const lines = text.replace(/\\r\\n/g, '\\n').split('\\n');\n  const h = lines.findIndex((l) => /^##\\s+notes\\b/i.test(l));\n  if (h < 0) return text.replace(/\\n*$/, '\\n') + entry + '\\n';\n  let end = lines.findIndex((l, i) => i > h && /^#{1,2}\\s/.test(l));\n  if (end < 0) end = lines.length;\n  let at = end;\n  while (at > h + 1 && lines[at - 1].trim() === '') at--;\n  lines.splice(at, 0, ...(at === h + 1 ? [''] : []), entry);\n  return lines.join('\\n');\n}\n\n/** A folder inside the project: empty, dot and dot-dot parts are dropped, so the setting can never point outside it. */\nconst folderName = (s) => String(s || 'journal').replace(/\\\\/g, '/').split('/').filter((p) => p && p !== '.' && p !== '..').join('/') || 'journal';\n\nexports._test = { dateStr, parseDate, addDays, render, appendEntry, folderName, DEFAULT_TEMPLATE };\n\nexports.activate = function (context) {\n  const reg = (id, fn) => context.subscriptions.push(ferrum.commands.register(id, fn));\n  const dir = () => folderName(ferrum.settings.get('dailyJournal.folder'));\n  const pathFor = (d) => dir() + '/' + dateStr(d) + '.md';\n\n  async function exists(path) {\n    try { await ferrum.workspace.readFile(path); return true; } catch { return false; }\n  }\n\n  async function openDay(d, create = true) {\n    if (!ferrum.workspace.root) return ferrum.window.showMessage('Open a folder first; the journal is kept inside it.', 'warn');\n    const path = pathFor(d);\n    if (!(await exists(path))) {\n      if (!create) return ferrum.window.showMessage('There is no page for ' + dateStr(d) + '.', 'warn');\n      await ferrum.workspace.writeFile(path, render(ferrum.settings.get('dailyJournal.template'), d));\n    }\n    await ferrum.editor.openFile(path);\n  }\n\n  reg('dailyJournal.today', () => openDay(new Date()));\n  reg('dailyJournal.yesterday', () => openDay(addDays(new Date(), -1), false));\n  reg('dailyJournal.tomorrow', () => openDay(addDays(new Date(), 1)));\n  reg('dailyJournal.openDate', async () => {\n    const s = await ferrum.window.showInputBox({ prompt: 'Which day? (YYYY-MM-DD)', value: dateStr(new Date()) });\n    if (!s) return;\n    const d = parseDate(s);\n    if (!d) return ferrum.window.showMessage('Write the date like 2026-10-22.', 'warn');\n    await openDay(d);\n  });\n\n  reg('dailyJournal.quickEntry', async () => {\n    if (!ferrum.workspace.root) return ferrum.window.showMessage('Open a folder first.', 'warn');\n    const line = await ferrum.window.showInputBox({ prompt: 'Add to today\\'s journal', placeholder: 'Fixed the login bug, call with Ada at 3...' });\n    if (!line || !line.trim()) return;\n    const now = new Date();\n    const path = pathFor(now);\n    let text;\n    try { text = await ferrum.workspace.readFile(path); } catch { text = render(ferrum.settings.get('dailyJournal.template'), now); }\n    await ferrum.workspace.writeFile(path, appendEntry(text, line, now));\n    ferrum.window.showMessage('Added to ' + dateStr(now) + '.');\n  });\n\n  reg('dailyJournal.addSelection', async () => {\n    if (!ferrum.workspace.root) return ferrum.window.showMessage('Open a folder first.', 'warn');\n    const doc = await ferrum.editor.active();\n    if (!doc || !doc.selectedText) return ferrum.window.showMessage('Select some text first.', 'warn');\n    const now = new Date();\n    const path = pathFor(now);\n    let text;\n    try { text = await ferrum.workspace.readFile(path); } catch { text = render(ferrum.settings.get('dailyJournal.template'), now); }\n    const where = doc.name + ':' + (doc.selection.start.line + 1);\n    await ferrum.workspace.writeFile(path, appendEntry(text, doc.selectedText.replace(/\\s+/g, ' ').trim().slice(0, 300) + ' (' + where + ')', now));\n    ferrum.window.showMessage('Added to ' + dateStr(now) + '.');\n  });\n\n  reg('dailyJournal.browse', async () => {\n    if (!ferrum.workspace.root) return ferrum.window.showMessage('Open a folder first.', 'warn');\n    let files = [];\n    try { files = await ferrum.workspace.listFiles(dir() + '/**'); } catch { files = []; }\n    const days = files.filter((f) => /\\d{4}-\\d{2}-\\d{2}\\.md$/.test(f)).sort().reverse();\n    if (!days.length) return ferrum.window.showMessage('The journal is empty. Run \"Journal: Open Today\".');\n    const pick = await ferrum.window.showQuickPick(days.slice(0, 200).map((f) => {\n      const d = parseDate(f.slice(-13, -3));\n      return { label: f.slice(-13, -3), detail: d ? WEEKDAYS[d.getDay()] : '', path: f };\n    }), { placeholder: days.length + ' days. Pick one to open.' });\n    if (pick) await ferrum.editor.openFile(pick.path);\n  });\n};\n\nexports.deactivate = function () {};\n"},"README.md":{"encoding":"utf8","content":"# Daily Journal\n\nA page per day, as plain Markdown files in a folder of your project (`journal/2026-10-22.md` by default).\n\n- **Open Today** creates today's page from your template if it does not exist, and opens it. **Open Yesterday**, **Open Tomorrow** and **Open a Date...** do the same for other days (Yesterday does not create a page that was never written).\n- **Add a Line to Today...** appends `- 14:05 your text` under the *Notes* heading without opening the file. **Add Selection to Today** does it with the selected text and where it came from.\n- **Browse Days...** lists the pages you have, newest first.\n\nChange the folder and the template in the settings. Because they are ordinary files, you can search them, commit them or put the folder outside version control with a `.gitignore` line.\n\n## Permissions\n\n**workspace.read** and **workspace.write**, inside the folder you opened.\n"}}}