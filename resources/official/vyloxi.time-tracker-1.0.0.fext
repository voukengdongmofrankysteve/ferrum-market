{"format":1,"manifest":{"name":"time-tracker","publisher":"vyloxi","version":"1.0.0","displayName":"Time Tracker","description":"Counts the time you actively work in each project (it pauses when you stop typing), shows today in the status bar and gives a weekly report.","engines":{"ferrum":"^0.1.0"},"categories":["Tools"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","main":"extension.js","activationEvents":["onStartup"],"permissions":[],"contributes":{"commands":[{"command":"timeTracker.report","title":"Show Weekly Time Report","category":"Time Tracker"},{"command":"timeTracker.today","title":"Show Time Worked Today","category":"Time Tracker"},{"command":"timeTracker.exportCsv","title":"Insert Last 30 Days as CSV","category":"Time Tracker"},{"command":"timeTracker.reset","title":"Erase All Tracked Time...","category":"Time Tracker"}],"configuration":{"title":"Time Tracker","properties":{"timeTracker.idleSeconds":{"type":"number","default":120,"description":"Stop counting after this many seconds without typing or moving the cursor (30 to 900)."},"timeTracker.showInStatusBar":{"type":"boolean","default":true,"description":"Show today's total in the status bar."}}}}},"files":{"icon.png":{"encoding":"base64","content":""},"extension.js":{"encoding":"utf8","content":"// Time Tracker: counts the time you actively work in each project (it pauses when you stop typing) and shows today in the status bar,\n// with a weekly report. The data stays in this extension's private storage on this computer.\n\nconst day = (d = new Date()) => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');\n\nfunction fmt(sec) {\n  const s = Math.max(0, Math.round(sec));\n  const h = Math.floor(s / 3600);\n  const m = Math.floor((s % 3600) / 60);\n  return h ? h + 'h ' + String(m).padStart(2, '0') + 'm' : m ? m + 'm' : s + 's';\n}\n\n/** Adds `sec` seconds to a project on a day. The store is { \"YYYY-MM-DD\": { project: seconds } }. */\nfunction add(store, date, project, sec) {\n  const next = { ...store, [date]: { ...(store[date] || {}) } };\n  next[date][project] = (next[date][project] || 0) + sec;\n  return next;\n}\n\nfunction lastDays(n, from = new Date()) {\n  const out = [];\n  for (let i = 0; i < n; i++) {\n    const d = new Date(from.getFullYear(), from.getMonth(), from.getDate() - i);\n    out.push(day(d));\n  }\n  return out;\n}\n\nfunction report(store, days) {\n  const perProject = {};\n  const perDay = days.map((d) => ({ day: d, sec: Object.values(store[d] || {}).reduce((a, b) => a + b, 0) }));\n  for (const d of days) for (const [p, s] of Object.entries(store[d] || {})) perProject[p] = (perProject[p] || 0) + s;\n  const total = perDay.reduce((a, b) => a + b.sec, 0);\n  return { perDay, projects: Object.entries(perProject).sort((a, b) => b[1] - a[1]), total };\n}\n\n/** Drops days older than `keep`. */\nfunction prune(store, keep, from = new Date()) {\n  const ok = new Set(lastDays(keep, from));\n  return Object.fromEntries(Object.entries(store).filter(([d]) => ok.has(d)));\n}\n\nfunction csv(store, days) {\n  const rows = ['date,project,seconds,time'];\n  for (const d of [...days].reverse()) for (const [p, s] of Object.entries(store[d] || {})) rows.push(d + ',\"' + p.replace(/\"/g, '\"\"') + '\",' + s + ',' + fmt(s));\n  return rows.join('\\n') + '\\n';\n}\n\nexports._test = { fmt, add, lastDays, report, prune, csv, day };\n\nexports.activate = function (context) {\n  const project = () => {\n    const r = ferrum.workspace.root;\n    return r ? r.split(/[\\\\/]/).filter(Boolean).pop() : 'No folder';\n  };\n  let store = {};\n  let lastActive = 0;\n  let timer = null;\n  let dirty = false;\n  const idleMs = () => Math.max(30, Math.min(900, Number(ferrum.settings.get('timeTracker.idleSeconds')) || 120)) * 1000;\n\n  async function init() {\n    store = (await ferrum.storage.get('days', {})) || {};\n    paint();\n  }\n  const todaySec = () => Object.values(store[day()] || {}).reduce((a, b) => a + b, 0);\n  function paint() {\n    if (ferrum.settings.get('timeTracker.showInStatusBar') === false) return ferrum.window.setStatusBar('timeTracker.status', { text: '' });\n    const active = Date.now() - lastActive < idleMs();\n    ferrum.window.setStatusBar('timeTracker.status', { text: (active ? 'Working ' : 'Today ') + fmt(todaySec()), tooltip: 'Time worked today in ' + project() + ': ' + fmt((store[day()] || {})[project()] || 0) + '. Click for the report.', command: 'timeTracker.report' });\n  }\n  const touch = () => {\n    lastActive = Date.now();\n  };\n  async function tick() {\n    if (Date.now() - lastActive < idleMs()) {\n      store = add(store, day(), project(), 5);\n      dirty = true;\n    }\n    paint();\n    if (dirty && Date.now() % 30000 < 5000) {\n      dirty = false;\n      await ferrum.storage.set('days', prune(store, 120));\n    }\n  }\n\n  context.subscriptions.push(\n    ferrum.events.on('change', touch),\n    ferrum.events.on('selectionChanged', touch),\n    ferrum.events.on('save', touch),\n    ferrum.events.on('activeChanged', touch),\n    { dispose: () => { clearInterval(timer); if (dirty) ferrum.storage.set('days', prune(store, 120)); } },\n    ferrum.commands.register('timeTracker.report', async () => {\n      const r = report(store, lastDays(7));\n      const max = Math.max(1, ...r.perDay.map((d) => d.sec));\n      const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');\n      await ferrum.window.showPanel({\n        title: 'Time report',\n        html: '<style>body{font-family:var(--ui)} table{border-collapse:collapse;font:13px var(--mono,monospace)} td{padding:4px 12px 4px 0;border-bottom:1px solid var(--border)} .bar{height:10px;background:var(--accent);border-radius:5px}</style><h3>Last 7 days: ' + fmt(r.total) + '</h3><table>' + r.perDay.map((d) => '<tr><td>' + d.day + '</td><td>' + fmt(d.sec) + '</td><td><div class=\"bar\" style=\"width:' + Math.round((d.sec / max) * 200) + 'px\"></div></td></tr>').join('') + '</table><h4>By project</h4><table>' + (r.projects.map(([p, s]) => '<tr><td>' + esc(p) + '</td><td>' + fmt(s) + '</td></tr>').join('') || '<tr><td>Nothing tracked yet</td></tr>') + '</table>',\n      });\n    }),\n    ferrum.commands.register('timeTracker.today', async () => {\n      ferrum.window.showMessage('Today: ' + fmt(todaySec()) + ' in total, ' + fmt((store[day()] || {})[project()] || 0) + ' in ' + project() + '.');\n    }),\n    ferrum.commands.register('timeTracker.exportCsv', async () => {\n      await ferrum.editor.insert(csv(store, lastDays(30)));\n    }),\n    ferrum.commands.register('timeTracker.reset', async () => {\n      if (!(await ferrum.window.confirm('Erase all tracked time on this computer?', 'Erase'))) return;\n      store = {};\n      await ferrum.storage.set('days', {});\n      paint();\n    }),\n  );\n  timer = setInterval(tick, 5000);\n  init();\n};\n\nexports.deactivate = function () {};\n"},"README.md":{"encoding":"utf8","content":"# Time Tracker\n\nThe status bar shows **Working 1h 12m** while you type and **Today 1h 12m** when you pause. Time is counted per project (the folder name) only while you are active: typing, saving, moving the cursor or switching files. After the idle time (2 minutes by default) it stops.\n\n- **Show Weekly Time Report** shows each of the last 7 days with a bar, and the total per project.\n- **Insert Last 30 Days as CSV** writes a table you can paste in a spreadsheet or an invoice.\n- Data stays in this extension's private storage on this computer, keeps 120 days, and **Erase All Tracked Time...** removes it.\n\nNo permissions needed. It sends nothing anywhere.\n"}}}