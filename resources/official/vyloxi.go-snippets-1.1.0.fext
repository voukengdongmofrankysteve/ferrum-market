,\n  \"For range\": {\n    \"prefix\": \"fr\",\n    \"body\": [\n      \"for ${1:i}, ${2:v} := range ${3:items} {\",\n      \"\\t$0\",\n      \"}\"\n    ],\n    \"description\": \"for range\"\n  },\n  \"Goroutine\": {\n    \"prefix\": \"go\",\n    \"body\": [\n      \"go func() {\",\n      \"\\t$0\",\n      \"}()\"\n    ],\n    \"description\": \"A goroutine\"\n  },\n  \"Channel\": {\n    \"prefix\": \"ch\",\n    \"body\": [\n      \"${1:ch} := make(chan ${2:int}, ${3:0})\"\n    ],\n    \"description\": \"Make a channel\"\n  },\n  \"Select\": {\n    \"prefix\": \"sel\",\n    \"body\": [\n      \"select {\",\n      \"case ${1:v} := <-${2:ch}:\",\n      \"\\t$0\",\n      \"case <-ctx.Done():\",\n      \"\\treturn ctx.Err()\",\n      \"}\"\n    ],\n    \"description\": \"A select\"\n  },\n  \"Test\": {\n    \"prefix\": \"test\",\n    \"body\": [\n      \"func Test${1:Name}(t *testing.T) {\",\n      \"\\t$0\",\n      \"}\"\n    ],\n    \"description\": \"A test\"\n  },\n  \"Table test\": {\n    \"prefix\": \"tt\",\n    \"body\": [\n      \"func Test${1:Name}(t *testing.T) {\",\n      \"\\ttests := []struct {\",\n      \"\\t\\tname string\",\n      \"\\t\\t${2:in}   ${3:string}\",\n      \"\\t\\twant ${4:string}\",\n      \"\\t}{\",\n      \"\\t\\t{\\\"${5:case}\\\", \\\"\\\", \\\"\\\"},\",\n      \"\\t}\",\n      \"\\tfor _, tt := range tests {\",\n      \"\\t\\tt.Run(tt.name, func(t *testing.T) {\",\n      \"\\t\\t\\t$0\",\n      \"\\t\\t})\",\n      \"\\t}\",\n      \"}\"\n    ],\n    \"description\": \"A table driven test\"\n  },\n  \"HTTP handler\": {\n    \"prefix\": \"hh\",\n    \"body\": [\n      \"func ${1:handler}(w http.ResponseWriter, r *http.Request) {\",\n      \"\\t$0\",\n      \"}\"\n    ],\n    \"description\": \"An HTTP handler\"\n  },\n  \"Defer\": {\n    \"prefix\": \"df\",\n    \"body\": [\n      \"defer ${1:f.Close()}\"\n    ],\n    \"description\": \"defer\"\n  }\n}\n"},"README.md":{"encoding":"utf8","content":"# Go Snippets\n\nFunctions, structs, 