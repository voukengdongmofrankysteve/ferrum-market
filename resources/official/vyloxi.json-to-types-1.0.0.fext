{"format":1,"manifest":{"name":"json-to-types","publisher":"vyloxi","version":"1.0.0","displayName":"JSON to Types","description":"Turn a JSON sample into TypeScript interfaces, Python dataclasses, Go structs, Rust serde structs, Kotlin data classes or C# classes.","engines":{"ferrum":"^0.1.0"},"categories":["Tools"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","main":"extension.js","activationEvents":["onCommand:jsonToTypes.generate","onCommand:jsonToTypes.typescript","onCommand:jsonToTypes.python","onCommand:jsonToTypes.go","onCommand:jsonToTypes.rust"],"permissions":[],"contributes":{"commands":[{"command":"jsonToTypes.generate","title":"Generate Types from JSON...","category":"JSON to Types"},{"command":"jsonToTypes.typescript","title":"JSON to TypeScript Interfaces","category":"JSON to Types"},{"command":"jsonToTypes.python","title":"JSON to Python Dataclasses","category":"JSON to Types"},{"command":"jsonToTypes.go","title":"JSON to Go Structs","category":"JSON to Types"},{"command":"jsonToTypes.rust","title":"JSON to Rust Structs","category":"JSON to Types"}]}},"files":{"icon.png":{"encoding":"base64","content":""},"extension.js":{"encoding":"utf8","content":"// JSON to Types: turn a JSON sample into TypeScript interfaces, Python dataclasses, Go structs, Rust structs, Kotlin data classes or C# classes.\n\n/** A small type model: { k: 'string'|'number'|'int'|'bool'|'null'|'any'|'array'|'object', of?, fields? } */\nfunction infer(v) {\n  if (v === null) return { k: 'null' };\n  if (Array.isArray(v)) {\n    if (!v.length) return { k: 'array', of: { k: 'any' } };\n    return { k: 'array', of: v.map(infer).reduce(merge) };\n  }\n  if (typeof v === 'object') {\n    const fields = {};\n    for (const [key, val] of Object.entries(v)) fields[key] = { type: infer(val), optional: false };\n    return { k: 'object', fields };\n  }\n  if (typeof v === 'number') return { k: Number.isInteger(v) ? 'int' : 'number' };\n  if (typeof v === 'boolean') return { k: 'bool' };\n  return { k: 'string' };\n}\n\n/** Combines two samples of the same slot: objects merge their fields, a field missing in one becomes optional. */\nfunction merge(a, b) {\n  if (a.k === 'object' && b.k === 'object') {\n    const fields = {};\n    for (const key of new Set([...Object.keys(a.fields), ...Object.keys(b.fields)])) {\n      const x = a.fields[key];\n      const y = b.fields[key];\n      if (x && y) fields[key] = { type: merge(x.type, y.type), optional: x.optional || y.optional };\n      else fields[key] = { type: (x || y).type, optional: true };\n    }\n    return { k: 'object', fields };\n  }\n  if (a.k === 'array' && b.k === 'array') return { k: 'array', of: merge(a.of, b.of) };\n  if (a.k === b.k) return a;\n  if ((a.k === 'int' && b.k === 'number') || (a.k === 'number' && b.k === 'int')) return { k: 'number' };\n  if (a.k === 'null') return { k: b.k === 'null' ? 'null' : 'nullable', of: b };\n  if (b.k === 'null') return { k: 'nullable', of: a };\n  if (a.k === 'nullable' && b.k !== 'nullable') return { k: 'nullable', of: merge(a.of, b) };\n  if (b.k === 'nullable' && a.k !== 'nullable') return { k: 'nullable', of: merge(a, b.of) };\n  if (a.k === 'nullable' && b.k === 'nullable') return { k: 'nullable', of: merge(a.of, b.of) };\n  return { k: 'any' };\n}\n\nconst words = (s) => s.replace(/([a-z0-9])([A-Z])/g, '$1 $2').split(/[^A-Za-z0-9]+/).filter(Boolean);\nconst pascal = (s) => words(s).map((w) => w[0].toUpperCase() + w.slice(1)).join('') || 'Field';\nconst camel = (s) => { const p = pascal(s); return p[0].toLowerCase() + p.slice(1); };\nconst snake = (s) => words(s).map((w) => w.toLowerCase()).join('_') || 'field';\nconst singular = (s) => (/ies$/.test(s) ? s.slice(0, -3) + 'y' : /(ss|us)$/.test(s) ? s : /s$/.test(s) ? s.slice(0, -1) : s);\n\n/** Collects every object type with a unique name, children first. */\nfunction collect(type, name, out) {\n  if (type.k === 'array') return collect(type.of, singular(name), out);\n  if (type.k === 'nullable') return collect(type.of, name, out);\n  if (type.k !== 'object') return;\n  for (const [key, f] of Object.entries(type.fields)) collect(f.type, pascal(key), out);\n  let n = pascal(name);\n  let i = 2;\n  const same = (x) => JSON.stringify(x.type) === JSON.stringify(type);\n  const existing = out.find((x) => x.name === n);\n  if (existing && same(existing)) return;\n  while (out.some((x) => x.name === n)) n = pascal(name) + i++;\n  out.push({ name: n, type });\n}\n\nconst TARGETS = {\n  typescript: {\n    label: 'TypeScript interfaces',\n    ref: (t, nm) => ({ string: 'string', number: 'number', int: 'number', bool: 'boolean', null: 'null', any: 'unknown' }[t.k] || (t.k === 'array' ? ref('typescript', t.of, singular(nm)) + '[]' : t.k === 'nullable' ? ref('typescript', t.of, nm) + ' | null' : pascal(nm))),\n    decl: (name, fields) => 'export interface ' + name + ' {\\n' + fields.map((f) => '  ' + (/^[A-Za-z_$][\\w$]*$/.test(f.key) ? f.key : JSON.stringify(f.key)) + (f.optional ? '?' : '') + ': ' + f.type + ';').join('\\n') + '\\n}',\n  },\n  python: {\n    label: 'Python dataclasses',\n    ref: (t, nm) => ({ string: 'str', number: 'float', int: 'int', bool: 'bool', null: 'None', any: 'Any' }[t.k] || (t.k === 'array' ? 'list[' + ref('python', t.of, singular(nm)) + ']' : t.k === 'nullable' ? 'Optional[' + ref('python', t.of, nm) + ']' : pascal(nm))),\n    decl: (name, fields) => '@dataclass\\nclass ' + name + ':\\n' + (fields.length ? fields.map((f) => '    ' + snake(f.key) + ': ' + (f.optional && !/^Optional/.test(f.type) ? 'Optional[' + f.type + '] = None' : f.type + (f.optional ? ' = None' : ''))).join('\\n') : '    pass'),\n    head: 'from dataclasses import dataclass\\nfrom typing import Any, Optional\\n\\n',\n  },\n  go: {\n    label: 'Go structs',\n    ref: (t, nm) => ({ string: 'string', number: 'float64', int: 'int', bool: 'bool', null: 'interface{}', any: 'interface{}' }[t.k] || (t.k === 'array' ? '[]' + ref('go', t.of, singular(nm)) : t.k === 'nullable' ? '*' + ref('go', t.of, nm) : pascal(nm))),\n    decl: (name, fields) => 'type ' + name + ' struct {\\n' + fields.map((f) => '\\t' + pascal(f.key) + ' ' + f.type + ' `json:\"' + f.key + (f.optional ? ',omitempty' : '') + '\"`').join('\\n') + '\\n}',\n  },\n  rust: {\n    label: 'Rust structs (serde)',\n    ref: (t, nm) => ({ string: 'String', number: 'f64', int: 'i64', bool: 'bool', null: 'Option<serde_json::Value>', any: 'serde_json::Value' }[t.k] || (t.k === 'array' ? 'Vec<' + ref('rust', t.of, singular(nm)) + '>' : t.k === 'nullable' ? 'Option<' + ref('rust', t.of, nm) + '>' : pascal(nm))),\n    decl: (name, fields) => '#[derive(Debug, Serialize, Deserialize)]\\npub struct ' + name + ' {\\n' + fields.map((f) => (snake(f.key) !== f.key ? '    #[serde(rename = \"' + f.key + '\")]\\n' : '') + '    pub ' + (['type', 'match', 'move', 'ref', 'use', 'fn', 'mod'].includes(snake(f.key)) ? 'r#' : '') + snake(f.key) + ': ' + (f.optional && !/^Option</.test(f.type) ? 'Option<' + f.type + '>' : f.type) + ',').join('\\n') + '\\n}',\n    head: 'use serde::{Deserialize, Serialize};\\n\\n',\n  },\n  kotlin: {\n    label: 'Kotlin data classes',\n    ref: (t, nm) => ({ string: 'String', number: 'Double', int: 'Long', bool: 'Boolean', null: 'Any?', any: 'Any' }[t.k] || (t.k === 'array' ? 'List<' + ref('kotlin', t.of, singular(nm)) + '>' : t.k === 'nullable' ? ref('kotlin', t.of, nm) + '?' : pascal(nm))),\n    decl: (name, fields) => 'data class ' + name + '(\\n' + fields.map((f) => '    val ' + camel(f.key) + ': ' + f.type + (f.optional && !f.type.endsWith('?') ? '?' : '') + (f.optional ? ' = null' : '')).join(',\\n') + '\\n)',\n  },\n  csharp: {\n    label: 'C# classes',\n    ref: (t, nm) => ({ string: 'string', number: 'double', int: 'long', bool: 'bool', null: 'object?', any: 'object' }[t.k] || (t.k === 'array' ? 'List<' + ref('csharp', t.of, singular(nm)) + '>' : t.k === 'nullable' ? ref('csharp', t.of, nm) + '?' : pascal(nm))),\n    decl: (name, fields) => 'public class ' + name + '\\n{\\n' + fields.map((f) => '    public ' + f.type + (f.optional && !f.type.endsWith('?') ? '?' : '') + ' ' + pascal(f.key) + ' { get; set; }').join('\\n') + '\\n}',\n    head: 'using System.Collections.Generic;\\n\\n',\n  },\n};\n\nfunction ref(lang, t, nm) {\n  return TARGETS[lang].ref(t, nm);\n}\n\nfunction generate(json, lang, rootName = 'Root') {\n  const T = TARGETS[lang];\n  if (!T) throw new Error('Unknown language ' + lang);\n  const data = typeof json === 'string' ? JSON.parse(json) : json;\n  const type = infer(data);\n  const objs = [];\n  collect(type, rootName, objs);\n  if (!objs.length) return '// The JSON is not an object or a list of objects, so there is nothing to describe.\\n';\n  const blocks = objs.map((o) => {\n    const fields = Object.entries(o.type.fields).map(([key, f]) => ({ key, optional: f.optional, type: ref(lang, f.type, key) }));\n    return T.decl(o.name, fields);\n  });\n  const rootIsList = type.k === 'array';\n  const note = rootIsList && lang === 'typescript' ? '\\nexport type ' + pascal(rootName) + 'List = ' + objs[objs.length - 1].name + '[];' : '';\n  return (T.head || '') + blocks.reverse().join('\\n\\n') + note + '\\n';\n}\n\nexports._test = { infer, merge, generate, pascal, camel, snake, singular, TARGETS };\n\nexports.activate = function (context) {\n  async function run(forced) {\n    const doc = await ferrum.editor.active();\n    if (!doc) return ferrum.window.showMessage('Open or select some JSON first.', 'warn');\n    const text = doc.selectedText || doc.text;\n    let data;\n    try {\n      data = JSON.parse(text);\n    } catch (e) {\n      return ferrum.window.showMessage('That is not valid JSON: ' + e.message, 'error');\n    }\n    let lang = forced;\n    if (!lang) {\n      const p = await ferrum.window.showQuickPick(Object.entries(TARGETS).map(([id, t]) => ({ label: t.label, id })), { placeholder: 'Generate types for...' });\n      if (!p) return;\n      lang = p.id;\n    }\n    const name = (await ferrum.window.showInputBox({ prompt: 'Name of the main type', value: 'Root' })) || 'Root';\n    const out = generate(data, lang, pascal(name));\n    await ferrum.window.showPanel({\n      title: 'Types: ' + TARGETS[lang].label,\n      html: '<style>body{font-family:var(--ui)} pre{font:13px/1.55 var(--mono,monospace);white-space:pre-wrap;background:var(--raised,transparent);border:1px solid var(--border);border-radius:6px;padding:10px} button{background:var(--accent);color:#fff;border:0;border-radius:6px;padding:6px 14px;cursor:pointer}</style><h3>' + TARGETS[lang].label + '</h3><button onclick=\"send({type:\\'insert\\'})\">Insert in the editor</button><pre>' + out.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</pre>',\n    }).then((panel) => panel.onMessage(async (m) => m.type === 'insert' && (await ferrum.editor.insert(out))));\n  }\n  context.subscriptions.push(\n    ferrum.commands.register('jsonToTypes.generate', () => run(null)),\n    ferrum.commands.register('jsonToTypes.typescript', () => run('typescript')),\n    ferrum.commands.register('jsonToTypes.python', () => run('python')),\n    ferrum.commands.register('jsonToTypes.go', () => run('go')),\n    ferrum.commands.register('jsonToTypes.rust', () => run('rust')),\n  );\n};\n\nexports.deactivate = function () {};\n"},"README.md":{"encoding":"utf8","content":"# JSON to Types\n\nOpen or select a JSON sample (an API response, a config) and run a command. Nested objects get their own named type, list items are merged, a field missing from some items becomes optional and a `null` mixed with a value becomes nullable. A panel shows the result and a button inserts it.\n\nTargets: TypeScript, Python (dataclasses), Go (with json tags), Rust (serde), Kotlin and C#.\n\nThe more samples in a list, the better the result: with `[{\"a\":1},{\"a\":2,\"b\":\"x\"}]`, `b` is detected as optional. No permissions needed.\n"}}}