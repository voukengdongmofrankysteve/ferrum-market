{"format":1,"manifest":{"name":"symfony-snippets","publisher":"vyloxi","version":"1.0.0","displayName":"Symfony Snippets","description":"Controllers, entities, forms, services, commands and Twig for Symfony. Install the PHP extension for colors.","engines":{"ferrum":"^0.1.0"},"categories":["Snippets"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","contributes":{"snippets":[{"language":"PHP","path":"snippets/php.json"},{"language":"Twig and Jinja","path":"snippets/twig-and-jinja.json"}]}},"files":{"icon.png":{"encoding":"base64","content":""},"snippets/php.json":{"encoding":"utf8","content":"{\n  \"Controller\": {\n    \"prefix\": \"sfctrl\",\n    \"body\": [\n      \"<?php\",\n      \"\",\n      \"namespace App\\\\\\\\Controller;\",\n      \"\",\n      \"use Symfony\\\\\\\\Bundle\\\\\\\\FrameworkBundle\\\\\\\\Controller\\\\\\\\AbstractController;\",\n      \"use Symfony\\\\\\\\Component\\\\\\\\HttpFoundation\\\\\\\\Response;\",\n      \"use Symfony\\\\\\\\Component\\\\\\\\Routing\\\\\\\\Attribute\\\\\\\\Route;\",\n      \"\",\n      \"final class ${1:Name}Controller extends AbstractController\",\n      \"{\",\n      \"    #[Route('${2:/path}', name: '${3:app_name}')]\",\n      \"    public function index(): Response\",\n      \"    {\",\n      \"        return \\\\$this->render('${4:name/index.html.twig}');\",\n      \"    }\",\n      \"}\"\n    ],\n    \"description\": \"A controller\"\n  },\n  \"Route attribute\": {\n    \"prefix\": \"sfroute\",\n    \"body\": [\n      \"#[Route('${1:/path}', name: '${2:app_name}', methods: ['${3:GET}'])]\"\n    ],\n    \"description\": \"A Route attribute\"\n  },\n  \"Entity\": {\n    \"prefix\": \"sfent\",\n    \"body\": [\n      \"<?php\",\n      \"\",\n      \"namespace App\\\\\\\\Entity;\",\n      \"\",\n      \"use Doctrine\\\\\\\\ORM\\\\\\\\Mapping as ORM;\",\n      \"\",\n      \"#[ORM\\\\\\\\Entity]\",\n      \"class ${1:Name}\",\n      \"{\",\n      \"    #[ORM\\\\\\\\Id, ORM\\\\\\\\GeneratedValue, ORM\\\\\\\\Column]\",\n      \"    private ?int \\\\$id = null;\",\n      \"\",\n      \"    #[ORM\\\\\\\\Column(length: 255)]\",\n      \"    private ?string \\\\$${2:name} = null;\",\n      \"\",\n      \"    public function getId(): ?int\",\n      \"    {\",\n      \"        return \\\\$this->id;\",\n      \"    }\",\n      \"}\"\n    ],\n    \"description\": \"A Doctrine entity\"\n  },\n  \"Service\": {\n    \"prefix\": \"sfsvc\",\n    \"body\": [\n      \"<?php\",\n      \"\",\n      \"namespace App\\\\\\\\Service;\",\n      \"\",\n      \"final class ${1:Name}\",\n      \"{\",\n      \"    public function __construct(private readonly ${2:LoggerInterface} \\\\$${3:logger})\",\n      \"    {\",\n      \"    }\",\n      \"\",\n      \"    $0\",\n      \"}\"\n    ],\n    \"description\": \"A service\"\n  },\n  \"Command\": {\n    \"prefix\": \"sfcmd\",\n    \"body\": [\n      \"<?php\",\n      \"\",\n      \"namespace App\\\\\\\\Command;\",\n      \"\",\n      \"use Symfony\\\\\\\\Component\\\\\\\\Console\\\\\\\\Attribute\\\\\\\\AsCommand;\",\n      \"use Symfony\\\\\\\\Component\\\\\\\\Console\\\\\\\\Command\\\\\\\\Command;\",\n      \"use Symfony\\\\\\\\Component\\\\\\\\Console\\\\\\\\Input\\\\\\\\InputInterface;\",\n      \"use Symfony\\\\\\\\Component\\\\\\\\Console\\\\\\\\Output\\\\\\\\OutputInterface;\",\n      \"\",\n      \"#[AsCommand(name: 'app:${1:do-it}', description: '${2:Does it}')]\",\n      \"class ${3:DoIt}Command extends Command\",\n      \"{\",\n      \"    protected function execute(InputInterface \\\\$input, OutputInterface \\\\$output): int\",\n      \"    {\",\n      \"        \\\\$output->writeln('${4:done}');\",\n      \"\",\n      \"        return Command::SUCCESS;\",\n      \"    }\",\n      \"}\"\n    ],\n    \"description\": \"A console command\"\n  },\n  \"Form type\": {\n    \"prefix\": \"sfform\",\n    \"body\": [\n      \"<?php\",\n      \"\",\n      \"namespace App\\\\\\\\Form;\",\n      \"\",\n      \"use Symfony\\\\\\\\Component\\\\\\\\Form\\\\\\\\AbstractType;\",\n      \"use Symfony\\\\\\\\Component\\\\\\\\Form\\\\\\\\FormBuilderInterface;\",\n      \"\",\n      \"class ${1:Name}Type extends AbstractType\",\n      \"{\",\n      \"    public function buildForm(FormBuilderInterface \\\\$builder, array \\\\$options): void\",\n      \"    {\",\n      \"        \\\\$builder->add('${2:name}');\",\n      \"    }\",\n      \"}\"\n    ],\n    \"description\": \"A form type\"\n  },\n  \"Event subscriber\": {\n    \"prefix\": \"sfsub\",\n    \"body\": [\n      \"<?php\",\n      \"\",\n      \"namespace App\\\\\\\\EventSubscriber;\",\n      \"\",\n      \"use Symfony\\\\\\\\Component\\\\\\\\EventDispatcher\\\\\\\\EventSubscriberInterface;\",\n      \"\",\n      \"class ${1:Name}Subscriber implements EventSubscriberInterface\",\n      \"{\",\n      \"    public static function getSubscribedEvents(): array\",\n      \"    {\",\n      \"        return [\",\n      \"            ${2:\\\\\\\\'kernel.request\\\\\\\\'} => 'onEvent',\",\n      \"        ];\",\n      \"    }\",\n      \"\",\n      \"    public function onEvent(\\\\$event): void\",\n      \"    {\",\n      \"        $0\",\n      \"    }\",\n      \"}\"\n    ],\n    \"description\": \"An event subscriber\"\n  },\n  \"Repository query\": {\n    \"prefix\": \"sfrepo\",\n    \"body\": [\n      \"\\\\$this->createQueryBuilder('${1:e}')\",\n      \"    ->andWhere('${1:e}.${2:field} = :value')\",\n      \"    ->setParameter('value', ${3:\\\\$value})\",\n      \"    ->getQuery()\",\n      \"    ->getResult();\"\n    ],\n    \"description\": \"A repository query\"\n  },\n  \"JSON response\": {\n    \"prefix\": \"sfjson\",\n    \"body\": [\n      \"return \\\\$this->json(['${1:ok}' => true]);\"\n    ],\n    \"description\": \"A JSON response\"\n  },\n  \"Voter\": {\n    \"prefix\": \"sfvoter\",\n    \"body\": [\n      \"protected function supports(string \\\\$attribute, mixed \\\\$subject): bool\",\n      \"{\",\n      \"    return in_array(\\\\$attribute, ['${1:EDIT}'], true) && \\\\$subject instanceof ${2:Post};\",\n      \"}\"\n    ],\n    \"description\": \"A voter\"\n  }\n}\n"},"snippets/twig-and-jinja.json":{"encoding":"utf8","content":"{\n  \"Extends\": {\n    \"prefix\": \"twext\",\n    \"body\": [\n      \"{% extends '${1:base.html.twig}' %}\",\n      \"\",\n      \"{% block ${2:body} %}\",\n      \"    $0\",\n      \"{% endblock %}\"\n    ],\n    \"description\": \"extends\"\n  },\n  \"Path\": {\n    \"prefix\": \"twpath\",\n    \"body\": [\n      \"{{ path('${1:app_name}') }}\"\n    ],\n    \"description\": \"A route path\"\n  },\n  \"Asset\": {\n    \"prefix\": \"twasset\",\n    \"body\": [\n      \"{{ asset('${1:build/app.css}') }}\"\n    ],\n    \"description\": \"An asset\"\n  },\n  \"Form\": {\n    \"prefix\": \"twform\",\n    \"body\": [\n      \"{{ form_start(${1:form}) }}\",\n      \"    {{ form_widget(${1:form}) }}\",\n      \"    <button type=\\\"submit\\\">${2:Save}</button>\",\n      \"{{ form_end(${1:form}) }}\"\n    ],\n    \"description\": \"Render a form\"\n  },\n  \"Include\": {\n    \"prefix\": \"twinc\",\n    \"body\": [\n      \"{{ include('${1:partial.html.twig}') }}\"\n    ],\n    \"description\": \"include\"\n  }\n}\n"},"README.md":{"encoding":"utf8","content":"# Symfony Snippets\n\nControllers, entities, forms, services, commands and Twig for Symfony. Install the PHP extension for colors.\n\nType a prefix and press Tab. 15 snippets.\n\n| Language | Prefix | What it inserts |\n| --- | --- | --- |\n| PHP | `sfctrl` | A controller |\n| PHP | `sfroute` | A Route attribute |\n| PHP | `sfent` | A Doctrine entity |\n| PHP | `sfsvc` | A service |\n| PHP | `sfcmd` | A console command |\n| PHP | `sfform` | A form type |\n| PHP | `sfsub` | An event subscriber |\n| PHP | `sfrepo` | A repository query |\n| PHP | `sfjson` | A JSON response |\n| PHP | `sfvoter` | A voter |\n| Twig and Jinja | `twext` | extends |\n| Twig and Jinja | `twpath` | A route path |\n| Twig and Jinja | `twasset` | An asset |\n| Twig and Jinja | `twform` | Render a form |\n| Twig and Jinja | `twinc` | include |\n\nThis extension runs no code and asks for no permissions.\n"}}}