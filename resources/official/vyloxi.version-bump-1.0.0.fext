{"format":1,"manifest":{"name":"version-bump","publisher":"vyloxi","version":"1.0.0","displayName":"Version Bump","description":"Raise the version in package.json, Cargo.toml, pyproject.toml and composer.json together, and add a dated entry to CHANGELOG.md.","engines":{"ferrum":"^0.1.0"},"categories":["Tools"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","main":"extension.js","activationEvents":["onCommand:versionBump.patch","onCommand:versionBump.minor","onCommand:versionBump.major","onCommand:versionBump.prepatch","onCommand:versionBump.preminor","onCommand:versionBump.premajor","onCommand:versionBump.prerelease","onCommand:versionBump.show"],"permissions":["workspace.read","workspace.write"],"contributes":{"commands":[{"command":"versionBump.patch","title":"Bump Patch (1.2.3 to 1.2.4)","category":"Version Bump"},{"command":"versionBump.minor","title":"Bump Minor (1.2.3 to 1.3.0)","category":"Version Bump"},{"command":"versionBump.major","title":"Bump Major (1.2.3 to 2.0.0)","category":"Version Bump"},{"command":"versionBump.prepatch","title":"Bump to Pre-release Patch (1.2.4-beta.0)","category":"Version Bump"},{"command":"versionBump.preminor","title":"Bump to Pre-release Minor (1.3.0-beta.0)","category":"Version Bump"},{"command":"versionBump.premajor","title":"Bump to Pre-release Major (2.0.0-beta.0)","category":"Version Bump"},{"command":"versionBump.prerelease","title":"Next Pre-release (beta.0 to beta.1)","category":"Version Bump"},{"command":"versionBump.show","title":"Show Current Versions","category":"Version Bump"}],"configuration":{"title":"Version Bump","properties":{"versionBump.prereleaseTag":{"type":"string","default":"beta","description":"The word used in pre-release versions: beta, rc, alpha."},"versionBump.changelog":{"type":"boolean","default":true,"description":"Add an entry to CHANGELOG.md (created if missing)."}}}}},"files":{"icon.png":{"encoding":"base64","content":""},"extension.js":{"encoding":"utf8","content":"// Version Bump: raise the version in package.json, Cargo.toml, pyproject.toml or composer.json and add a dated entry to CHANGELOG.md.\n\nfunction parseVersion(v) {\n  const m = /^(\\d+)\\.(\\d+)\\.(\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\+[0-9A-Za-z.-]+)?$/.exec(String(v).trim());\n  if (!m) throw new Error('\"' + v + '\" is not a version like 1.2.3');\n  return { major: +m[1], minor: +m[2], patch: +m[3], pre: m[4] || '' };\n}\n\nfunction bump(version, kind, pre = 'beta') {\n  const v = parseVersion(version);\n  const base = (a, b, c) => a + '.' + b + '.' + c;\n  switch (kind) {\n    case 'major': return base(v.major + 1, 0, 0);\n    case 'minor': return base(v.major, v.minor + 1, 0);\n    case 'patch': return v.pre ? base(v.major, v.minor, v.patch) : base(v.major, v.minor, v.patch + 1);\n    case 'premajor': return base(v.major + 1, 0, 0) + '-' + pre + '.0';\n    case 'preminor': return base(v.major, v.minor + 1, 0) + '-' + pre + '.0';\n    case 'prepatch': return base(v.major, v.minor, v.patch + 1) + '-' + pre + '.0';\n    case 'prerelease': {\n      const m = /^(.*?)(\\d+)$/.exec(v.pre);\n      if (!v.pre) return base(v.major, v.minor, v.patch + 1) + '-' + pre + '.0';\n      return base(v.major, v.minor, v.patch) + '-' + (m ? m[1] + (+m[2] + 1) : v.pre + '.1');\n    }\n    default: throw new Error('Unknown kind ' + kind);\n  }\n}\n\n/** Reads and rewrites the version in a manifest file, keeping the rest of the text as it is. */\nconst FILES = {\n  'package.json': { read: (t) => (/\"version\"\\s*:\\s*\"([^\"]+)\"/.exec(t) || [])[1], write: (t, v) => t.replace(/(\"version\"\\s*:\\s*\")[^\"]+(\")/, '$1' + v + '$2') },\n  'composer.json': { read: (t) => (/\"version\"\\s*:\\s*\"([^\"]+)\"/.exec(t) || [])[1], write: (t, v) => t.replace(/(\"version\"\\s*:\\s*\")[^\"]+(\")/, '$1' + v + '$2') },\n  'Cargo.toml': { read: (t) => (/\\[package\\][\\s\\S]*?^version\\s*=\\s*\"([^\"]+)\"/m.exec(t) || [])[1], write: (t, v) => t.replace(/(\\[package\\][\\s\\S]*?^version\\s*=\\s*\")[^\"]+(\")/m, '$1' + v + '$2') },\n  'pyproject.toml': { read: (t) => (/^\\s*version\\s*=\\s*\"([^\"]+)\"/m.exec(t) || [])[1], write: (t, v) => t.replace(/(^\\s*version\\s*=\\s*\")[^\"]+(\")/m, '$1' + v + '$2') },\n};\n\nfunction readVersion(file, text) {\n  const f = FILES[file];\n  if (!f) throw new Error(file + ' is not supported');\n  const v = f.read(text);\n  if (!v) throw new Error('No version found in ' + file);\n  return v;\n}\n\nfunction writeVersion(file, text, version) {\n  readVersion(file, text);\n  return FILES[file].write(text, version);\n}\n\n/** Adds \"## version (date)\" under the title of a Keep a Changelog style file, or creates the file. */\nfunction addChangelog(text, version, date, notes) {\n  const entry = '## [' + version + '] - ' + date + '\\n\\n' + (notes && notes.length ? notes.map((n) => '- ' + n).join('\\n') : '- ') + '\\n\\n';\n  if (!text || !text.trim()) return '# Changelog\\n\\nAll notable changes are listed here.\\n\\n' + entry;\n  const m = /^## /m.exec(text);\n  if (m) return text.slice(0, m.index) + entry + text.slice(m.index);\n  return text.replace(/\\s*$/, '\\n\\n') + entry;\n}\n\nexports._test = { parseVersion, bump, readVersion, writeVersion, addChangelog };\n\nexports.activate = function (context) {\n  const root = () => ferrum.workspace.root;\n  const join = (n) => root() + (root().includes('\\\\') ? '\\\\' : '/') + n;\n\n  async function run(kind) {\n    if (!root()) return ferrum.window.showMessage('Open a folder first.', 'warn');\n    const files = await ferrum.workspace.listFiles();\n    const found = Object.keys(FILES).filter((f) => files.includes(f));\n    if (!found.length) return ferrum.window.showMessage('No package.json, Cargo.toml, pyproject.toml or composer.json in the top folder.', 'warn');\n    const main = found[0];\n    const text = await ferrum.workspace.readFile(join(main));\n    const current = readVersion(main, text);\n    const pre = String(ferrum.settings.get('versionBump.prereleaseTag') || 'beta');\n    const next = bump(current, kind, pre);\n    if (!(await ferrum.window.confirm('Change the version in ' + found.join(', ') + ' from ' + current + ' to ' + next + '?', 'Bump'))) return;\n    for (const f of found) {\n      const t = await ferrum.workspace.readFile(join(f));\n      try {\n        await ferrum.workspace.writeFile(join(f), writeVersion(f, t, next));\n      } catch {\n        /* a file with no version is left alone */\n      }\n    }\n    if (ferrum.settings.get('versionBump.changelog') !== false) {\n      let old = '';\n      try {\n        old = await ferrum.workspace.readFile(join('CHANGELOG.md'));\n      } catch {\n        old = '';\n      }\n      const date = new Date().toISOString().slice(0, 10);\n      await ferrum.workspace.writeFile(join('CHANGELOG.md'), addChangelog(old, next, date, []));\n    }\n    ferrum.window.showMessage('Version is now ' + next + '. Commit it with: git commit -am \"v' + next + '\" and git tag v' + next);\n  }\n\n  context.subscriptions.push(\n    ...['patch', 'minor', 'major', 'prepatch', 'preminor', 'premajor', 'prerelease'].map((k) => ferrum.commands.register('versionBump.' + k, () => run(k))),\n    ferrum.commands.register('versionBump.show', async () => {\n      if (!root()) return ferrum.window.showMessage('Open a folder first.', 'warn');\n      const lines = [];\n      for (const f of Object.keys(FILES)) {\n        try {\n          lines.push(f + ' ' + readVersion(f, await ferrum.workspace.readFile(join(f))));\n        } catch {\n          /* not in this project */\n        }\n      }\n      ferrum.window.showMessage(lines.join('  |  ') || 'No version found.');\n    }),\n  );\n};\n\nexports.deactivate = function () {};\n"},"README.md":{"encoding":"utf8","content":"# Version Bump\n\nRun **Bump Patch**, **Minor** or **Major**. The extension finds the manifest files in the top folder of the project, shows the old and the new version, and **asks before it changes anything**. Only the version line changes; the rest of each file stays exactly as it was.\n\nIt also adds `## [1.3.0] - 2025-01-06` with an empty bullet to **CHANGELOG.md** (the file is created if it does not exist) so you can fill in the notes. Afterwards it reminds you of the commit and tag commands. It never runs git by itself.\n\nSupported files: `package.json`, `composer.json`, `Cargo.toml` (the `[package]` section), `pyproject.toml`.\n\nPermissions: it reads and writes files in the open folder only.\n"}}}