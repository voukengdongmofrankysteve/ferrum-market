{"format":1,"manifest":{"name":"pomodoro","publisher":"vyloxi","version":"1.0.0","displayName":"Pomodoro Timer","description":"A focus timer in the status bar: 25 minutes of work, 5 minutes of rest, a longer break every fourth round.","engines":{"ferrum":"^0.1.0"},"categories":["Productivity"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","main":"extension.js","activationEvents":["onStartup"],"permissions":[],"contributes":{"commands":[{"command":"pomodoro.toggle","title":"Start or Pause","category":"Pomodoro Timer"},{"command":"pomodoro.start","title":"Start","category":"Pomodoro Timer"},{"command":"pomodoro.pause","title":"Pause","category":"Pomodoro Timer"},{"command":"pomodoro.reset","title":"Reset","category":"Pomodoro Timer"},{"command":"pomodoro.skip","title":"Skip to the Next Phase","category":"Pomodoro Timer"}],"configuration":{"title":"Pomodoro Timer","properties":{"pomodoro.workMinutes":{"type":"number","default":25,"description":"Minutes of focus."},"pomodoro.breakMinutes":{"type":"number","default":5,"description":"Minutes of short break."},"pomodoro.longBreakMinutes":{"type":"number","default":15,"description":"Minutes of long break."},"pomodoro.longBreakEvery":{"type":"number","default":4,"description":"A long break after this many focus sessions."}}}}},"files":{"icon.png":{"encoding":"base64","content":""},"extension.js":{"encoding":"utf8","content":"// Pomodoro Timer: focus for 25 minutes, rest for 5. The timer lives in the status bar.\n\nfunction fmt(sec) {\n  const m = Math.floor(sec / 60);\n  return String(m).padStart(2, '0') + ':' + String(sec % 60).padStart(2, '0');\n}\n\n/** The state machine, with no timers in it so it can be tested. */\nfunction step(state, cfg) {\n  if (state.left > 1) return { state: { ...state, left: state.left - 1 }, event: null };\n  if (state.phase === 'work') {\n    const done = state.done + 1;\n    const long = cfg.longEvery > 0 && done % cfg.longEvery === 0;\n    return { state: { phase: long ? 'long' : 'break', left: (long ? cfg.longBreak : cfg.shortBreak) * 60, done, running: true }, event: long ? 'long' : 'break' };\n  }\n  return { state: { phase: 'work', left: cfg.work * 60, done: state.done, running: true }, event: 'work' };\n}\n\nexports._test = { fmt, step };\n\nexports.activate = function (context) {\n  const cfg = () => ({\n    work: Number(ferrum.settings.get('pomodoro.workMinutes')) || 25,\n    shortBreak: Number(ferrum.settings.get('pomodoro.breakMinutes')) || 5,\n    longBreak: Number(ferrum.settings.get('pomodoro.longBreakMinutes')) || 15,\n    longEvery: Number(ferrum.settings.get('pomodoro.longBreakEvery')) || 4,\n  });\n  let state = { phase: 'work', left: cfg().work * 60, done: 0, running: false };\n  let timer = null;\n\n  function draw() {\n    const label = state.phase === 'work' ? 'Focus' : state.phase === 'long' ? 'Long break' : 'Break';\n    ferrum.window.setStatusBar('pomodoro.status', {\n      text: (state.running ? '' : 'Paused ') + label + ' ' + fmt(state.left) + (state.done ? '  (' + state.done + ')' : ''),\n      tooltip: 'Click to ' + (state.running ? 'pause' : 'start') + ' the timer. ' + state.done + ' focus sessions done.',\n      command: 'pomodoro.toggle',\n    });\n  }\n  function tick() {\n    const r = step(state, cfg());\n    state = r.state;\n    if (r.event === 'break') ferrum.window.showMessage('Focus session done. Take a ' + cfg().shortBreak + ' minute break.');\n    else if (r.event === 'long') ferrum.window.showMessage('Four sessions done. Take a longer break of ' + cfg().longBreak + ' minutes.');\n    else if (r.event === 'work') ferrum.window.showMessage('Break over. Back to focus for ' + cfg().work + ' minutes.');\n    draw();\n  }\n  function start() {\n    if (timer) return;\n    state.running = true;\n    timer = setInterval(tick, 1000);\n    draw();\n  }\n  function pause() {\n    clearInterval(timer);\n    timer = null;\n    state.running = false;\n    draw();\n  }\n\n  const reg = (id, fn) => context.subscriptions.push(ferrum.commands.register(id, fn));\n  reg('pomodoro.toggle', () => (state.running ? pause() : start()));\n  reg('pomodoro.start', start);\n  reg('pomodoro.pause', pause);\n  reg('pomodoro.reset', () => {\n    pause();\n    state = { phase: 'work', left: cfg().work * 60, done: 0, running: false };\n    draw();\n  });\n  reg('pomodoro.skip', () => {\n    state = step({ ...state, left: 1 }, cfg()).state;\n    draw();\n  });\n  context.subscriptions.push({ dispose: () => clearInterval(timer) });\n  draw();\n};\n\nexports.deactivate = function () {};\n"},"README.md":{"encoding":"utf8","content":"# Pomodoro Timer\n\nClick the timer in the status bar to start or pause. When a phase ends you get a message. After four focus sessions the break is longer. Change the minutes in the extension settings.\n\nNo permissions needed.\n"}}}