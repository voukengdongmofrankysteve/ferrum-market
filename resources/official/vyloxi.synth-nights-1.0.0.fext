"constant.numeric\"\n      ],\n      \"settings\": {\n        \"foreground\": \"#f97e72\"\n      }\n    },\n    {\n      \"scope\": [\n        \"keyword\",\n        \"storage\"\n      ],\n      \"settings\": {\n        \"foreground\": \"#fede5d\"\n      }\n    },\n    {\n      \"scope\": [\n        \"entity.name.type\",\n        \"support.type\",\n        \"storage.type\"\n      ],\n      \"settings\": {\n        \"foreground\": \"#fe4450\"\n      }\n    },\n    {\n      \"scope\": [\n        \"entity.name.function\",\n        \"support.function\"\n      ],\n      \"settings\": {\n        \"foreground\": \"#36f9f6\"\n      }\n    },\n    {\n      \"scope\": [\n        \"constant.language\",\n        \"constant\"\n      ],\n      \"settings\": {\n        \"foreground\": \"#f97e72\"\n      }\n    },\n    {\n      \"scope\": [\n        \"variable.other.property\",\n        \"support.type.property-name\"\n      ],\n      \"settings\": {\n        \"foreground\": \"#ff7edb\"\n      }\n    },\n    {\n      \"scope\": [\n        \"entity.name.tag\"\n      ],\n      \"settings\": {\n        \"foreground\": \"#72f1b8\"\n      }\n    },\n    {\n      \"scope\": [\n        \"entity.other.attribute-name\"\n      ],\n      \"settings\": {\n        \"foreground\": \"#fede5d\"\n      }\n    },\n    {\n      \"scope\": [\n        \"entity.name.function.macro\",\n        \"meta.preprocessor\"\n      ],\n      \"settings\": {\n        \"foreground\": \"#ff7edb\"\n      }\n    }\n  ]\n}\n"},"README.md":{"encoding":"utf8","content":"# Synth Nights\n\nNeon pinks and cyans on a deep purple background.\n\nInstall it, then pick **Synth Nights** in **Settings > Colour theme**. It is a dark theme.\n\nInspired by the Synthwave 84 look.\n\n| Role | Color |\n| --- | --- |\n| Background | `#262335` |\n| Text | `#ffffff` |\n| Accent | `#ff7edb` |\n| Keywords | `#fede5d` |\n| Strings | `#ff8b39` |\n| Functions | `#36f9f6` |\n| Types | `#fe4450` |\n| Comments | `#848bbd` |\n\nThis extension is only a theme: it runs no code and asks for no permissions.\n"}}}