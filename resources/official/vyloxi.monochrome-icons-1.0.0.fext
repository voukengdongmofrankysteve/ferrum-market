    \"icon\": \"key\",\n      \"color\": \"#8a94a3\"\n    },\n    \"vue\": {\n      \"icon\": \"symbol-namespace\",\n      \"color\": \"#8a94a3\"\n    },\n    \"svelte\": {\n      \"icon\": \"symbol-namespace\",\n      \"color\": \"#8a94a3\"\n    }\n  },\n  \"names\": {\n    \"package.json\": {\n      \"icon\": \"package\",\n      \"color\": \"#8a94a3\"\n    },\n    \"cargo.toml\": {\n      \"icon\": \"package\",\n      \"color\": \"#8a94a3\"\n    },\n    \"composer.json\": {\n      \"icon\": \"package\",\n      \"color\": \"#8a94a3\"\n    },\n    \"dockerfile\": {\n      \"icon\": \"server-environment\",\n      \"color\": \"#8a94a3\"\n    },\n    \"readme.md\": {\n      \"icon\": \"book\",\n      \"color\": \"#8a94a3\"\n    },\n    \"license\": {\n      \"icon\": \"law\",\n      \"color\": \"#8a94a3\"\n    },\n    \"makefile\": {\n      \"icon\": \"tools\",\n      \"color\": \"#8a94a3\"\n    },\n    \".gitignore\": {\n      \"icon\": \"source-control\",\n      \"color\": \"#8a94a3\"\n    },\n    \".env\": {\n      \"icon\": \"key\",\n      \"color\": \"#8a94a3\"\n    }\n  },\n  \"folderNames\": {\n    \"src\": {\n      \"icon\": \"folder-library\",\n      \"color\": \"#8a94a3\"\n    },\n    \"docs\": {\n      \"icon\": \"book\",\n      \"color\": \"#8a94a3\"\n    },\n    \"test\": {\n      \"icon\": \"beaker\",\n      \"color\": \"#8a94a3\"\n    },\n    \"tests\": {\n      \"icon\": \"beaker\",\n      \"color\": \"#8a94a3\"\n    },\n    \"public\": {\n      \"icon\": \"globe\",\n      \"color\": \"#8a94a3\"\n    },\n    \"assets\": {\n      \"icon\": \"file-media\",\n      \"color\": \"#8a94a3\"\n    },\n    \"node_modules\": {\n      \"icon\": \"package\",\n      \"color\": \"#8a94a3\"\n    },\n    \".git\": {\n      \"icon\": \"source-control\",\n      \"color\": \"#8a94a3\"\n    },\n    \".github\": {\n      \"icon\": \"github\",\n      \"color\": \"#8a94a3\"\n    },\n    \"dist\": {\n      \"icon\": \"package\",\n      \"color\": \"#8a94a3\"\n    },\n    \"build\": {\n      \"icon\": \"package\",\n      \"color\": \"#8a94a3\"\n    },\n    \"target\": {\n      \"icon\": \"package\",\n      \"color\": \"#8a94a3\"\n    }\n  }\n}\n"},"README.md":{"encoding":"utf8","content":"# Monochrome Icons\n\nCalm, single color icons that never distract from the code.\n\nInstall it, then choose **Monochrome Icons** in **Settings > File icon theme**.\n\nIt covers about 40 kinds of files and a set of well known folders such as `src`, `docs` and `tests`. It runs no code and asks for no permissions.\n"}}}