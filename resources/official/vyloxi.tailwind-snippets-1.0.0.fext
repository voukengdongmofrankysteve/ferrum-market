{"format":1,"manifest":{"name":"tailwind-snippets","publisher":"vyloxi","version":"1.0.0","displayName":"Tailwind CSS Snippets","description":"Ready-made class lists for buttons, cards, forms, layouts, navbars and badges. Works in HTML, Vue, Svelte and Blade.","engines":{"ferrum":"^0.1.0"},"categories":["Snippets"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","contributes":{"snippets":[{"language":"HTML / XML","path":"snippets/html-xml.json"},{"language":"Vue","path":"snippets/vue.json"},{"language":"Svelte","path":"snippets/svelte.json"},{"language":"Laravel Blade","path":"snippets/laravel-blade.json"}]}},"files":{"icon.png":{"encoding":"base64","content":""},"snippets/html-xml.json":{"encoding":"utf8","content":"{\n  \"Button\": {\n    \"prefix\": \"twbtn\",\n    \"body\": [\n      \"class=\\\"inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50\\\"\"\n    ],\n    \"description\": \"A primary button\"\n  },\n  \"Secondary button\": {\n    \"prefix\": \"twbtn2\",\n    \"body\": [\n      \"class=\\\"inline-flex items-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50\\\"\"\n    ],\n    \"description\": \"A secondary button\"\n  },\n  \"Card\": {\n    \"prefix\": \"twcard\",\n    \"body\": [\n      \"class=\\\"overflow-hidden rounded-xl border border-gray-200 bg-white p-6 shadow-sm\\\"\"\n    ],\n    \"description\": \"A card\"\n  },\n  \"Container\": {\n    \"prefix\": \"twcont\",\n    \"body\": [\n      \"class=\\\"mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8\\\"\"\n    ],\n    \"description\": \"A centered container\"\n  },\n  \"Center\": {\n    \"prefix\": \"twcenter\",\n    \"body\": [\n      \"class=\\\"flex min-h-screen items-center justify-center\\\"\"\n    ],\n    \"description\": \"Center everything\"\n  },\n  \"Responsive grid\": {\n    \"prefix\": \"twgrid\",\n    \"body\": [\n      \"class=\\\"grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3\\\"\"\n    ],\n    \"description\": \"A responsive grid\"\n  },\n  \"Input\": {\n    \"prefix\": \"twinput\",\n    \"body\": [\n      \"class=\\\"block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500\\\"\"\n    ],\n    \"description\": \"A text input\"\n  },\n  \"Label\": {\n    \"prefix\": \"twlabel\",\n    \"body\": [\n      \"class=\\\"mb-1 block text-sm font-medium text-gray-700\\\"\"\n    ],\n    \"description\": \"A form label\"\n  },\n  \"Badge\": {\n    \"prefix\": \"twbadge\",\n    \"body\": [\n      \"class=\\\"inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800\\\"\"\n    ],\n    \"description\": \"A badge\"\n  },\n  \"Navbar\": {\n    \"prefix\": \"twnav\",\n    \"body\": [\n      \"class=\\\"flex items-center justify-between border-b border-gray-200 bg-white px-6 py-4\\\"\"\n    ],\n    \"description\": \"A navbar\"\n  },\n  \"Hero heading\": {\n    \"prefix\": \"twhero\",\n    \"body\": [\n      \"class=\\\"text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl\\\"\"\n    ],\n    \"description\": \"A hero heading\"\n  },\n  \"Muted text\": {\n    \"prefix\": \"twmuted\",\n    \"body\": [\n      \"class=\\\"text-sm text-gray-500\\\"\"\n    ],\n    \"description\": \"Muted text\"\n  },\n  \"Modal overlay\": {\n    \"prefix\": \"twmodal\",\n    \"body\": [\n      \"class=\\\"fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4\\\"\"\n    ],\n    \"description\": \"A modal backdrop\"\n  },\n  \"Dark mode pair\": {\n    \"prefix\": \"twdark\",\n    \"body\": [\n      \"class=\\\"bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100\\\"\"\n    ],\n    \"description\": \"Light and dark colors\"\n  },\n  \"Truncate\": {\n    \"prefix\": \"twtrunc\",\n    \"body\": [\n      \"class=\\\"truncate\\\"\"\n    ],\n    \"description\": \"Truncate one line\"\n  },\n  \"Aspect video\": {\n    \"prefix\": \"twvideo\",\n    \"body\": [\n      \"class=\\\"aspect-video w-full overflow-hidden rounded-lg bg-gray-100\\\"\"\n    ],\n    \"description\": \"A 16:9 box\"\n  },\n  \"Stack\": {\n    \"prefix\": \"twstack\",\n    \"body\": [\n      \"class=\\\"flex flex-col gap-4\\\"\"\n    ],\n    \"description\": \"A vertical stack\"\n  },\n  \"Spinner\": {\n    \"prefix\": \"twspin\",\n    \"body\": [\n      \"class=\\\"h-5 w-5 animate-spin rounded-full border-2 border-gray-300 border-t-blue-600\\\"\"\n    ],\n    \"description\": \"A spinner\"\n  }\n}\n"},"snippets/vue.json":{"encoding":"utf8","content":"{\n  \"Button\": {\n    \"prefix\": \"twbtn\",\n    \"body\": [\n      \"class=\\\"inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50\\\"\"\n    ],\n    \"description\": \"A primary button\"\n  },\n  \"Secondary button\": {\n    \"prefix\": \"twbtn2\",\n    \"body\": [\n      \"class=\\\"inline-flex items-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50\\\"\"\n    ],\n    \"description\": \"A secondary button\"\n  },\n  \"Card\": {\n    \"prefix\": \"twcard\",\n    \"body\": [\n      \"class=\\\"overflow-hidden rounded-xl border border-gray-200 bg-white p-6 shadow-sm\\\"\"\n    ],\n    \"description\": \"A card\"\n  },\n  \"Container\": {\n    \"prefix\": \"twcont\",\n    \"body\": [\n      \"class=\\\"mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8\\\"\"\n    ],\n    \"description\": \"A centered container\"\n  },\n  \"Center\": {\n    \"prefix\": \"twcenter\",\n    \"body\": [\n      \"class=\\\"flex min-h-screen items-center justify-center\\\"\"\n    ],\n    \"description\": \"Center everything\"\n  },\n  \"Responsive grid\": {\n    \"prefix\": \"twgrid\",\n    \"body\": [\n      \"class=\\\"grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3\\\"\"\n    ],\n    \"description\": \"A responsive grid\"\n  },\n  \"Input\": {\n    \"prefix\": \"twinput\",\n    \"body\": [\n      \"class=\\\"block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500\\\"\"\n    ],\n    \"description\": \"A text input\"\n  },\n  \"Label\": {\n    \"prefix\": \"twlabel\",\n    \"body\": [\n      \"class=\\\"mb-1 block text-sm font-medium text-gray-700\\\"\"\n    ],\n    \"description\": \"A form label\"\n  },\n  \"Badge\": {\n    \"prefix\": \"twbadge\",\n    \"body\": [\n      \"class=\\\"inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800\\\"\"\n    ],\n    \"description\": \"A badge\"\n  },\n  \"Navbar\": {\n    \"prefix\": \"twnav\",\n    \"body\": [\n      \"class=\\\"flex items-center justify-between border-b border-gray-200 bg-white px-6 py-4\\\"\"\n    ],\n    \"description\": \"A navbar\"\n  },\n  \"Hero heading\": {\n    \"prefix\": \"twhero\",\n    \"body\": [\n      \"class=\\\"text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl\\\"\"\n    ],\n    \"description\": \"A hero heading\"\n  },\n  \"Muted text\": {\n    \"prefix\": \"twmuted\",\n    \"body\": [\n      \"class=\\\"text-sm text-gray-500\\\"\"\n    ],\n    \"description\": \"Muted text\"\n  },\n  \"Modal overlay\": {\n    \"prefix\": \"twmodal\",\n    \"body\": [\n      \"class=\\\"fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4\\\"\"\n    ],\n    \"description\": \"A modal backdrop\"\n  },\n  \"Dark mode pair\": {\n    \"prefix\": \"twdark\",\n    \"body\": [\n      \"class=\\\"bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100\\\"\"\n    ],\n    \"description\": \"Light and dark colors\"\n  },\n  \"Truncate\": {\n    \"prefix\": \"twtrunc\",\n    \"body\": [\n      \"class=\\\"truncate\\\"\"\n    ],\n    \"description\": \"Truncate one line\"\n  },\n  \"Aspect video\": {\n    \"prefix\": \"twvideo\",\n    \"body\": [\n      \"class=\\\"aspect-video w-full overflow-hidden rounded-lg bg-gray-100\\\"\"\n    ],\n    \"description\": \"A 16:9 box\"\n  },\n  \"Stack\": {\n    \"prefix\": \"twstack\",\n    \"body\": [\n      \"class=\\\"flex flex-col gap-4\\\"\"\n    ],\n    \"description\": \"A vertical stack\"\n  },\n  \"Spinner\": {\n    \"prefix\": \"twspin\",\n    \"body\": [\n      \"class=\\\"h-5 w-5 animate-spin rounded-full border-2 border-gray-300 border-t-blue-600\\\"\"\n    ],\n    \"description\": \"A spinner\"\n  }\n}\n"},"snippets/svelte.json":{"encoding":"utf8","content":"{\n  \"Button\": {\n    \"prefix\": \"twbtn\",\n    \"body\": [\n      \"class=\\\"inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50\\\"\"\n    ],\n    \"description\": \"A primary button\"\n  },\n  \"Secondary button\": {\n    \"prefix\": \"twbtn2\",\n    \"body\": [\n      \"class=\\\"inline-flex items-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50\\\"\"\n    ],\n    \"description\": \"A secondary button\"\n  },\n  \"Card\": {\n    \"prefix\": \"twcard\",\n    \"body\": [\n      \"class=\\\"overflow-hidden rounded-xl border border-gray-200 bg-white p-6 shadow-sm\\\"\"\n    ],\n    \"description\": \"A card\"\n  },\n  \"Container\": {\n    \"prefix\": \"twcont\",\n    \"body\": [\n      \"class=\\\"mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8\\\"\"\n    ],\n    \"description\": \"A centered container\"\n  },\n  \"Center\": {\n    \"prefix\": \"twcenter\",\n    \"body\": [\n      \"class=\\\"flex min-h-screen items-center justify-center\\\"\"\n    ],\n    \"description\": \"Center everything\"\n  },\n  \"Responsive grid\": {\n    \"prefix\": \"twgrid\",\n    \"body\": [\n      \"class=\\\"grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3\\\"\"\n    ],\n    \"description\": \"A responsive grid\"\n  },\n  \"Input\": {\n    \"prefix\": \"twinput\",\n    \"body\": [\n      \"class=\\\"block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500\\\"\"\n    ],\n    \"description\": \"A text input\"\n  },\n  \"Label\": {\n    \"prefix\": \"twlabel\",\n    \"body\": [\n      \"class=\\\"mb-1 block text-sm font-medium text-gray-700\\\"\"\n    ],\n    \"description\": \"A form label\"\n  },\n  \"Badge\": {\n    \"prefix\": \"twbadge\",\n    \"body\": [\n      \"class=\\\"inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800\\\"\"\n    ],\n    \"description\": \"A badge\"\n  },\n  \"Navbar\": {\n    \"prefix\": \"twnav\",\n    \"body\": [\n      \"class=\\\"flex items-center justify-between border-b border-gray-200 bg-white px-6 py-4\\\"\"\n    ],\n    \"description\": \"A navbar\"\n  },\n  \"Hero heading\": {\n    \"prefix\": \"twhero\",\n    \"body\": [\n      \"class=\\\"text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl\\\"\"\n    ],\n    \"description\": \"A hero heading\"\n  },\n  \"Muted text\": {\n    \"prefix\": \"twmuted\",\n    \"body\": [\n      \"class=\\\"text-sm text-gray-500\\\"\"\n    ],\n    \"description\": \"Muted text\"\n  },\n  \"Modal overlay\": {\n    \"prefix\": \"twmodal\",\n    \"body\": [\n      \"class=\\\"fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4\\\"\"\n    ],\n    \"description\": \"A modal backdrop\"\n  },\n  \"Dark mode pair\": {\n    \"prefix\": \"twdark\",\n    \"body\": [\n      \"class=\\\"bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100\\\"\"\n    ],\n    \"description\": \"Light and dark colors\"\n  },\n  \"Truncate\": {\n    \"prefix\": \"twtrunc\",\n    \"body\": [\n      \"class=\\\"truncate\\\"\"\n    ],\n    \"description\": \"Truncate one line\"\n  },\n  \"Aspect video\": {\n    \"prefix\": \"twvideo\",\n    \"body\": [\n      \"class=\\\"aspect-video w-full overflow-hidden rounded-lg bg-gray-100\\\"\"\n    ],\n    \"description\": \"A 16:9 box\"\n  },\n  \"Stack\": {\n    \"prefix\": \"twstack\",\n    \"body\": [\n      \"class=\\\"flex flex-col gap-4\\\"\"\n    ],\n    \"description\": \"A vertical stack\"\n  },\n  \"Spinner\": {\n    \"prefix\": \"twspin\",\n    \"body\": [\n      \"class=\\\"h-5 w-5 animate-spin rounded-full border-2 border-gray-300 border-t-blue-600\\\"\"\n    ],\n    \"description\": \"A spinner\"\n  }\n}\n"},"snippets/laravel-blade.json":{"encoding":"utf8","content":"{\n  \"Button\": {\n    \"prefix\": \"twbtn\",\n    \"body\": [\n      \"class=\\\"inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50\\\"\"\n    ],\n    \"description\": \"A primary button\"\n  },\n  \"Secondary button\": {\n    \"prefix\": \"twbtn2\",\n    \"body\": [\n      \"class=\\\"inline-flex items-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50\\\"\"\n    ],\n    \"description\": \"A secondary button\"\n  },\n  \"Card\": {\n    \"prefix\": \"twcard\",\n    \"body\": [\n      \"class=\\\"overflow-hidden rounded-xl border border-gray-200 bg-white p-6 shadow-sm\\\"\"\n    ],\n    \"description\": \"A card\"\n  },\n  \"Container\": {\n    \"prefix\": \"twcont\",\n    \"body\": [\n      \"class=\\\"mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8\\\"\"\n    ],\n    \"description\": \"A centered container\"\n  },\n  \"Center\": {\n    \"prefix\": \"twcenter\",\n    \"body\": [\n      \"class=\\\"flex min-h-screen items-center justify-center\\\"\"\n    ],\n    \"description\": \"Center everything\"\n  },\n  \"Responsive grid\": {\n    \"prefix\": \"twgrid\",\n    \"body\": [\n      \"class=\\\"grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3\\\"\"\n    ],\n    \"description\": \"A responsive grid\"\n  },\n  \"Input\": {\n    \"prefix\": \"twinput\",\n    \"body\": [\n      \"class=\\\"block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500\\\"\"\n    ],\n    \"description\": \"A text input\"\n  },\n  \"Label\": {\n    \"prefix\": \"twlabel\",\n    \"body\": [\n      \"class=\\\"mb-1 block text-sm font-medium text-gray-700\\\"\"\n    ],\n    \"description\": \"A form label\"\n  },\n  \"Badge\": {\n    \"prefix\": \"twbadge\",\n    \"body\": [\n      \"class=\\\"inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800\\\"\"\n    ],\n    \"description\": \"A badge\"\n  },\n  \"Navbar\": {\n    \"prefix\": \"twnav\",\n    \"body\": [\n      \"class=\\\"flex items-center justify-between border-b border-gray-200 bg-white px-6 py-4\\\"\"\n    ],\n    \"description\": \"A navbar\"\n  },\n  \"Hero heading\": {\n    \"prefix\": \"twhero\",\n    \"body\": [\n      \"class=\\\"text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl\\\"\"\n    ],\n    \"description\": \"A hero heading\"\n  },\n  \"Muted text\": {\n    \"prefix\": \"twmuted\",\n    \"body\": [\n      \"class=\\\"text-sm text-gray-500\\\"\"\n    ],\n    \"description\": \"Muted text\"\n  },\n  \"Modal overlay\": {\n    \"prefix\": \"twmodal\",\n    \"body\": [\n      \"class=\\\"fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4\\\"\"\n    ],\n    \"description\": \"A modal backdrop\"\n  },\n  \"Dark mode pair\": {\n    \"prefix\": \"twdark\",\n    \"body\": [\n      \"class=\\\"bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100\\\"\"\n    ],\n    \"description\": \"Light and dark colors\"\n  },\n  \"Truncate\": {\n    \"prefix\": \"twtrunc\",\n    \"body\": [\n      \"class=\\\"truncate\\\"\"\n    ],\n    \"description\": \"Truncate one line\"\n  },\n  \"Aspect video\": {\n    \"prefix\": \"twvideo\",\n    \"body\": [\n      \"class=\\\"aspect-video w-full overflow-hidden rounded-lg bg-gray-100\\\"\"\n    ],\n    \"description\": \"A 16:9 box\"\n  },\n  \"Stack\": {\n    \"prefix\": \"twstack\",\n    \"body\": [\n      \"class=\\\"flex flex-col gap-4\\\"\"\n    ],\n    \"description\": \"A vertical stack\"\n  },\n  \"Spinner\": {\n    \"prefix\": \"twspin\",\n    \"body\": [\n      \"class=\\\"h-5 w-5 animate-spin rounded-full border-2 border-gray-300 border-t-blue-600\\\"\"\n    ],\n    \"description\": \"A spinner\"\n  }\n}\n"},"README.md":{"encoding":"utf8","content":"# Tailwind CSS Snippets\n\nReady-made class lists for buttons, cards, forms, layouts, navbars and badges. Works in HTML, Vue, Svelte and Blade.\n\nType a prefix and press Tab. 72 snippets.\n\n| Language | Prefix | What it inserts |\n| --- | --- | --- |\n| HTML / XML | `twbtn` | A primary button |\n| HTML / XML | `twbtn2` | A secondary button |\n| HTML / XML | `twcard` | A card |\n| HTML / XML | `twcont` | A centered container |\n| HTML / XML | `twcenter` | Center everything |\n| HTML / XML | `twgrid` | A responsive grid |\n| HTML / XML | `twinput` | A text input |\n| HTML / XML | `twlabel` | A form label |\n| HTML / XML | `twbadge` | A badge |\n| HTML / XML | `twnav` | A navbar |\n| HTML / XML | `twhero` | A hero heading |\n| HTML / XML | `twmuted` | Muted text |\n| HTML / XML | `twmodal` | A modal backdrop |\n| HTML / XML | `twdark` | Light and dark colors |\n| HTML / XML | `twtrunc` | Truncate one line |\n| HTML / XML | `twvideo` | A 16:9 box |\n| HTML / XML | `twstack` | A vertical stack |\n| HTML / XML | `twspin` | A spinner |\n| Vue | `twbtn` | A primary button |\n| Vue | `twbtn2` | A secondary button |\n| Vue | `twcard` | A card |\n| Vue | `twcont` | A centered container |\n| Vue | `twcenter` | Center everything |\n| Vue | `twgrid` | A responsive grid |\n| Vue | `twinput` | A text input |\n| Vue | `twlabel` | A form label |\n| Vue | `twbadge` | A badge |\n| Vue | `twnav` | A navbar |\n| Vue | `twhero` | A hero heading |\n| Vue | `twmuted` | Muted text |\n| Vue | `twmodal` | A modal backdrop |\n| Vue | `twdark` | Light and dark colors |\n| Vue | `twtrunc` | Truncate one line |\n| Vue | `twvideo` | A 16:9 box |\n| Vue | `twstack` | A vertical stack |\n| Vue | `twspin` | A spinner |\n| Svelte | `twbtn` | A primary button |\n| Svelte | `twbtn2` | A secondary button |\n| Svelte | `twcard` | A card |\n| Svelte | `twcont` | A centered container |\n| Svelte | `twcenter` | Center everything |\n| Svelte | `twgrid` | A responsive grid |\n| Svelte | `twinput` | A text input |\n| Svelte | `twlabel` | A form label |\n| Svelte | `twbadge` | A badge |\n| Svelte | `twnav` | A navbar |\n| Svelte | `twhero` | A hero heading |\n| Svelte | `twmuted` | Muted text |\n| Svelte | `twmodal` | A modal backdrop |\n| Svelte | `twdark` | Light and dark colors |\n| Svelte | `twtrunc` | Truncate one line |\n| Svelte | `twvideo` | A 16:9 box |\n| Svelte | `twstack` | A vertical stack |\n| Svelte | `twspin` | A spinner |\n| Laravel Blade | `twbtn` | A primary button |\n| Laravel Blade | `twbtn2` | A secondary button |\n| Laravel Blade | `twcard` | A card |\n| Laravel Blade | `twcont` | A centered container |\n| Laravel Blade | `twcenter` | Center everything |\n| Laravel Blade | `twgrid` | A responsive grid |\n| Laravel Blade | `twinput` | A text input |\n| Laravel Blade | `twlabel` | A form label |\n| Laravel Blade | `twbadge` | A badge |\n| Laravel Blade | `twnav` | A navbar |\n| Laravel Blade | `twhero` | A hero heading |\n| Laravel Blade | `twmuted` | Muted text |\n| Laravel Blade | `twmodal` | A modal backdrop |\n| Laravel Blade | `twdark` | Light and dark colors |\n| Laravel Blade | `twtrunc` | Truncate one line |\n| Laravel Blade | `twvideo` | A 16:9 box |\n| Laravel Blade | `twstack` | A vertical stack |\n| Laravel Blade | `twspin` | A spinner |\n\nThis extension runs no code and asks for no permissions.\n"}}}