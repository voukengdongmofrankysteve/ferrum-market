{"format":1,"manifest":{"name":"long-lines","publisher":"vyloxi","version":"1.1.0","displayName":"Long Lines","description":"Marks the part of a line that goes past your limit and shows how long the line is.","engines":{"ferrum":"^0.1.1"},"categories":["Formatters"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","main":"extension.js","activationEvents":["onStartup"],"permissions":[],"contributes":{"commands":[],"configuration":{"title":"Long Lines","properties":{"longLines.enabled":{"type":"boolean","default":true,"description":"Mark long lines."},"longLines.maxColumns":{"type":"number","default":100,"description":"The line length limit."},"longLines.showLength":{"type":"boolean","default":true,"description":"Show \"123 characters\" after a long line."}}}}},"files":{"icon.png":{"encoding":"base64","content":""},"extension.js":{"encoding":"utf8","content":"// Long Lines: marks the part of a line that goes past your limit, and tells you how long the line is.\n\nfunction find(text, max, notes) {\n  const out = [];\n  const lines = text.split('\\n');\n  for (let i = 0; i < lines.length && out.length < 4000; i++) {\n    const len = [...lines[i].replace(/\\t/g, '    ')].length;\n    if (len <= max) continue;\n    // The column in the real text where the limit falls (tabs count as 4 columns, like the length above).\n    let col = 0;\n    let v = 0;\n    const line = lines[i];\n    while (col < line.length && v < max) {\n      v += line[col] === '\\t' ? 4 : 1;\n      col++;\n    }\n    out.push({ line: i, col, end: line.length, len, note: notes ? len + ' characters (limit ' + max + ')' : undefined });\n  }\n  return out;\n}\n\nexports._test = { find };\n\nexports.activate = function (context) {\n  const type = ferrum.editor.createDecorationType({ backgroundColor: 'rgba(245, 158, 11, 0.28)', textDecoration: 'underline wavy' });\n  context.subscriptions.push(type);\n  let timer = null;\n\n  async function paint() {\n    const doc = await ferrum.editor.active();\n    if (!doc) return;\n    if (ferrum.settings.get('longLines.enabled') === false) return ferrum.editor.setDecorations(type, []);\n    const max = Math.max(20, Number(ferrum.settings.get('longLines.maxColumns')) || 100);\n    const notes = ferrum.settings.get('longLines.showLength') !== false;\n    const ranges = find(doc.text, max, notes).map((h) => ({\n      start: { line: h.line, col: h.col },\n      end: { line: h.line, col: h.end },\n      hoverMessage: h.len + ' characters, ' + (h.len - max) + ' over the limit of ' + max,\n      after: h.note ? { contentText: h.note, color: '#f59e0b', fontStyle: 'italic' } : undefined,\n    }));\n    await ferrum.editor.setDecorations(type, ranges);\n  }\n  const later = () => {\n    clearTimeout(timer);\n    timer = setTimeout(paint, 120);\n  };\n  context.subscriptions.push(ferrum.events.on('activeChanged', later), ferrum.events.on('open', later), ferrum.events.on('change', later), ferrum.events.on('settingsChanged', later), { dispose: () => clearTimeout(timer) });\n  later();\n};\n\nexports.deactivate = function () {};\n"},"README.md":{"encoding":"utf8","content":"# Long Lines\n\nThe part of a line past the limit (100 by default) is underlined with an amber wave, and a note after the line says how many characters it has. Tabs count as 4 columns. Hover the wave for how far over the limit it is.\n\nUses the **decorations** API, including text after the line. No permissions needed.\n"}}}