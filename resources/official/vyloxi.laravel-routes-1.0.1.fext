{"format":1,"manifest":{"name":"laravel-routes","publisher":"vyloxi","version":"1.0.1","displayName":"Laravel Routes","description":"Every route of your project in a searchable list and panel, read from routes/*.php: groups, prefixes, names, middleware and resources. Jump to the controller method.","engines":{"ferrum":"^0.1.0"},"categories":["Tools"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","main":"extension.js","activationEvents":["onCommand:laravelRoutes.list","onCommand:laravelRoutes.panel","onCommand:laravelRoutes.goToController","onCommand:laravelRoutes.insertRoute","onCommand:laravelRoutes.refresh"],"permissions":["workspace.read"],"contributes":{"commands":[{"command":"laravelRoutes.list","title":"Search Routes...","category":"Laravel Routes"},{"command":"laravelRoutes.panel","title":"Show All Routes in a Panel","category":"Laravel Routes"},{"command":"laravelRoutes.goToController","title":"Go to Controller of a Route...","category":"Laravel Routes"},{"command":"laravelRoutes.insertRoute","title":"Insert route('name')...","category":"Laravel Routes"},{"command":"laravelRoutes.refresh","title":"Re-read Routes","category":"Laravel Routes"}],"keybindings":[{"command":"laravelRoutes.list","key":"Ctrl+Alt+J"}]}},"files":{"icon.png":{"encoding":"base64","content":""},"extension.js":{"encoding":"utf8","content":"// Laravel Routes: every route of the project in one searchable list, read straight from routes/*.php (no need to boot the app).\r\n// It understands Route::get/post/..., resource and apiResource, view and redirect routes, and groups with prefix, name and middleware.\r\n\r\nconst VERBS = ['get', 'post', 'put', 'patch', 'delete', 'options', 'any', 'match'];\r\nconst RESOURCE = [['index', 'GET', ''], ['create', 'GET', '/create'], ['store', 'POST', ''], ['show', 'GET', '/{id}'], ['edit', 'GET', '/{id}/edit'], ['update', 'PUT|PATCH', '/{id}'], ['destroy', 'DELETE', '/{id}']];\r\n\r\nconst join = (a, b) => (String(a || '').replace(/\\/+$/, '') + '/' + String(b || '').replace(/^\\/+/, '')).replace(/\\/+$/, '') || '/';\r\nconst strArg = (s) => (/^\\s*['\"]([^'\"]*)['\"]/.exec(s) || [])[1];\r\n\r\n/** Reads the chain that follows a route or a group: ->name('x')->middleware(['a','b'])->prefix('p')->where(...). */\r\nfunction chain(rest) {\r\n  const out = { name: null, middleware: [], prefix: null, namePrefix: null, domain: null };\r\n  const re = /->(\\w+)\\(([^()]*(?:\\([^()]*\\)[^()]*)*)\\)/g;\r\n  let m;\r\n  while ((m = re.exec(rest))) {\r\n    const [, fn, arg] = m;\r\n    if (fn === 'name') out.name = strArg(arg) ?? out.name;\r\n    else if (fn === 'middleware' || fn === 'withoutMiddleware') {\r\n      if (fn === 'middleware') {\r\n        out.middleware.push(...[...arg.matchAll(/['\"]([^'\"]+)['\"]/g)].map((x) => x[1]));\r\n        // Middleware given as a class: ->middleware(RequirePassword::class)\r\n        out.middleware.push(...[...arg.matchAll(/([\\\\\\w]+)::class/g)].map((x) => x[1].split('\\\\').pop()));\r\n      }\r\n    } else if (fn === 'prefix') out.prefix = strArg(arg) ?? out.prefix;\r\n    else if (fn === 'domain') out.domain = strArg(arg) ?? out.domain;\r\n    else if (fn === 'as') out.namePrefix = strArg(arg) ?? out.namePrefix;\r\n  }\r\n  return out;\r\n}\r\n\r\nfunction actionOf(arg) {\r\n  const a = arg.trim();\r\n  let m = /^\\[\\s*([\\\\\\w]+)::class\\s*,\\s*['\"](\\w+)['\"]\\s*\\]/.exec(a);\r\n  if (m) return { controller: m[1].split('\\\\').pop(), method: m[2], text: m[1].split('\\\\').pop() + '@' + m[2] };\r\n  m = /^([\\\\\\w]+)::class/.exec(a);\r\n  if (m) return { controller: m[1].split('\\\\').pop(), method: '__invoke', text: m[1].split('\\\\').pop() };\r\n  m = /^['\"]([\\w\\\\]+)@(\\w+)['\"]/.exec(a);\r\n  if (m) return { controller: m[1].split('\\\\').pop(), method: m[2], text: m[1].split('\\\\').pop() + '@' + m[2] };\r\n  if (/^(function|fn)\\b/.test(a)) return { text: 'Closure' };\r\n  return { text: a.slice(0, 40) };\r\n}\r\n\r\n/** Removes // and # and block comments, keeping line breaks and strings. */\r\nfunction stripComments(text) {\r\n  let out = '';\r\n  for (let i = 0; i < text.length; i++) {\r\n    const c = text[i];\r\n    const n = text[i + 1];\r\n    if (c === \"'\" || c === '\"') {\r\n      let j = i + 1;\r\n      while (j < text.length && text[j] !== c) j += text[j] === '\\\\' ? 2 : 1;\r\n      out += text.slice(i, j + 1);\r\n      i = j;\r\n    } else if (c === '/' && n === '/') {\r\n      while (i < text.length && text[i] !== '\\n') i++;\r\n      out += '\\n';\r\n    } else if (c === '#' && n !== '[') {\r\n      while (i < text.length && text[i] !== '\\n') i++;\r\n      out += '\\n';\r\n    } else if (c === '/' && n === '*') {\r\n      const j = text.indexOf('*/', i + 2);\r\n      const end = j < 0 ? text.length : j + 2;\r\n      out += text.slice(i, end).replace(/[^\\n]/g, '');\r\n      i = end - 1;\r\n    } else out += c;\r\n  }\r\n  return out;\r\n}\r\n\r\n/** Reads one Route:: statement starting at `start`. Stops at \";\" or at the \"{\" that opens a group closure. */\r\nfunction readStatement(src, start) {\r\n  let paren = 0;\r\n  let brace = 0;\r\n  for (let i = start; i < src.length; i++) {\r\n    const c = src[i];\r\n    if (c === \"'\" || c === '\"') {\r\n      let j = i + 1;\r\n      while (j < src.length && src[j] !== c) j += src[j] === '\\\\' ? 2 : 1;\r\n      i = j;\r\n    } else if (c === '(') paren++;\r\n    else if (c === ')') paren--;\r\n    else if (c === '{') {\r\n      if (brace === 0 && /->group\\(\\s*(?:static\\s+)?(?:function|fn)\\b[^{]*$/.test(src.slice(start, i)) || (brace === 0 && /Route::group\\(.*,\\s*(?:static\\s+)?(?:function|fn)\\b[^{]*$/s.test(src.slice(start, i)))) {\r\n        return { stmt: src.slice(start, i).replace(/\\s+/g, ' ').trim(), end: i + 1, group: true };\r\n      }\r\n      brace++;\r\n    } else if (c === '}') brace--;\r\n    else if (c === ';' && paren <= 0 && brace <= 0) return { stmt: src.slice(start, i).replace(/\\s+/g, ' ').trim(), end: i + 1, group: false };\r\n  }\r\n  return { stmt: src.slice(start).replace(/\\s+/g, ' ').trim(), end: src.length, group: false };\r\n}\r\n\r\n/** The prefix, name prefix and middleware that a group statement applies. */\r\nfunction groupSettings(stmt) {\r\n  const out = { prefix: null, namePrefix: null, middleware: [] };\r\n  const first = /^Route::(\\w+)\\(((?:[^()]|\\([^()]*\\))*)\\)/.exec(stmt);\r\n  const arr = /^Route::group\\(\\s*\\[(.*?)\\]\\s*,/.exec(stmt);\r\n  if (arr) {\r\n    const get = (k) => (new RegExp(\"['\\\"]\" + k + \"['\\\"]\\\\s*=>\\\\s*['\\\"]([^'\\\"]*)['\\\"]\").exec(arr[1]) || [])[1];\r\n    out.prefix = get('prefix') ?? null;\r\n    out.namePrefix = get('as') ?? null;\r\n    const mw = new RegExp(\"['\\\"]middleware['\\\"]\\\\s*=>\\\\s*(\\\\[[^\\\\]]*\\\\]|['\\\"][^'\\\"]*['\\\"])\").exec(arr[1]);\r\n    if (mw) out.middleware.push(...[...mw[1].matchAll(/['\"]([^'\"]+)['\"]/g)].map((x) => x[1]));\r\n    return out;\r\n  }\r\n  if (first) {\r\n    const arg = first[2];\r\n    if (first[1] === 'prefix') out.prefix = strArg(arg) ?? null;\r\n    else if (first[1] === 'name' || first[1] === 'as') out.namePrefix = strArg(arg) ?? null;\r\n    else if (first[1] === 'middleware') out.middleware.push(...[...arg.matchAll(/['\"]([^'\"]+)['\"]/g)].map((x) => x[1]));\r\n  }\r\n  const c = chain(stmt.slice(first ? first[0].length : 0).replace(/->group\\(.*$/, ''));\r\n  if (c.prefix) out.prefix = c.prefix;\r\n  if (c.namePrefix) out.namePrefix = (out.namePrefix || '') + c.namePrefix;\r\n  if (c.name) out.namePrefix = (out.namePrefix || '') + c.name;\r\n  out.middleware.push(...c.middleware);\r\n  return out;\r\n}\r\n\r\n/**\r\n * Parses one routes file. Groups are followed with a stack, so a route inside\r\n * Route::prefix('admin')->name('admin.')->middleware('auth')->group(function () { ... }) gets all three.\r\n */\r\nfunction parseRoutes(text, file, base = { prefix: '', name: '', middleware: [] }) {\r\n  const src = stripComments(text);\r\n  const routes = [];\r\n  const stack = [{ ...base, closeAt: -1 }];\r\n  let depth = 0;\r\n  const lineOf = (pos) => src.slice(0, pos).split('\\n').length;\r\n  const ctx = () => stack[stack.length - 1];\r\n  const add = (r) => routes.push({ ...r, file, middleware: [...new Set([...ctx().middleware, ...(r.middleware || [])])] });\r\n\r\n  let i = 0;\r\n  while (i < src.length) {\r\n    const c = src[i];\r\n    if (c === \"'\" || c === '\"') {\r\n      let j = i + 1;\r\n      while (j < src.length && src[j] !== c) j += src[j] === '\\\\' ? 2 : 1;\r\n      i = j + 1;\r\n      continue;\r\n    }\r\n    if (c === '{') {\r\n      depth++;\r\n      i++;\r\n      continue;\r\n    }\r\n    if (c === '}') {\r\n      depth--;\r\n      while (stack.length > 1 && ctx().closeAt === depth) stack.pop();\r\n      i++;\r\n      continue;\r\n    }\r\n    if (!src.startsWith('Route::', i)) {\r\n      i++;\r\n      continue;\r\n    }\r\n    const line = lineOf(i);\r\n    const { stmt, end, group } = readStatement(src, i);\r\n    i = end;\r\n    if (group) {\r\n      const g = groupSettings(stmt);\r\n      const parent = ctx();\r\n      stack.push({ prefix: g.prefix ? join(parent.prefix, g.prefix) : parent.prefix, name: parent.name + (g.namePrefix || ''), middleware: [...parent.middleware, ...g.middleware], closeAt: depth });\r\n      depth++;\r\n      continue;\r\n    }\r\n\r\n    let m = new RegExp('^Route::(' + VERBS.join('|') + ')\\\\(\\\\s*(.*)$').exec(stmt);\r\n    if (m) {\r\n      const verb = m[1];\r\n      let rest = m[2];\r\n      let methods = verb.toUpperCase();\r\n      if (verb === 'match') {\r\n        const mm = /^\\[([^\\]]*)\\]\\s*,\\s*(.*)$/.exec(rest);\r\n        if (mm) {\r\n          methods = [...mm[1].matchAll(/['\"](\\w+)['\"]/g)].map((x) => x[1].toUpperCase()).join('|');\r\n          rest = mm[2];\r\n        }\r\n      }\r\n      const uri = strArg(rest);\r\n      const after = rest.replace(/^\\s*['\"][^'\"]*['\"]\\s*,?\\s*/, '');\r\n      const a = actionOf(after);\r\n      const tail = after.replace(/^(\\[[^\\]]*\\]|[\\\\\\w]+::class|['\"][^'\"]*['\"])/, '');\r\n      const c2 = chain(/^(function|fn)\\b/.test(after) ? after.slice(after.lastIndexOf('->')) : tail);\r\n      add({ methods, uri: join(ctx().prefix, uri || ''), name: c2.name ? ctx().name + c2.name : null, action: a.text, controller: a.controller, method: a.method, line, middleware: c2.middleware });\r\n      continue;\r\n    }\r\n    // Route::inertia('/uri', 'page') and Route::livewire('/uri', Component::class) (starter kits use these a lot)\r\n    m = /^Route::(inertia|livewire|volt)\\(\\s*(.*)$/.exec(stmt);\r\n    if (m) {\r\n      const c2 = chain(m[2]);\r\n      const target = (/^\\s*['\"][^'\"]*['\"]\\s*,\\s*['\"]?([\\\\\\w./-]+)/.exec(m[2]) || [])[1] || '';\r\n      add({ methods: 'GET', uri: join(ctx().prefix, strArg(m[2]) || ''), name: c2.name ? ctx().name + c2.name : null, action: m[1] + ' ' + target.replace(/::class$/, ''), line, middleware: c2.middleware });\r\n      continue;\r\n    }\r\n    m = /^Route::(view|redirect|permanentRedirect|fallback)\\(\\s*(.*)$/.exec(stmt);\r\n    if (m) {\r\n      const c2 = chain(m[2]);\r\n      add({ methods: m[1] === 'view' || m[1] === 'fallback' ? 'GET' : 'ANY', uri: join(ctx().prefix, strArg(m[2]) || ''), name: c2.name ? ctx().name + c2.name : null, action: m[1] === 'view' ? 'view ' + ((/,\\s*['\"]([^'\"]+)['\"]/.exec(m[2]) || [])[1] || '') : m[1], line, middleware: c2.middleware });\r\n      continue;\r\n    }\r\n    m = /^Route::(resource|apiResource|singleton)\\(\\s*['\"]([^'\"]+)['\"]\\s*,\\s*([\\\\\\w]+)::class(.*)$/.exec(stmt);\r\n    if (m) {\r\n      const [, kind, resName, ctrl, rest] = m;\r\n      const only = (/->only\\(\\[([^\\]]*)\\]\\)/.exec(rest) || [])[1];\r\n      const except = (/->except\\(\\[([^\\]]*)\\]\\)/.exec(rest) || [])[1];\r\n      const list = (s) => [...s.matchAll(/['\"](\\w+)['\"]/g)].map((x) => x[1]);\r\n      let acts = RESOURCE.filter(([n]) => kind !== 'apiResource' || (n !== 'create' && n !== 'edit'));\r\n      if (only) acts = acts.filter(([n]) => list(only).includes(n));\r\n      if (except) acts = acts.filter(([n]) => !list(except).includes(n));\r\n      const c2 = chain(rest);\r\n      const param = (resName.split('.').pop() || 'id').replace(/s$/, '');\r\n      for (const [n, methods, suffix] of acts) {\r\n        add({ methods, uri: join(ctx().prefix, resName + suffix.replace('{id}', '{' + param + '}')), name: ctx().name + resName + '.' + n, action: ctrl.split('\\\\').pop() + '@' + n, controller: ctrl.split('\\\\').pop(), method: n, line, middleware: c2.middleware, resource: true });\r\n      }\r\n    }\r\n  }\r\n  return routes;\r\n}\r\n\r\n/** The file a controller class lives in, from the use statements of the routes file: App\\Http\\Controllers\\Settings\\ProfileController becomes app/Http/Controllers/Settings/ProfileController.php. */\r\nfunction controllerPath(source, short) {\r\n  for (const m of source.matchAll(/^use\\s+([\\\\\\w]+?)(?:\\s+as\\s+(\\w+))?\\s*;/gm)) {\r\n    const fq = m[1].replace(/^\\\\/, '');\r\n    const name = m[2] || fq.split('\\\\').pop();\r\n    if (name === short && /^App\\\\/.test(fq)) return 'app/' + fq.slice(4).replace(/\\\\/g, '/') + '.php';\r\n  }\r\n  return null;\r\n}\r\n\r\n/** Finds a controller method: the line of \"function name(\" in the controller source. */\r\nfunction methodLine(source, method) {\r\n  const lines = source.split('\\n');\r\n  const i = lines.findIndex((l) => new RegExp('function\\\\s+' + method + '\\\\s*\\\\(').test(l));\r\n  return i;\r\n}\r\n\r\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\"/g, '&quot;');\r\n\r\nexports._test = { controllerPath, parseRoutes, stripComments, readStatement, groupSettings, chain, actionOf, join, methodLine, RESOURCE };\r\n\r\nexports.activate = function (context) {\r\n  const root = () => ferrum.workspace.root;\r\n  const full = (p) => (/^([a-zA-Z]:|[\\\\/])/.test(p) ? p : root() + (root().includes('\\\\') ? '\\\\' : '/') + p);\r\n  let cache = null;\r\n\r\n  async function load(force) {\r\n    if (cache && !force) return cache;\r\n    if (!root()) {\r\n      ferrum.window.showMessage('Open a Laravel project folder first.', 'warn');\r\n      return [];\r\n    }\r\n    const files = (await ferrum.workspace.listFiles('routes/*.php')).filter((f) => /(^|[\\\\/])routes[\\\\/][^\\\\/]+\\.php$/.test(f));\r\n    const all = [];\r\n    for (const f of files) {\r\n      let text;\r\n      try {\r\n        text = await ferrum.workspace.readFile(full(f));\r\n      } catch {\r\n        continue;\r\n      }\r\n      const api = /api\\.php$/.test(f);\r\n      all.push(...parseRoutes(text, f, { prefix: api ? '/api' : '', name: '', middleware: api ? ['api'] : [] }));\r\n    }\r\n    cache = all;\r\n    return all;\r\n  }\r\n  const label = (r) => r.methods + '  ' + r.uri + (r.name ? '   [' + r.name + ']' : '');\r\n\r\n  async function pick(placeholder) {\r\n    const routes = await load(false);\r\n    if (!routes.length) {\r\n      ferrum.window.showMessage('No routes found in routes/*.php.', 'warn');\r\n      return null;\r\n    }\r\n    const p = await ferrum.window.showQuickPick(routes.map((r, i) => ({ label: label(r), detail: r.action + (r.middleware.length ? '   middleware: ' + r.middleware.join(', ') : ''), i })), { placeholder });\r\n    return p ? routes[p.i] : null;\r\n  }\r\n\r\n  async function openController(r) {\r\n    if (!r.controller) return ferrum.editor.openFile(full(r.file), { line: r.line - 1, col: 0 });\r\n    // The file may import the controller with a namespace (use App\\Http\\Controllers\\Settings\\ProfileController): follow it first.\r\n    let f = null;\r\n    try {\r\n      const source = await ferrum.workspace.readFile(full(r.file));\r\n      const path = controllerPath(source, r.controller);\r\n      if (path) {\r\n        const all = await ferrum.workspace.listFiles('app/**');\r\n        f = all.find((x) => x.replace(/\\\\/g, '/').toLowerCase() === path.toLowerCase()) || null;\r\n      }\r\n    } catch {\r\n      f = null;\r\n    }\r\n    if (!f) {\r\n      // The host's ** needs at least one folder level, so list the whole controllers folder and pick by name.\r\n      const files = await ferrum.workspace.listFiles('app/Http/Controllers/**');\r\n      f = files.find((x) => new RegExp('(^|[\\\\\\\\/])' + r.controller + '\\\\.php$').test(x)) || null;\r\n    }\r\n    if (!f) {\r\n      ferrum.window.showMessage(r.controller + ' was not found in app/Http/Controllers. Opening the route instead.', 'warn');\r\n      return ferrum.editor.openFile(full(r.file), { line: r.line - 1, col: 0 });\r\n    }\r\n    let line = 0;\r\n    try {\r\n      line = Math.max(0, methodLine(await ferrum.workspace.readFile(full(f)), r.method));\r\n    } catch {\r\n      line = 0;\r\n    }\r\n    await ferrum.editor.openFile(full(f), { line, col: 0 });\r\n  }\r\n\r\n  context.subscriptions.push(\r\n    ferrum.commands.register('laravelRoutes.list', async () => {\r\n      const r = await pick('Search routes: method, path, name or controller');\r\n      if (r) await ferrum.editor.openFile(full(r.file), { line: r.line - 1, col: 0 });\r\n    }),\r\n    ferrum.commands.register('laravelRoutes.goToController', async () => {\r\n      const r = await pick('Open the controller of which route?');\r\n      if (r) await openController(r);\r\n    }),\r\n    ferrum.commands.register('laravelRoutes.insertRoute', async () => {\r\n      const routes = (await load(false)).filter((r) => r.name);\r\n      if (!routes.length) return ferrum.window.showMessage('No named routes found.', 'warn');\r\n      const p = await ferrum.window.showQuickPick(routes.map((r, i) => ({ label: r.name, detail: label(r), i })), { placeholder: 'Insert route() for...' });\r\n      if (!p) return;\r\n      const r = routes[p.i];\r\n      const params = [...r.uri.matchAll(/\\{(\\w+)\\??\\}/g)].map((m) => m[1]);\r\n      await ferrum.editor.insert(params.length ? \"route('\" + r.name + \"', [\" + params.map((x) => \"'\" + x + \"' => $\" + x).join(', ') + '])' : \"route('\" + r.name + \"')\");\r\n    }),\r\n    ferrum.commands.register('laravelRoutes.panel', async () => {\r\n      const routes = await load(true);\r\n      if (!routes.length) return ferrum.window.showMessage('No routes found in routes/*.php.', 'warn');\r\n      const rows = routes.map((r, i) => '<tr data-i=\"' + i + '\"><td class=\"m ' + esc(r.methods.split('|')[0]) + '\">' + esc(r.methods) + '</td><td>' + esc(r.uri) + '</td><td>' + esc(r.name) + '</td><td>' + esc(r.action) + '</td><td>' + esc(r.middleware.join(', ')) + '</td><td class=\"f\">' + esc(r.file) + ':' + r.line + '</td></tr>').join('');\r\n      const panel = await ferrum.window.showPanel({\r\n        title: 'Routes (' + routes.length + ')',\r\n        html: '<style>body{font-family:var(--ui)} input{width:100%;box-sizing:border-box;padding:8px 10px;background:var(--raised,transparent);color:var(--fg);border:1px solid var(--border);border-radius:6px;margin-bottom:10px} table{border-collapse:collapse;width:100%;font:12px var(--mono,monospace)} td,th{text-align:left;padding:4px 8px;border-bottom:1px solid var(--border)} tr[data-i]{cursor:pointer} tr[data-i]:hover{background:var(--raised,rgba(128,128,128,.12))} .m{font-weight:600} .GET{color:#22c55e} .POST{color:#f59e0b} .PUT,.PATCH{color:#3b82f6} .DELETE{color:#ef4444} .f{color:var(--fg-dim)}</style><input id=\"q\" placeholder=\"Filter routes...\" autofocus><table><tr><th>Method</th><th>URI</th><th>Name</th><th>Action</th><th>Middleware</th><th>File</th></tr>' + rows + '</table><script>const q=document.getElementById(\"q\");q.addEventListener(\"input\",()=>{const v=q.value.toLowerCase();document.querySelectorAll(\"tr[data-i]\").forEach(r=>{r.style.display=r.textContent.toLowerCase().includes(v)?\"\":\"none\"})});document.querySelectorAll(\"tr[data-i]\").forEach(r=>r.addEventListener(\"click\",()=>send({type:\"open\",i:Number(r.dataset.i)})));</script>',\r\n      });\r\n      panel.onMessage(async (m) => {\r\n        if (m.type === 'open' && routes[m.i]) await openController(routes[m.i]);\r\n      });\r\n    }),\r\n    ferrum.commands.register('laravelRoutes.refresh', async () => {\r\n      const r = await load(true);\r\n      ferrum.window.showMessage(r.length + ' routes read.');\r\n    }),\r\n    ferrum.events.on('save', (d) => {\r\n      if (d && /routes[\\\\/][^\\\\/]+\\.php$/.test(d.path || '')) cache = null;\r\n    }),\r\n  );\r\n};\r\n\r\nexports.deactivate = function () {};\r\n"},"README.md":{"encoding":"utf8","content":"# Laravel Routes\n\nReads `routes/*.php` as text, so it works without booting the app or a database. It understands:\n\n- `Route::get/post/put/patch/delete/options/any/match` with a controller array, `Controller::class`, `'Controller@method'` or a closure\n- `Route::resource`, `apiResource` and `singleton` with `->only([...])` and `->except([...])`\n- `Route::view`, `redirect`, `fallback`\n- groups: `Route::prefix('admin')->name('admin.')->middleware('auth')->group(function () {...})` and the older `Route::group([...], function () {...})`, nested as deep as you like. The prefix, the name prefix and the middleware are all applied.\n- routes in `routes/api.php` get the `/api` prefix and the `api` middleware.\n\n## Commands\n\n- **Search Routes...** lists method, path, name, action and middleware. Pick one to open it in the routes file.\n- **Show All Routes in a Panel** is a filterable table. Click a row to open the controller method.\n- **Go to Controller of a Route...** opens `app/Http/Controllers/.../Name.php` at the method.\n- **Insert route('name')...** writes `route('posts.show', ['post' => $post])`, with the parameters of the path filled in.\n\nLimits: it reads text, not PHP. Routes built in loops or from variables, and routes from packages, are not seen.\n\nPermission: workspace.read.\n"}}}