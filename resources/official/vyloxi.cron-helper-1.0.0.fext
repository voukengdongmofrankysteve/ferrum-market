{"format":1,"manifest":{"name":"cron-helper","publisher":"vyloxi","version":"1.0.0","displayName":"Cron Helper","description":"Explain a cron expression in plain English and list its next run times. Understands ranges, steps, names and @daily style shortcuts.","engines":{"ferrum":"^0.1.0"},"categories":["Tools"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","main":"extension.js","activationEvents":["onCommand:cronHelper.explain","onCommand:cronHelper.next"],"permissions":[],"contributes":{"commands":[{"command":"cronHelper.explain","title":"Explain Cron Expression...","category":"Cron Helper"},{"command":"cronHelper.next","title":"Show Next Run Times...","category":"Cron Helper"}],"configuration":{"title":"Cron Helper","properties":{"cronHelper.count":{"type":"number","default":5,"description":"How many upcoming run times to list (1 to 20)."}}}}},"files":{"icon.png":{"encoding":"base64","content":""},"extension.js":{"encoding":"utf8","content":"// Cron Helper: explain a cron expression in plain English and list its next run times.\n\nconst MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];\nconst DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];\nconst NAMES = { jan: 1, feb: 2, mar: 3, apr: 4, may: 5, jun: 6, jul: 7, aug: 8, sep: 9, oct: 10, nov: 11, dec: 12, sun: 0, mon: 1, tue: 2, wed: 3, thu: 4, fri: 5, sat: 6 };\nconst MACROS = { '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *', '@monthly': '0 0 1 * *', '@weekly': '0 0 * * 0', '@daily': '0 0 * * *', '@midnight': '0 0 * * *', '@hourly': '0 * * * *' };\nconst RANGE = [[0, 59], [0, 23], [1, 31], [1, 12], [0, 7]];\nconst FIELD = ['minute', 'hour', 'day of month', 'month', 'day of week'];\n\nfunction num(tok, i) {\n  const v = NAMES[tok.toLowerCase()] ?? (/^\\d+$/.test(tok) ? Number(tok) : NaN);\n  if (Number.isNaN(v) || v < RANGE[i][0] || v > RANGE[i][1]) throw new Error('\"' + tok + '\" is not valid for the ' + FIELD[i] + ' (allowed ' + RANGE[i][0] + ' to ' + RANGE[i][1] + ').');\n  return v;\n}\n\n/** The set of numbers one field allows. */\nfunction expand(field, i) {\n  const set = new Set();\n  for (const part of field.split(',')) {\n    const [range, stepText] = part.split('/');\n    const step = stepText === undefined ? 1 : Number(stepText);\n    if (!Number.isInteger(step) || step < 1) throw new Error('The step in \"' + part + '\" must be a whole number above 0.');\n    let lo;\n    let hi;\n    if (range === '*' || range === '?') [lo, hi] = RANGE[i];\n    else if (range.includes('-')) {\n      const [a, b] = range.split('-');\n      lo = num(a, i);\n      hi = num(b, i);\n      if (lo > hi) throw new Error('The range \"' + range + '\" goes backwards.');\n    } else {\n      lo = num(range, i);\n      hi = stepText === undefined ? lo : RANGE[i][1];\n    }\n    for (let v = lo; v <= hi; v += step) set.add(i === 4 && v === 7 ? 0 : v);\n  }\n  return set;\n}\n\nfunction parse(expr) {\n  let e = expr.trim().replace(/\\s+/g, ' ');\n  if (MACROS[e.toLowerCase()]) e = MACROS[e.toLowerCase()];\n  const f = e.split(' ');\n  if (f.length === 6) f.shift();\n  if (f.length !== 5) throw new Error('A cron expression has 5 fields: minute hour day-of-month month day-of-week.');\n  return { sets: f.map((x, i) => expand(x, i)), raw: f };\n}\n\nconst two = (n) => String(n).padStart(2, '0');\nconst list = (a) => (a.length <= 2 ? a.join(' and ') : a.slice(0, -1).join(', ') + ' and ' + a[a.length - 1]);\n\nfunction explain(expr) {\n  const { sets, raw } = parse(expr);\n  const [min, hour, dom, mon, dow] = raw;\n  const s = sets.map((x) => [...x].sort((a, b) => a - b));\n  let when;\n  if (min === '*' && hour === '*') when = 'Every minute';\n  else if (/^\\*\\/\\d+$/.test(min) && hour === '*') when = 'Every ' + min.slice(2) + ' minutes';\n  else if (hour === '*') when = 'At minute ' + list(s[0]) + ' of every hour';\n  else if (s[0].length === 1 && s[1].length === 1) when = 'At ' + two(s[1][0]) + ':' + two(s[0][0]);\n  else if (/^\\*\\/\\d+$/.test(hour) && s[0].length === 1) when = 'At minute ' + s[0][0] + ' of every ' + hour.slice(2) + ' hours';\n  else when = 'At minute ' + list(s[0]) + ' past hour ' + list(s[1]);\n  const parts = [when];\n  if (dom !== '*' && dom !== '?') parts.push('on day ' + list(s[2]) + ' of the month');\n  if (dow !== '*' && dow !== '?') parts.push('on ' + list(s[4].map((d) => DAYS[d])));\n  if (mon !== '*') parts.push('in ' + list(s[3].map((m) => MONTHS[m - 1])));\n  if ((dom !== '*' && dom !== '?') && (dow !== '*' && dow !== '?')) parts.push('(cron runs when either the day of month or the day of week matches)');\n  return parts.join(', ').replace(', (', ' (');\n}\n\n/** The next `count` run times after `from` (a Date), in local time. */\nfunction nextRuns(expr, from, count) {\n  const { sets, raw } = parse(expr);\n  const domAny = raw[2] === '*' || raw[2] === '?';\n  const dowAny = raw[4] === '*' || raw[4] === '?';\n  const out = [];\n  const d = new Date(from.getTime());\n  d.setSeconds(0, 0);\n  d.setMinutes(d.getMinutes() + 1);\n  for (let guard = 0; guard < 600000 && out.length < count; guard++) {\n    const okMonth = sets[3].has(d.getMonth() + 1);\n    const domOk = sets[2].has(d.getDate());\n    const dowOk = sets[4].has(d.getDay());\n    const dayOk = domAny && dowAny ? true : domAny ? dowOk : dowAny ? domOk : domOk || dowOk;\n    if (!okMonth) {\n      d.setMonth(d.getMonth() + 1, 1);\n      d.setHours(0, 0, 0, 0);\n      continue;\n    }\n    if (!dayOk) {\n      d.setDate(d.getDate() + 1);\n      d.setHours(0, 0, 0, 0);\n      continue;\n    }\n    if (!sets[1].has(d.getHours())) {\n      d.setHours(d.getHours() + 1, 0, 0, 0);\n      continue;\n    }\n    if (sets[0].has(d.getMinutes())) out.push(new Date(d.getTime()));\n    d.setMinutes(d.getMinutes() + 1);\n  }\n  return out;\n}\n\nconst fmt = (d) => DAYS[d.getDay()].slice(0, 3) + ' ' + d.getFullYear() + '-' + two(d.getMonth() + 1) + '-' + two(d.getDate()) + ' ' + two(d.getHours()) + ':' + two(d.getMinutes());\n\n/** Finds a cron expression on a line: five fields at the start, an @macro, or inside quotes. */\nfunction findCron(line) {\n  const q = /[\"'`]((?:@\\w+)|(?:[-*/,?\\w]+\\s+){4}[-*/,?\\w]+)[\"'`]/.exec(line);\n  if (q) return q[1];\n  const m = /^\\s*((?:@\\w+)|(?:[-*/,?\\w]+\\s+){4}[-*/,?\\w]+)/.exec(line);\n  return m ? m[1] : null;\n}\n\nexports._test = { parse, explain, nextRuns, findCron, expand, fmt };\n\nexports.activate = function (context) {\n  async function expression() {\n    const doc = await ferrum.editor.active();\n    let guess = doc && doc.selectedText ? doc.selectedText.trim() : '';\n    if (!guess && doc) guess = findCron(await ferrum.editor.getLine(doc.selection.start.line)) || '';\n    return ferrum.window.showInputBox({ prompt: 'Cron expression (5 fields)', value: guess, placeholder: '*/15 9-17 * * 1-5' });\n  }\n  context.subscriptions.push(\n    ferrum.commands.register('cronHelper.explain', async () => {\n      const e = await expression();\n      if (!e) return;\n      try {\n        ferrum.window.showMessage(explain(e));\n      } catch (err) {\n        ferrum.window.showMessage(err.message, 'error');\n      }\n    }),\n    ferrum.commands.register('cronHelper.next', async () => {\n      const e = await expression();\n      if (!e) return;\n      try {\n        const n = Math.max(1, Math.min(20, Number(ferrum.settings.get('cronHelper.count')) || 5));\n        const runs = nextRuns(e, new Date(), n);\n        const pick = await ferrum.window.showQuickPick(runs.map((r) => ({ label: fmt(r) })), { placeholder: explain(e) });\n        if (pick) await ferrum.editor.insert(pick.label);\n      } catch (err) {\n        ferrum.window.showMessage(err.message, 'error');\n      }\n    }),\n  );\n};\n\nexports.deactivate = function () {};\n"},"README.md":{"encoding":"utf8","content":"# Cron Helper\n\nPut the cursor on a line with a cron expression, or select it, and run a command. The expression is found on the line, in quotes or at the start (`*/5 * * * * job`).\n\n- **Explain Cron Expression...** says what it means: `0 9 * * 1-5` is \"At 09:00, on Monday, Tuesday, Wednesday, Thursday and Friday\".\n- **Show Next Run Times...** lists the next runs in your local time. Pick one to insert it.\n\nSupports `*`, lists (`1,15`), ranges (`9-17`), steps (`*/10`, `0-30/5`), month and day names (`jan`, `mon`), 7 as Sunday, and `@hourly`, `@daily`, `@weekly`, `@monthly`, `@yearly`. When both day of month and day of week are given, it follows the real cron rule: either one matching is enough.\n\nMistakes are explained, for example \"61 is not valid for the minute (allowed 0 to 59)\". No permissions needed.\n"}}}