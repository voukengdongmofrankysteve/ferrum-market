{"format":1,"manifest":{"name":"high-contrast-icons","publisher":"vyloxi","version":"1.0.0","displayName":"High Contrast Icons","description":"Large color differences and bright hues, made to stay readable on any theme and for low vision.","engines":{"ferrum":"^0.1.0"},"categories":["Themes"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","contributes":{"iconThemes":[{"id":"high-contrast-icons","label":"High Contrast Icons","path":"icons/high-contrast-icons.json"}]}},"files":{"icon.png":{"encoding":"base64","content":""},"icons/high-contrast-icons.json":{"encoding":"utf8","content":"{\n  \"folder\": {\n    \"icon\": \"folder\",\n    \"color\": \"#ffd400\"\n  },\n  \"folderOpen\": {\n    \"icon\": \"folder-opened\",\n    \"color\": \"#ffd400\"\n  },\n  \"file\": {\n    \"icon\": \"file\",\n    \"color\": \"#ffffff\"\n  },\n  \"extensions\": {\n    \"rs\": {\n      \"icon\": \"gear\",\n      \"color\": \"#ff8a3d\"\n    },\n    \"ts\": {\n      \"icon\": \"symbol-namespace\",\n      \"color\": \"#4da3ff\"\n    },\n    \"tsx\": {\n      \"icon\": \"symbol-namespace\",\n      \"color\": \"#4da3ff\"\n    },\n    \"js\": {\n      \"icon\": \"symbol-method\",\n      \"color\": \"#ffe600\"\n    },\n    \"jsx\": {\n      \"icon\": \"symbol-method\",\n      \"color\": \"#ffe600\"\n    },\n    \"json\": {\n      \"icon\": \"json\",\n      \"color\": \"#ffd400\"\n    },\n    \"py\": {\n      \"icon\": \"symbol-misc\",\n      \"color\": \"#5cc8ff\"\n    },\n    \"md\": {\n      \"icon\": \"markdown\",\n      \"color\": \"#7cc4ff\"\n    },\n    \"html\": {\n      \"icon\": \"code\",\n      \"color\": \"#ff6a3d\"\n    },\n    \"css\": {\n      \"icon\": \"symbol-color\",\n      \"color\": \"#6a8cff\"\n    },\n    \"scss\": {\n      \"icon\": \"symbol-color\",\n      \"color\": \"#ff6ac1\"\n    },\n    \"png\": {\n      \"icon\": \"file-media\",\n      \"color\": \"#3dffd0\"\n    },\n    \"jpg\": {\n      \"icon\": \"file-media\",\n      \"color\": \"#3dffd0\"\n    },\n    \"svg\": {\n      \"icon\": \"file-media\",\n      \"color\": \"#ffc247\"\n    },\n    \"gif\": {\n      \"icon\": \"file-media\",\n      \"color\": \"#3dffd0\"\n    },\n    \"toml\": {\n      \"icon\": \"settings-gear\",\n      \"color\": \"#d9a066\"\n    },\n    \"yml\": {\n      \"icon\": \"settings-gear\",\n      \"color\": \"#ff6a6a\"\n    },\n    \"yaml\": {\n      \"icon\": \"settings-gear\",\n      \"color\": \"#ff6a6a\"\n    },\n    \"lock\": {\n      \"icon\": \"lock\",\n      \"color\": \"#c0c0c0\"\n    },\n    \"sh\": {\n      \"icon\": \"terminal\",\n      \"color\": \"#7dff5c\"\n    },\n    \"ps1\": {\n      \"icon\": \"terminal\",\n      \"color\": \"#6ab0ff\"\n    },\n    \"bat\": {\n      \"icon\": \"terminal\",\n      \"color\": \"#d9ff5c\"\n    },\n    \"go\": {\n      \"icon\": \"symbol-method\",\n      \"color\": \"#33e0ff\"\n    },\n    \"java\": {\n      \"icon\": \"coffee\",\n      \"color\": \"#ff9a3d\"\n    },\n    \"kt\": {\n      \"icon\": \"symbol-class\",\n      \"color\": \"#c58cff\"\n    },\n    \"swift\": {\n      \"icon\": \"symbol-class\",\n      \"color\": \"#ff7a5c\"\n    },\n    \"php\": {\n      \"icon\": \"symbol-misc\",\n      \"color\": \"#a9a4ff\"\n    },\n    \"rb\": {\n      \"icon\": \"ruby\",\n      \"color\": \"#ff5c5c\"\n    },\n    \"c\": {\n      \"icon\": \"symbol-ruler\",\n      \"color\": \"#8fa0ff\"\n    },\n    \"cpp\": {\n      \"icon\": \"symbol-ruler\",\n      \"color\": \"#5cc0ff\"\n    },\n    \"h\": {\n      \"icon\": \"symbol-ruler\",\n      \"color\": \"#b9a4ff\"\n    },\n    \"sql\": {\n      \"icon\": \"database\",\n      \"color\": \"#ffb000\"\n    },\n    \"zip\": {\n      \"icon\": \"file-zip\",\n      \"color\": \"#d9b79f\"\n    },\n    \"pdf\": {\n      \"icon\": \"file-pdf\",\n      \"color\": \"#ff4d4d\"\n    },\n    \"txt\": {\n      \"icon\": \"file-text\",\n      \"color\": \"#ffffff\"\n    },\n    \"log\": {\n      \"icon\": \"output\",\n      \"color\": \"#c0c8d0\"\n    },\n    \"env\": {\n      \"icon\": \"key\",\n      \"color\": \"#fff04d\"\n    },\n    \"vue\": {\n      \"icon\": \"symbol-namespace\",\n      \"color\": \"#3dffa3\"\n    },\n    \"svelte\": {\n      \"icon\": \"symbol-namespace\",\n      \"color\": \"#ff6a3d\"\n    }\n  },\n  \"names\": {\n    \"package.json\": {\n      \"icon\": \"package\",\n      \"color\": \"#e0a458\"\n    },\n    \"cargo.toml\": {\n      \"icon\": \"package\",\n      \"color\": \"#e0a458\"\n    },\n    \"composer.json\": {\n      \"icon\": \"package\",\n      \"color\": \"#e0a458\"\n    },\n    \"dockerfile\": {\n      \"icon\": \"server-environment\",\n      \"color\": \"#e0a458\"\n    },\n    \"readme.md\": {\n      \"icon\": \"book\",\n      \"color\": \"#e0a458\"\n    },\n    \"license\": {\n      \"icon\": \"law\",\n      \"color\": \"#e0a458\"\n    },\n    \"makefile\": {\n      \"icon\": \"tools\",\n      \"color\": \"#e0a458\"\n    },\n    \".gitignore\": {\n      \"icon\": \"source-control\",\n      \"color\": \"#e0a458\"\n    },\n    \".env\": {\n      \"icon\": \"key\",\n      \"color\": \"#e0a458\"\n    }\n  },\n  \"folderNames\": {\n    \"src\": {\n      \"icon\": \"folder-library\",\n      \"color\": \"#ffd400\"\n    },\n    \"docs\": {\n      \"icon\": \"book\",\n      \"color\": \"#ffd400\"\n    },\n    \"test\": {\n      \"icon\": \"beaker\",\n      \"color\": \"#ffd400\"\n    },\n    \"tests\": {\n      \"icon\": \"beaker\",\n      \"color\": \"#ffd400\"\n    },\n    \"public\": {\n      \"icon\": \"globe\",\n      \"color\": \"#ffd400\"\n    },\n    \"assets\": {\n      \"icon\": \"file-media\",\n      \"color\": \"#ffd400\"\n    },\n    \"node_modules\": {\n      \"icon\": \"package\",\n      \"color\": \"#ffd400\"\n    },\n    \".git\": {\n      \"icon\": \"source-control\",\n      \"color\": \"#ffd400\"\n    },\n    \".github\": {\n      \"icon\": \"github\",\n      \"color\": \"#ffd400\"\n    },\n    \"dist\": {\n      \"icon\": \"package\",\n      \"color\": \"#ffd400\"\n    },\n    \"build\": {\n      \"icon\": \"package\",\n      \"color\": \"#ffd400\"\n    },\n    \"target\": {\n      \"icon\": \"package\",\n      \"color\": \"#ffd400\"\n    }\n  }\n}\n"},"README.md":{"encoding":"utf8","content":"# High Contrast Icons\n\nLarge color differences and bright hues, made to stay readable on any theme and for low vision.\n\nInstall it, then choose **High Contrast Icons** in **Settings > File icon theme**.\n\nIt covers about 40 kinds of files and a set of well known folders such as `src`, `docs` and `tests`. It runs no code and asks for no permissions.\n"}}}