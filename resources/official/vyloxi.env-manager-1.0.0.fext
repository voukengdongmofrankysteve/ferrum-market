{"format":1,"manifest":{"name":"env-manager","publisher":"vyloxi","version":"1.0.0","displayName":"Env Manager","description":"Compare .env with .env.example, find missing keys, hide secrets on screen, write a safe .env.example and catch duplicate keys.","engines":{"ferrum":"^0.1.0"},"categories":["Tools"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","main":"extension.js","activationEvents":["onCommand:envManager.compare","onCommand:envManager.addMissing","onCommand:envManager.writeExample","onCommand:envManager.maskView","onCommand:envManager.checkDuplicates"],"permissions":["workspace.read","workspace.write"],"contributes":{"commands":[{"command":"envManager.compare","title":"Compare .env with .env.example","category":"Env Manager"},{"command":"envManager.addMissing","title":"Add Missing Keys to .env","category":"Env Manager"},{"command":"envManager.writeExample","title":"Write .env.example from .env...","category":"Env Manager"},{"command":"envManager.maskView","title":"Show This File with Secrets Hidden","category":"Env Manager"},{"command":"envManager.checkDuplicates","title":"Check for Duplicate Keys","category":"Env Manager"}]}},"files":{"icon.png":{"encoding":"base64","content":""},"extension.js":{"encoding":"utf8","content":"// Env Manager: compare .env files, find missing keys, mask secrets and write a .env.example. Reads files in the open folder only.\n\nfunction parseEnv(text) {\n  const vars = [];\n  const lines = text.replace(/\\r\\n/g, '\\n').split('\\n');\n  for (let i = 0; i < lines.length; i++) {\n    const m = /^\\s*(?:export\\s+)?([A-Za-z_][A-Za-z0-9_.]*)\\s*=\\s*(.*)$/.exec(lines[i]);\n    if (!m) continue;\n    let v = m[2];\n    const q = v[0];\n    if ((q === '\"' || q === \"'\") && v.lastIndexOf(q) > 0) v = v.slice(1, v.lastIndexOf(q));\n    else v = v.replace(/\\s+#.*$/, '').trim();\n    vars.push({ key: m[1], value: v, line: i });\n  }\n  return vars;\n}\n\nconst SECRET = /(secret|token|password|passwd|pwd|api[_-]?key|private|credential|auth|signature|salt|dsn)/i;\n\nfunction isSecret(key, value) {\n  return SECRET.test(key) || (value.length >= 24 && /^[A-Za-z0-9+/_=-]+$/.test(value) && /\\d/.test(value) && /[A-Za-z]/.test(value));\n}\n\nfunction mask(value) {\n  if (!value) return '';\n  return value.length <= 6 ? '******' : value.slice(0, 2) + '*'.repeat(Math.min(12, value.length - 4)) + value.slice(-2);\n}\n\n/** What `actual` lacks compared with `example`, what it adds, and which values are empty. */\nfunction compare(example, actual) {\n  const ex = new Map(parseEnv(example).map((v) => [v.key, v]));\n  const ac = new Map(parseEnv(actual).map((v) => [v.key, v]));\n  return {\n    missing: [...ex.keys()].filter((k) => !ac.has(k)),\n    extra: [...ac.keys()].filter((k) => !ex.has(k)),\n    empty: [...ac.values()].filter((v) => v.value === '' && ex.has(v.key)).map((v) => v.key),\n  };\n}\n\n/** A .env.example: same keys and comments, secret values blanked, harmless values kept. */\nfunction makeExample(text) {\n  return text\n    .replace(/\\r\\n/g, '\\n')\n    .split('\\n')\n    .map((line) => {\n      const m = /^(\\s*(?:export\\s+)?[A-Za-z_][A-Za-z0-9_.]*\\s*=\\s*)(.*)$/.exec(line);\n      if (!m) return line;\n      const key = /([A-Za-z_][A-Za-z0-9_.]*)\\s*=/.exec(line)[1];\n      const val = parseEnv(line)[0].value;\n      return isSecret(key, val) ? m[1] : m[1] + m[2];\n    })\n    .join('\\n');\n}\n\nfunction duplicates(text) {\n  const seen = new Map();\n  const out = [];\n  for (const v of parseEnv(text)) {\n    if (seen.has(v.key)) out.push({ key: v.key, first: seen.get(v.key) + 1, again: v.line + 1 });\n    else seen.set(v.key, v.line);\n  }\n  return out;\n}\n\n/** Appends the missing keys (with empty values) to a .env text. */\nfunction addMissing(actual, keys) {\n  if (!keys.length) return actual;\n  return actual.replace(/\\s*$/, '\\n') + '\\n# Added from .env.example\\n' + keys.map((k) => k + '=').join('\\n') + '\\n';\n}\n\nexports._test = { parseEnv, isSecret, mask, compare, makeExample, duplicates, addMissing };\n\nexports.activate = function (context) {\n  const root = () => ferrum.workspace.root;\n  const join = (name) => root() + (root().includes('\\\\') ? '\\\\' : '/') + name;\n\n  async function pickEnv(placeholder) {\n    if (!root()) {\n      ferrum.window.showMessage('Open a folder first.', 'warn');\n      return null;\n    }\n    const files = (await ferrum.workspace.listFiles()).filter((f) => /(^|[\\\\/])\\.env(\\.[\\w.-]+)?$/.test(f) && !/\\.example$|\\.sample$|\\.template$/.test(f));\n    if (!files.length) {\n      ferrum.window.showMessage('No .env file found in this folder.', 'warn');\n      return null;\n    }\n    if (files.length === 1) return files[0];\n    const p = await ferrum.window.showQuickPick(files.map((f) => ({ label: f })), { placeholder });\n    return p ? p.label : null;\n  }\n  const abs = (p) => (/^([a-zA-Z]:|[\\\\/])/.test(p) ? p : join(p));\n\n  context.subscriptions.push(\n    ferrum.commands.register('envManager.compare', async () => {\n      const envFile = await pickEnv('Which .env file to check?');\n      if (!envFile) return;\n      const files = await ferrum.workspace.listFiles();\n      const exName = files.find((f) => /\\.env\\.(example|sample|template)$/.test(f));\n      if (!exName) return ferrum.window.showMessage('No .env.example found next to it. Use \"Write .env.example from .env\" first.', 'warn');\n      const c = compare(await ferrum.workspace.readFile(abs(exName)), await ferrum.workspace.readFile(abs(envFile)));\n      const parts = [];\n      if (c.missing.length) parts.push('missing: ' + c.missing.join(', '));\n      if (c.empty.length) parts.push('empty: ' + c.empty.join(', '));\n      if (c.extra.length) parts.push('not in the example: ' + c.extra.join(', '));\n      ferrum.window.showMessage(parts.length ? envFile + ' vs ' + exName + '  |  ' + parts.join('  |  ') : envFile + ' has every key of ' + exName + '.', c.missing.length ? 'warn' : 'info');\n    }),\n    ferrum.commands.register('envManager.writeExample', async () => {\n      const envFile = await pickEnv('Make an example from which file?');\n      if (!envFile) return;\n      const out = abs(envFile.replace(/(\\.env)(\\.[\\w.-]+)?$/, '$1') + '.example');\n      const dest = out.replace(/\\.env\\.example$/, '.env.example');\n      if (!(await ferrum.window.confirm('Write ' + dest + ' with secret values removed?', 'Write'))) return;\n      await ferrum.workspace.writeFile(dest, makeExample(await ferrum.workspace.readFile(abs(envFile))));\n      ferrum.window.showMessage('Wrote ' + dest + '. Check it before you commit it.');\n    }),\n    ferrum.commands.register('envManager.addMissing', async () => {\n      const envFile = await pickEnv('Add missing keys to which file?');\n      if (!envFile) return;\n      const exName = (await ferrum.workspace.listFiles()).find((f) => /\\.env\\.(example|sample|template)$/.test(f));\n      if (!exName) return ferrum.window.showMessage('No .env.example found.', 'warn');\n      const actual = await ferrum.workspace.readFile(abs(envFile));\n      const c = compare(await ferrum.workspace.readFile(abs(exName)), actual);\n      if (!c.missing.length) return ferrum.window.showMessage('Nothing is missing.');\n      await ferrum.workspace.writeFile(abs(envFile), addMissing(actual, c.missing));\n      ferrum.window.showMessage('Added ' + c.missing.length + ' empty keys: ' + c.missing.join(', '));\n    }),\n    ferrum.commands.register('envManager.maskView', async () => {\n      const doc = await ferrum.editor.active();\n      if (!doc) return ferrum.window.showMessage('Open a .env file first.', 'warn');\n      const lines = parseEnv(doc.text).map((v) => v.key + '=' + (isSecret(v.key, v.value) ? mask(v.value) : v.value));\n      const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');\n      await ferrum.window.showPanel({ title: 'Env (secrets hidden)', html: '<style>body{font-family:var(--ui)} pre{font:13px/1.6 var(--mono,monospace)}</style><h3>' + lines.length + ' variables, secrets hidden</h3><pre>' + esc(lines.join('\\n')) + '</pre>' });\n    }),\n    ferrum.commands.register('envManager.checkDuplicates', async () => {\n      const doc = await ferrum.editor.active();\n      if (!doc) return ferrum.window.showMessage('Open a .env file first.', 'warn');\n      const d = duplicates(doc.text);\n      ferrum.window.showMessage(d.length ? d.map((x) => x.key + ' (lines ' + x.first + ' and ' + x.again + ')').join(', ') + ' appear twice. The last one wins.' : 'No key is defined twice.', d.length ? 'warn' : 'info');\n    }),\n  );\n};\n\nexports.deactivate = function () {};\n"},"README.md":{"encoding":"utf8","content":"# Env Manager\n\nKeeps your `.env` files honest.\n\n- **Compare .env with .env.example** lists the keys that are missing, empty or not in the example.\n- **Add Missing Keys to .env** appends the missing keys with empty values.\n- **Write .env.example from .env...** makes the example file with secret values removed (names that contain secret, token, password, key, auth and similar, and long random looking values) and harmless values like `PORT=3000` kept. It asks before writing.\n- **Show This File with Secrets Hidden** is a safe view for screen sharing: `ab**********yz`.\n- **Check for Duplicate Keys** warns when a key is defined twice (the last one wins).\n\nPermissions: it reads and writes files in the open folder only. It never sends anything anywhere.\n"}}}