{"format":1,"manifest":{"name":"sql-formatter","publisher":"vyloxi","version":"1.0.0","displayName":"SQL Formatter","description":"Format SQL with one clause per line, capital keywords, indented conditions and nested subqueries. Also minifies SQL.","engines":{"ferrum":"^0.1.0"},"categories":["Tools"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","main":"extension.js","activationEvents":["onCommand:sqlFormatter.format","onCommand:sqlFormatter.formatStatement","onCommand:sqlFormatter.minify"],"permissions":[],"contributes":{"commands":[{"command":"sqlFormatter.format","title":"Format SQL (Selection or File)","category":"SQL Formatter"},{"command":"sqlFormatter.formatStatement","title":"Format the Statement Under the Cursor","category":"SQL Formatter"},{"command":"sqlFormatter.minify","title":"Minify SQL","category":"SQL Formatter"}],"keybindings":[{"command":"sqlFormatter.formatStatement","key":"Ctrl+Alt+L"}],"configuration":{"title":"SQL Formatter","properties":{"sqlFormatter.uppercaseKeywords":{"type":"boolean","default":true,"description":"Write SELECT, FROM, WHERE and other keywords in capitals."},"sqlFormatter.indent":{"type":"number","default":2,"description":"Spaces per indent level."}}}}},"files":{"icon.png":{"encoding":"base64","content":""},"extension.js":{"encoding":"utf8","content":"// SQL Formatter: lay out SQL with one clause per line, keywords in capitals and indented conditions. Also minifies.\n\nconst KEYWORDS = ['SELECT', 'DISTINCT', 'FROM', 'WHERE', 'AND', 'OR', 'NOT', 'IN', 'IS', 'NULL', 'LIKE', 'ILIKE', 'BETWEEN', 'EXISTS', 'AS', 'ON', 'JOIN', 'INNER', 'LEFT', 'RIGHT', 'FULL', 'OUTER', 'CROSS', 'NATURAL', 'USING', 'GROUP', 'BY', 'ORDER', 'HAVING', 'LIMIT', 'OFFSET', 'FETCH', 'UNION', 'ALL', 'INTERSECT', 'EXCEPT', 'INSERT', 'INTO', 'VALUES', 'UPDATE', 'SET', 'DELETE', 'CREATE', 'TABLE', 'INDEX', 'VIEW', 'DROP', 'ALTER', 'ADD', 'COLUMN', 'PRIMARY', 'KEY', 'FOREIGN', 'REFERENCES', 'UNIQUE', 'DEFAULT', 'CHECK', 'CONSTRAINT', 'CASE', 'WHEN', 'THEN', 'ELSE', 'END', 'ASC', 'DESC', 'WITH', 'RECURSIVE', 'RETURNING', 'IF', 'TRUE', 'FALSE', 'OVER', 'PARTITION', 'COUNT', 'SUM', 'AVG', 'MIN', 'MAX', 'COALESCE', 'CAST'];\nconst KW = new Set(KEYWORDS);\nconst NEW_LINE = ['FROM', 'WHERE', 'GROUP BY', 'ORDER BY', 'HAVING', 'LIMIT', 'OFFSET', 'UNION', 'UNION ALL', 'INTERSECT', 'EXCEPT', 'VALUES', 'SET', 'RETURNING', 'INSERT INTO', 'UPDATE', 'DELETE FROM', 'SELECT', 'WITH'];\nconst JOINS = /^(?:(?:INNER|LEFT|RIGHT|FULL|CROSS|NATURAL)(?:\\s+OUTER)?\\s+)?JOIN$/;\n\nfunction tokenize(sql) {\n  const out = [];\n  let i = 0;\n  while (i < sql.length) {\n    const c = sql[i];\n    if (/\\s/.test(c)) {\n      i++;\n    } else if (c === '-' && sql[i + 1] === '-') {\n      let j = sql.indexOf('\\n', i);\n      if (j < 0) j = sql.length;\n      out.push({ t: 'comment', v: sql.slice(i, j) });\n      i = j;\n    } else if (c === '/' && sql[i + 1] === '*') {\n      let j = sql.indexOf('*/', i + 2);\n      j = j < 0 ? sql.length : j + 2;\n      out.push({ t: 'comment', v: sql.slice(i, j) });\n      i = j;\n    } else if (c === \"'\" || c === '\"' || c === '`') {\n      let j = i + 1;\n      while (j < sql.length && !(sql[j] === c && sql[j + 1] !== c)) j += sql[j] === c ? 2 : 1;\n      out.push({ t: 'string', v: sql.slice(i, j + 1) });\n      i = j + 1;\n    } else if (/[A-Za-z_]/.test(c)) {\n      let j = i;\n      while (j < sql.length && /[\\w$.]/.test(sql[j])) j++;\n      out.push({ t: 'word', v: sql.slice(i, j) });\n      i = j;\n    } else if (/\\d/.test(c)) {\n      let j = i;\n      while (j < sql.length && /[\\d.]/.test(sql[j])) j++;\n      out.push({ t: 'num', v: sql.slice(i, j) });\n      i = j;\n    } else {\n      const two = sql.slice(i, i + 2);\n      if (['<=', '>=', '<>', '!=', '||', '::', '->'].includes(two)) {\n        out.push({ t: 'op', v: two });\n        i += 2;\n      } else {\n        out.push({ t: c === '(' || c === ')' || c === ',' || c === ';' ? c : 'op', v: c });\n        i++;\n      }\n    }\n  }\n  return out;\n}\n\n/** Joins two-word clauses (GROUP BY, ORDER BY, LEFT JOIN...) into one token. */\nfunction merge(tokens) {\n  const out = [];\n  for (let i = 0; i < tokens.length; i++) {\n    const a = tokens[i];\n    const up = a.t === 'word' ? a.v.toUpperCase() : '';\n    const nx = tokens[i + 1];\n    const nup = nx && nx.t === 'word' ? nx.v.toUpperCase() : '';\n    if ((up === 'GROUP' || up === 'ORDER') && nup === 'BY') {\n      out.push({ t: 'clause', v: up + ' BY' });\n      i++;\n    } else if (up === 'UNION' && nup === 'ALL') {\n      out.push({ t: 'clause', v: 'UNION ALL' });\n      i++;\n    } else if (up === 'INSERT' && nup === 'INTO') {\n      out.push({ t: 'clause', v: 'INSERT INTO' });\n      i++;\n    } else if (up === 'DELETE' && nup === 'FROM') {\n      out.push({ t: 'clause', v: 'DELETE FROM' });\n      i++;\n    } else if (['INNER', 'LEFT', 'RIGHT', 'FULL', 'CROSS', 'NATURAL'].includes(up)) {\n      let v = up;\n      let j = i + 1;\n      while (tokens[j] && tokens[j].t === 'word' && ['OUTER', 'JOIN'].includes(tokens[j].v.toUpperCase())) {\n        v += ' ' + tokens[j].v.toUpperCase();\n        if (tokens[j].v.toUpperCase() === 'JOIN') break;\n        j++;\n      }\n      if (/JOIN$/.test(v)) {\n        out.push({ t: 'join', v });\n        i = j;\n      } else out.push(a);\n    } else if (up === 'JOIN') out.push({ t: 'join', v: 'JOIN' });\n    else if (NEW_LINE.includes(up)) out.push({ t: 'clause', v: up });\n    else out.push(a);\n  }\n  return out;\n}\n\nfunction format(sql, opts = {}) {\n  const indent = opts.indent || '  ';\n  const upper = opts.upper !== false;\n  const toks = merge(tokenize(sql));\n  let out = '';\n  let depth = 0;\n  let line = '';\n  const parenStack = [];\n  const flush = () => {\n    if (line.trim()) out += line.replace(/\\s+$/, '') + '\\n';\n    line = '';\n  };\n  const pad = (d) => indent.repeat(Math.max(0, d));\n  const put = (s, noSpace) => {\n    if (!line.trim()) line = pad(depth) + s;\n    else line += (noSpace || /[(.]$/.test(line) ? '' : ' ') + s;\n  };\n  let inSelect = false;\n  for (let i = 0; i < toks.length; i++) {\n    const t = toks[i];\n    if (t.t === 'clause') {\n      flush();\n      if (t.v === 'UNION' || t.v === 'UNION ALL' || t.v === 'INTERSECT' || t.v === 'EXCEPT') {\n        depth = parenStack.length;\n        line = pad(depth) + t.v;\n        flush();\n        inSelect = false;\n        continue;\n      }\n      depth = parenStack.length;\n      line = pad(depth) + t.v;\n      inSelect = t.v === 'SELECT';\n      if (t.v === 'SELECT' || t.v === 'GROUP BY' || t.v === 'ORDER BY' || t.v === 'SET' || t.v === 'VALUES' || t.v === 'RETURNING') {\n        flush();\n        depth = parenStack.length + 1;\n      }\n    } else if (t.t === 'join') {\n      flush();\n      depth = parenStack.length;\n      line = pad(depth) + t.v;\n    } else if (t.t === 'word') {\n      const up = t.v.toUpperCase();\n      const w = upper && KW.has(up) ? up : t.v;\n      if (up === 'ON' || ((up === 'AND' || up === 'OR') && !parenStack.includes('fn'))) {\n        const top = parenStack[parenStack.length - 1];\n        if (up !== 'ON' && top === 'paren-inline') put(w);\n        else if (up === 'ON') put(w);\n        else {\n          flush();\n          depth = parenStack.length + 1;\n          line = pad(depth) + w;\n        }\n      } else if (up === 'CASE') put(w);\n      else put(w);\n    } else if (t.t === ',') {\n      line += ',';\n      if (!parenStack.length || parenStack[parenStack.length - 1] === 'sub') flush();\n    } else if (t.t === '(') {\n      const prev = toks[i - 1];\n      const next = toks[i + 1];\n      const isSub = next && next.t === 'clause' && ['SELECT', 'WITH'].includes(next.v);\n      const before = toks[i - 2];\n      const afterName = before && ((before.t === 'clause' && ['INSERT INTO', 'UPDATE', 'DELETE FROM', 'FROM'].includes(before.v)) || before.t === 'join' || (before.t === 'word' && ['TABLE', 'INTO', 'VIEW', 'INDEX', 'EXISTS'].includes(before.v.toUpperCase())));\n      const isFn = prev && prev.t === 'word' && !afterName &&!(prev.v.toUpperCase() in { IN: 1, AS: 1, ON: 1, AND: 1, OR: 1, EXISTS: 1 }) && !/^(FROM|JOIN)$/i.test(prev.v);\n      put('(', isFn);\n      if (isSub) {\n        parenStack.push('sub');\n        flush();\n        depth = parenStack.length;\n      } else parenStack.push(isFn ? 'fn' : 'paren-inline');\n    } else if (t.t === ')') {\n      const kind = parenStack.pop();\n      if (kind === 'sub') {\n        flush();\n        depth = parenStack.length;\n        line = pad(depth) + ')';\n      } else line += ')';\n    } else if (t.t === ';') {\n      line += ';';\n      flush();\n      out += '\\n';\n      depth = 0;\n      parenStack.length = 0;\n    } else if (t.t === 'comment') {\n      put(t.v);\n      if (t.v.startsWith('--')) flush();\n    } else if (t.t === 'op') {\n      const tight = t.v === '.' || t.v === '::';\n      if (tight) line += t.v;\n      else put(t.v);\n    } else put(t.v);\n  }\n  flush();\n  return out.replace(/\\n{3,}/g, '\\n\\n').replace(/\\n+$/, '\\n');\n}\n\nfunction minify(sql) {\n  const toks = tokenize(sql).filter((t) => t.t !== 'comment');\n  let out = '';\n  for (const t of toks) {\n    const tight = t.t === ',' || t.t === ')' || t.t === ';' || (t.t === 'op' && (t.v === '.' || t.v === '::')) || out.endsWith('(') || out.endsWith('.') || out.endsWith('::');\n    out += (out && !tight ? ' ' : '') + t.v;\n  }\n  return out;\n}\n\n/** The statement the cursor is in: between the semicolons around the line. */\nfunction statementAt(text, offset) {\n  let start = text.lastIndexOf(';', offset - 1) + 1;\n  let end = text.indexOf(';', offset);\n  if (end < 0) end = text.length;\n  else end += 1;\n  return { start, end, sql: text.slice(start, end) };\n}\n\nexports._test = { tokenize, format, minify, statementAt, KEYWORDS };\n\nexports.activate = function (context) {\n  const opts = () => ({ upper: ferrum.settings.get('sqlFormatter.uppercaseKeywords') !== false, indent: ' '.repeat(Math.max(1, Math.min(8, Number(ferrum.settings.get('sqlFormatter.indent')) || 2))) });\n  context.subscriptions.push(\n    ferrum.commands.register('sqlFormatter.format', async () => {\n      const doc = await ferrum.editor.active();\n      if (!doc) return ferrum.window.showMessage('Open a file first.', 'warn');\n      if (doc.selectedText) return ferrum.editor.insert(format(doc.selectedText, opts()).replace(/\\n$/, ''));\n      await ferrum.editor.replace({ start: { line: 0, col: 0 }, end: { line: doc.lineCount, col: 0 } }, format(doc.text, opts()));\n    }),\n    ferrum.commands.register('sqlFormatter.formatStatement', async () => {\n      const doc = await ferrum.editor.active();\n      if (!doc) return ferrum.window.showMessage('Open a file first.', 'warn');\n      const lines = doc.text.split('\\n');\n      let offset = 0;\n      for (let i = 0; i < doc.selection.start.line; i++) offset += lines[i].length + 1;\n      offset += doc.selection.start.col;\n      const s = statementAt(doc.text, offset);\n      const pos = (o) => {\n        const before = doc.text.slice(0, o).split('\\n');\n        return { line: before.length - 1, col: before[before.length - 1].length };\n      };\n      await ferrum.editor.replace({ start: pos(s.start), end: pos(s.end) }, (s.start > 0 ? '\\n' : '') + format(s.sql, opts()).replace(/\\n$/, ''));\n    }),\n    ferrum.commands.register('sqlFormatter.minify', async () => {\n      const doc = await ferrum.editor.active();\n      if (!doc) return ferrum.window.showMessage('Open a file first.', 'warn');\n      if (doc.selectedText) return ferrum.editor.insert(minify(doc.selectedText));\n      await ferrum.editor.replace({ start: { line: 0, col: 0 }, end: { line: doc.lineCount, col: 0 } }, minify(doc.text) + '\\n');\n    }),\n  );\n};\n\nexports.deactivate = function () {};\n"},"README.md":{"encoding":"utf8","content":"# SQL Formatter\n\n```sql\nselect u.id, count(o.id) as orders from users u left join orders o on o.user_id = u.id where u.active = true and u.age > 18 group by u.id order by orders desc limit 10;\n```\n\nbecomes\n\n```sql\nSELECT\n  u.id,\n  COUNT(o.id) AS orders\nFROM users u\nLEFT JOIN orders o ON o.user_id = u.id\nWHERE u.active = TRUE\n  AND u.age > 18\nGROUP BY\n  u.id\nORDER BY\n  orders DESC\nLIMIT 10;\n```\n\nStrings and comments are never changed. Subqueries nest. **Format the Statement Under the Cursor** (Ctrl+Alt+L) formats only the statement between two semicolons. **Minify SQL** puts it on one line and removes comments.\n\nNo permissions needed.\n"}}}