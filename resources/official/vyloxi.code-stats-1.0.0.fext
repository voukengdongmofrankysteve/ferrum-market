{"format":1,"manifest":{"name":"code-stats","publisher":"vyloxi","version":"1.0.0","displayName":"Code Stats","description":"Count lines of code, comments and blank lines per language across the open folder, and list the biggest files.","engines":{"ferrum":"^0.1.0"},"categories":["Tools"],"icon":"icon.png","repository":"https://github.com/voukengdongmofrankysteve/ferrum-market","license":"MIT","main":"extension.js","activationEvents":["onCommand:codeStats.project","onCommand:codeStats.quick"],"permissions":["workspace.read"],"contributes":{"commands":[{"command":"codeStats.project","title":"Show Project Statistics","category":"Code Stats"},{"command":"codeStats.quick","title":"Quick Line Count","category":"Code Stats"}],"configuration":{"title":"Code Stats","properties":{"codeStats.maxFiles":{"type":"number","default":2000,"description":"The most files to read (100 to 5000). Folders like node_modules and target are skipped."}}}}},"files":{"icon.png":{"encoding":"base64","content":""},"extension.js":{"encoding":"utf8","content":"// Code Stats: lines of code, comments and blank lines per language across the open folder, and the biggest files.\n\nconst LANGS = {\n  js: ['JavaScript', '//', ['/*', '*/']], jsx: ['JavaScript', '//', ['/*', '*/']], mjs: ['JavaScript', '//', ['/*', '*/']], cjs: ['JavaScript', '//', ['/*', '*/']],\n  ts: ['TypeScript', '//', ['/*', '*/']], tsx: ['TypeScript', '//', ['/*', '*/']], py: ['Python', '#', null], rs: ['Rust', '//', ['/*', '*/']], go: ['Go', '//', ['/*', '*/']],\n  java: ['Java', '//', ['/*', '*/']], kt: ['Kotlin', '//', ['/*', '*/']], cs: ['C#', '//', ['/*', '*/']], c: ['C', '//', ['/*', '*/']], h: ['C', '//', ['/*', '*/']],\n  cpp: ['C++', '//', ['/*', '*/']], cc: ['C++', '//', ['/*', '*/']], hpp: ['C++', '//', ['/*', '*/']], php: ['PHP', '//', ['/*', '*/']], rb: ['Ruby', '#', null],\n  swift: ['Swift', '//', ['/*', '*/']], dart: ['Dart', '//', ['/*', '*/']], lua: ['Lua', '--', ['--[[', ']]']], sh: ['Shell', '#', null], bash: ['Shell', '#', null], ps1: ['PowerShell', '#', ['<#', '#>']],\n  sql: ['SQL', '--', ['/*', '*/']], html: ['HTML', null, ['<!--', '-->']], vue: ['Vue', null, ['<!--', '-->']], svelte: ['Svelte', null, ['<!--', '-->']],\n  css: ['CSS', null, ['/*', '*/']], scss: ['SCSS', '//', ['/*', '*/']], less: ['Less', '//', ['/*', '*/']], json: ['JSON', null, null], yml: ['YAML', '#', null], yaml: ['YAML', '#', null],\n  toml: ['TOML', '#', null], md: ['Markdown', null, null], xml: ['XML', null, ['<!--', '-->']], blade: ['Blade', null, ['{{--', '--}}']],\n};\n\nfunction langOf(path) {\n  const ext = (/\\.([A-Za-z0-9]+)$/.exec(path) || [])[1];\n  return ext ? LANGS[ext.toLowerCase()] || null : null;\n}\n\n/** Counts code, comment and blank lines of one file's text. */\nfunction countLines(text, line, block) {\n  let code = 0;\n  let comment = 0;\n  let blank = 0;\n  let inBlock = false;\n  for (const raw of text.split('\\n')) {\n    const l = raw.trim();\n    if (l === '') {\n      blank++;\n      continue;\n    }\n    if (inBlock) {\n      comment++;\n      if (block && l.includes(block[1])) inBlock = false;\n      continue;\n    }\n    if (line && l.startsWith(line)) {\n      comment++;\n      continue;\n    }\n    if (block && l.startsWith(block[0])) {\n      comment++;\n      if (!l.includes(block[1], block[0].length)) inBlock = true;\n      continue;\n    }\n    code++;\n  }\n  return { code, comment, blank };\n}\n\nfunction summarize(files) {\n  const by = new Map();\n  for (const f of files) {\n    const g = by.get(f.language) || { language: f.language, files: 0, code: 0, comment: 0, blank: 0 };\n    g.files++;\n    g.code += f.code;\n    g.comment += f.comment;\n    g.blank += f.blank;\n    by.set(f.language, g);\n  }\n  const langs = [...by.values()].sort((a, b) => b.code - a.code);\n  const total = langs.reduce((t, g) => ({ files: t.files + g.files, code: t.code + g.code, comment: t.comment + g.comment, blank: t.blank + g.blank }), { files: 0, code: 0, comment: 0, blank: 0 });\n  return { langs, total, biggest: [...files].sort((a, b) => b.code - a.code).slice(0, 10) };\n}\n\nexports._test = { langOf, countLines, summarize };\n\nconst esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');\n\nfunction page(s, skipped) {\n  const max = Math.max(1, ...s.langs.map((g) => g.code));\n  return `<style>body{font-family:var(--ui)} table{border-collapse:collapse;font:12px var(--mono,monospace);margin:8px 0;min-width:520px} td,th{padding:4px 10px;border-bottom:1px solid var(--border);text-align:left} th{color:var(--fg-dim);font-weight:500} .n{text-align:right} .bar{height:8px;background:var(--accent);border-radius:4px}</style>\n  <h3>${s.total.files} files, ${s.total.code.toLocaleString()} lines of code</h3><p>${s.total.comment.toLocaleString()} comment lines, ${s.total.blank.toLocaleString()} blank lines${skipped ? ', ' + skipped + ' files were too big or unreadable and skipped' : ''}.</p>\n  <table><tr><th>Language</th><th class=\"n\">Files</th><th class=\"n\">Code</th><th class=\"n\">Comments</th><th class=\"n\">Blank</th><th style=\"width:160px\"></th></tr>\n  ${s.langs.map((g) => '<tr><td>' + esc(g.language) + '</td><td class=\"n\">' + g.files + '</td><td class=\"n\">' + g.code.toLocaleString() + '</td><td class=\"n\">' + g.comment.toLocaleString() + '</td><td class=\"n\">' + g.blank.toLocaleString() + '</td><td><div class=\"bar\" style=\"width:' + Math.round((g.code / max) * 150) + 'px\"></div></td></tr>').join('')}</table>\n  <h4>Biggest files</h4><table><tr><th>File</th><th>Language</th><th class=\"n\">Code lines</th></tr>${s.biggest.map((f) => '<tr><td>' + esc(f.path) + '</td><td>' + esc(f.language) + '</td><td class=\"n\">' + f.code.toLocaleString() + '</td></tr>').join('')}</table>`;\n}\n\nexports.activate = function (context) {\n  async function scan(onlyOpen) {\n    if (!ferrum.workspace.root) {\n      ferrum.window.showMessage('Open a folder first.', 'warn');\n      return null;\n    }\n    const list = (await ferrum.workspace.listFiles()).filter((p) => langOf(p));\n    const cap = Math.max(100, Math.min(5000, Number(ferrum.settings.get('codeStats.maxFiles')) || 2000));\n    const files = [];\n    let skipped = 0;\n    const root = ferrum.workspace.root;\n    const sep = root.includes('\\\\') ? '\\\\' : '/';\n    for (let i = 0; i < list.length && i < cap; i += 20) {\n      await Promise.all(\n        list.slice(i, Math.min(i + 20, cap)).map(async (p) => {\n          try {\n            const text = await ferrum.workspace.readFile(/^([a-zA-Z]:|[\\\\/])/.test(p) ? p : root + sep + p);\n            if (text.length > 1500000) return skipped++;\n            const [language, line, block] = langOf(p);\n            files.push({ path: p, language, ...countLines(text, line, block) });\n          } catch {\n            skipped++;\n          }\n        }),\n      );\n    }\n    skipped += Math.max(0, list.length - cap);\n    return { files, skipped };\n  }\n  context.subscriptions.push(\n    ferrum.commands.register('codeStats.project', async () => {\n      const r = await ferrum.window.withProgress('Counting lines...', () => scan(false));\n      if (!r) return;\n      if (!r.files.length) return ferrum.window.showMessage('No source files found.');\n      await ferrum.window.showPanel({ title: 'Code Stats', html: page(summarize(r.files), r.skipped) });\n    }),\n    ferrum.commands.register('codeStats.quick', async () => {\n      const r = await scan(false);\n      if (!r || !r.files.length) return;\n      const s = summarize(r.files);\n      ferrum.window.showMessage(s.total.files + ' files, ' + s.total.code.toLocaleString() + ' lines of code. Top: ' + s.langs.slice(0, 3).map((g) => g.language + ' ' + g.code.toLocaleString()).join(', '));\n    }),\n  );\n};\n\nexports.deactivate = function () {};\n"},"README.md":{"encoding":"utf8","content":"# Code Stats\n\n**Show Project Statistics** reads the source files in the open folder and shows, per language, the number of files, lines of code, comment lines and blank lines, with a bar for the share of code, and the ten biggest files. **Quick Line Count** gives the totals in one line.\n\nAbout 40 languages are recognized by extension, with their line and block comment styles. Files over 1.5 MB are skipped and counted as skipped. Reads files in the open folder only (permission: workspace.read).\n"}}}