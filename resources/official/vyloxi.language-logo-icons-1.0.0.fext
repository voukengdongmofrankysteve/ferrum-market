r\": \"#90a4ae\"\n    },\n    \"env\": {\n      \"icon\": \"key\",\n      \"color\": \"#faf743\"\n    },\n    \"vue\": {\n      \"icon\": \"symbol-namespace\",\n      \"color\": \"#41b883\"\n    },\n    \"svelte\": {\n      \"icon\": \"symbol-namespace\",\n      \"color\": \"#ff3e00\"\n    }\n  },\n  \"names\": {\n    \"package.json\": {\n      \"icon\": \"package\",\n      \"color\": \"#e0a458\"\n    },\n    \"cargo.toml\": {\n      \"icon\": \"package\",\n      \"color\": \"#e0a458\"\n    },\n    \"composer.json\": {\n      \"icon\": \"package\",\n      \"color\": \"#e0a458\"\n    },\n    \"dockerfile\": {\n      \"icon\": \"server-environment\",\n      \"color\": \"#e0a458\"\n    },\n    \"readme.md\": {\n      \"icon\": \"book\",\n      \"color\": \"#e0a458\"\n    },\n    \"license\": {\n      \"icon\": \"law\",\n      \"color\": \"#e0a458\"\n    },\n    \"makefile\": {\n      \"icon\": \"tools\",\n      \"color\": \"#e0a458\"\n    },\n    \".gitignore\": {\n      \"icon\": \"source-control\",\n      \"color\": \"#e0a458\"\n    },\n    \".env\": {\n      \"icon\": \"key\",\n      \"color\": \"#e0a458\"\n    }\n  },\n  \"folderNames\": {\n    \"src\": {\n      \"icon\": \"folder-library\",\n      \"color\": \"#90a4ae\"\n    },\n    \"docs\": {\n      \"icon\": \"book\",\n      \"color\": \"#90a4ae\"\n    },\n    \"test\": {\n      \"icon\": \"beaker\",\n      \"color\": \"#90a4ae\"\n    },\n    \"tests\": {\n      \"icon\": \"beaker\",\n      \"color\": \"#90a4ae\"\n    },\n    \"public\": {\n      \"icon\": \"globe\",\n      \"color\": \"#90a4ae\"\n    },\n    \"assets\": {\n      \"icon\": \"file-media\",\n      \"color\": \"#90a4ae\"\n    },\n    \"node_modules\": {\n      \"icon\": \"package\",\n      \"color\": \"#90a4ae\"\n    },\n    \".git\": {\n      \"icon\": \"source-control\",\n      \"color\": \"#90a4ae\"\n    },\n    \".github\": {\n      \"icon\": \"github\",\n      \"color\": \"#90a4ae\"\n    },\n    \"dist\": {\n      \"icon\": \"package\",\n      \"color\": \"#90a4ae\"\n    },\n    \"build\": {\n      \"icon\": \"package\",\n      \"color\": \"#90a4ae\"\n    },\n    \"target\": {\n      \"icon\": \"package\",\n      \"color\": \"#90a4ae\"\n    }\n  }\n}\n"},"README.md":{"encoding":"utf8","content":"# Language Logo Icons\n\nEach language gets its well known brand color, so you can tell a project at a glance.\n\nInstall it, then choose **Language Logo Icons** in **Settings > File icon theme**.\n\nIt covers about 40 kinds of files and a set of well known folders such as `src`, `docs` and `tests`. It runs no code and asks for no permissions.\n"}}}